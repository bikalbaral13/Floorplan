{
  "rewrites": [
    {
      "source": "/__r2/:route*",
      "destination": "/api/r2?route=:route*"
    },
    {
      "source": "/__relay/:route*",
      "destination": "/api/relay?route=:route*"
    },
    {
      "source": "/mcp",
      "destination": "/api/relay?route=mcp"
    },
    {
      "source": "/__run",
      "destination": "/api/run"
    },
    {
      "source": "/meshy-assets/:match*",
      "destination": "https://assets.meshy.ai/:match*"
    },
    {
      "source": "/((?!\\.well-known/).*)",
      "destination": "/"
    }
  ],
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/relay.mjs": {
      "maxDuration": 60
    },
    "api/mcp.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/fonts/**"
    },
    "api/run.py": {
      "maxDuration": 300,
      "excludeFiles": "{public,src,tools,packages,skills,skills-*,docs,test-plans,server,blender,sketchup,scripts,mcp,node_modules,dist,pipeline-work,output}/**"
    }
  }
}
