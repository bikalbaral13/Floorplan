{
 "schema": "skill/1",
 "id": "deck-reader",
 "title": "Deck Reader",
 "version": "1.3.0",
 "entry": "SKILL.md",
 "about": "A plan-phase deck (.pptx / .pdf) or a moodboard IMAGE (.png / .jpg / .webp) → the room brief (roombrief.v1): slides (or the image's panels, marked by Claude — one board or several — cropped one per item and filed as project inputs under inputs/images/<source>/<board>/<category>/), the user's questions, a curated brief checked against every slide.",
 "inputs": {
  "deck": {
   "type": "pptx|pdf|png|jpg|webp",
   "required": true
  }
 },
 "outputs": {
  "deck": {
   "file": "deck.json"
  },
  "questions": {
   "file": "questions.json"
  },
  "brief": {
   "file": "roombrief.json",
   "schema": "roombrief.v1",
   "review": true
  },
  "panels": {
   "file": "panels.json",
   "only": "image decks"
  },
  "inputs": {
   "dir": "inputs/images/<source>/",
   "index": "index.json",
   "schema": "deck-inputs/1",
   "only": "image decks"
  }
 },
 "steps": {
  "INTAKE": {
   "kind": "script",
   "title": "Read the deck and list the questions",
   "weight": 20,
   "run": [
    [
     "python",
     "tools/intake.py",
     "{WORK}/input/{BASENAME:deck}",
     "{WORK}/deck"
    ],
    [
     "python",
     "tools/questions.py",
     "{WORK}/deck",
     "{WORK}/deck/questions.json"
    ]
   ]
  },
  "MARK": {
   "kind": "agent",
   "title": "Claude marks the image's panels (image decks only)",
   "weight": 20,
   "doc": "read-an-image-deck.md",
   "optional": true
  },
  "PANELS": {
   "kind": "script",
   "title": "Cut the panels into slides, list the questions",
   "weight": 10,
   "run": [
    [
     "python",
     "tools/panels.py",
     "{WORK}/deck",
     "{IF:board:--board}",
     "{ARG?:board}"
    ],
    [
     "python",
     "tools/questions.py",
     "{WORK}/deck",
     "{WORK}/deck/questions.json"
    ]
   ]
  },
  "ANSWER": {
   "kind": "user",
   "title": "The user answers the questions",
   "gate": "answers",
   "questions": "{STEPS}S1_INTAKE/questions.json"
  },
  "DRAFT": {
   "kind": "script",
   "title": "Draft the room brief",
   "weight": 10,
   "run": [
    [
     "python",
     "tools/brief.py",
     "{WORK}/deck",
     "{ARG:project}",
     "{ARG:room}",
     "{PROJ}/roombrief.draft.json"
    ]
   ]
  },
  "CURATE": {
   "kind": "agent",
   "title": "Claude curates the brief",
   "weight": 50,
   "doc": "curate-the-brief.md"
  },
  "FINALIZE": {
   "kind": "script",
   "title": "Check the brief covers every room slide",
   "weight": 20,
   "run": [
    [
     "python",
     "tools/brief.py",
     "finalize",
     "{PROJ}/roombrief.draft.json",
     "{PROJ}/roombrief.curated.json",
     "{PROJ}/roombrief.json"
    ]
   ]
  },
  "APPROVE": {
   "kind": "user",
   "title": "The user approves the brief",
   "gate": "approve",
   "review": [
    "roombrief.json"
   ]
  }
 }
}
