{
  "kind": "parametric-object",
  "version": 2,
  "meta": { "id": "door.single.v1", "name": "Single Door", "category": "Openings/Doors", "units": "m", "symbol": "door" },
  "parameters": [
    { "key": "width", "label": "Leaf Width", "kind": "number", "default": 0.9, "min": 0.4, "max": 2.4, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 2.1, "min": 1.8, "max": 3.0, "step": 0.05, "unit": "m" },
    { "key": "leaves", "label": "Leaves", "kind": "select", "default": "single", "options": [
      { "value": "single", "label": "Single" },
      { "value": "double", "label": "Double" }
    ] },
    { "key": "swing", "label": "Swing", "kind": "number", "default": 90, "min": 0, "max": 180, "step": 5, "unit": "°" },
    { "key": "hinge", "label": "Hinge", "kind": "select", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "key": "frame", "label": "Frame", "kind": "checkbox", "default": true },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#b45309" }
  ],

  "geometry": {
    "description": "Door symbol anchored at the node: the opening runs along local X (centred on the node), the leaf swings into +Y. The leaf is a thin rotated panel (poly, extruded 0→Height for 3D); the swing arc is an open polyline approximated by `arcN` chords. `frame` adds jamb posts. Single vs double chosen by `leaves`.",
    "emit": "shapes",
    "vars": {
      "W": "width",
      "H": "height",
      "sr": "swing * PI / 180",
      "hs": "hinge == 'right' ? -1 : 1",
      "t": "0.04",
      "arcN": "14"
    },
    "cases": [
      {
        "when": "leaves == 'double'",
        "description": "Two leaves, hinged at the two jambs (±W), meeting at the centre.",
        "rules": [
          { "comment": "left leaf", "poly": { "h0": "0", "h1": "H", "pts": [
            ["-W", "0"],
            ["-W + W*cos(sr)", "W*sin(sr)"],
            ["-W + W*cos(sr) - t*sin(sr)", "W*sin(sr) + t*cos(sr)"],
            ["-W - t*sin(sr)", "t*cos(sr)"]
          ] } },
          { "comment": "right leaf (mirror of the left)", "poly": { "h0": "0", "h1": "H", "pts": [
            ["W", "0"],
            ["W - W*cos(sr)", "W*sin(sr)"],
            ["W - W*cos(sr) + t*sin(sr)", "W*sin(sr) + t*cos(sr)"],
            ["W + t*sin(sr)", "t*cos(sr)"]
          ] } },
          { "comment": "left swing arc", "repeat": "arcN", "as": "k", "line": { "pts": [
            ["-W + W*cos(k/arcN*sr)", "W*sin(k/arcN*sr)"],
            ["-W + W*cos((k+1)/arcN*sr)", "W*sin((k+1)/arcN*sr)"]
          ] } },
          { "comment": "right swing arc", "repeat": "arcN", "as": "k", "line": { "pts": [
            ["W - W*cos(k/arcN*sr)", "W*sin(k/arcN*sr)"],
            ["W - W*cos((k+1)/arcN*sr)", "W*sin((k+1)/arcN*sr)"]
          ] } },
          { "comment": "left jamb post", "when": "frame", "box": { "x0": "-W - 0.05", "x1": "-W", "y0": "-0.06", "y1": "0.06", "h0": "0", "h1": "H" } },
          { "comment": "right jamb post", "when": "frame", "box": { "x0": "W", "x1": "W + 0.05", "y0": "-0.06", "y1": "0.06", "h0": "0", "h1": "H" } }
        ]
      },
      {
        "description": "Single leaf, hinged at one jamb (hinge side); the opening spans W with jambs at ±W/2.",
        "vars": { "hx": "-hs * (W/2)" },
        "rules": [
          { "comment": "leaf", "poly": { "h0": "0", "h1": "H", "pts": [
            ["hx", "0"],
            ["hx + W*hs*cos(sr)", "W*sin(sr)"],
            ["hx + W*hs*cos(sr) - t*sin(sr)", "W*sin(sr) + t*hs*cos(sr)"],
            ["hx - t*sin(sr)", "t*hs*cos(sr)"]
          ] } },
          { "comment": "swing arc", "repeat": "arcN", "as": "k", "line": { "pts": [
            ["hx + W*hs*cos(k/arcN*sr)", "W*sin(k/arcN*sr)"],
            ["hx + W*hs*cos((k+1)/arcN*sr)", "W*sin((k+1)/arcN*sr)"]
          ] } },
          { "comment": "left jamb post", "when": "frame", "box": { "x0": "-W/2 - 0.05", "x1": "-W/2", "y0": "-0.06", "y1": "0.06", "h0": "0", "h1": "H" } },
          { "comment": "right jamb post", "when": "frame", "box": { "x0": "W/2", "x1": "W/2 + 0.05", "y0": "-0.06", "y1": "0.06", "h0": "0", "h1": "H" } }
        ]
      }
    ]
  }
}
