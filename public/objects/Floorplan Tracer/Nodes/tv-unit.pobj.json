{
  "kind": "parametric-object",
  "version": 2,
  "meta": { "id": "tv-unit.v1", "name": "TV Unit", "category": "Furniture/Living", "units": "m", "icon": { "paths": ["M3 5h18v11H3z", "M8 20h8", "M12 16v4"] } },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 1.6, "min": 0.8, "max": 3.0, "step": 0.05, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 0.4, "min": 0.3, "max": 0.6, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 0.5, "min": 0.3, "max": 0.8, "step": 0.05, "unit": "m" },
    { "key": "drawers", "label": "Drawers", "kind": "number", "default": 3, "min": 1, "max": 6, "step": 1 },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#1e293b" }
  ],
  "geometry": {
    "description": "TV unit / low cabinet: a low body box with (Drawers−1) division lines on the front face (−Y).",
    "emit": "shapes",
    "vars": { "W": "width", "D": "depth", "H": "height", "N": "max(1, round(drawers))" },
    "cases": [
      { "rules": [
        { "comment": "body", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "0", "h1": "H" } },
        { "comment": "drawer divisions", "repeat": "N - 1", "as": "k", "line": { "pts": [
          ["-W/2 + (k+1)/N*W", "-D/2"],
          ["-W/2 + (k+1)/N*W", "-D/2 + 0.06"]
        ] } }
      ] }
    ]
  }
}
