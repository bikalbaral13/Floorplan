{
  "kind": "parametric-object",
  "version": 2,
  "meta": { "id": "wardrobe.v2", "name": "Wardrobe", "category": "Furniture/Storage", "units": "m", "icon": { "paths": ["M5 3h14v18H5z", "M12 3v18", "M9 10v3", "M15 10v3"] } },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 1.2, "min": 0.5, "max": 3.0, "step": 0.05, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 0.6, "min": 0.4, "max": 0.8, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 2.0, "min": 1.2, "max": 2.6, "step": 0.05, "unit": "m" },
    { "key": "doors", "label": "Doors", "kind": "number", "default": 2, "min": 1, "max": 6, "step": 1 },
    { "key": "doorStyle", "label": "Door Style", "kind": "select", "default": "hinged", "options": [
      { "value": "hinged", "label": "Hinged" },
      { "value": "sliding", "label": "Sliding" }
    ] },
    { "key": "open", "label": "Show Interior", "kind": "checkbox", "default": false },
    { "key": "shelves", "label": "Shelves", "kind": "number", "default": 4, "min": 0, "max": 8, "step": 1 },
    { "key": "drawers", "label": "Drawers", "kind": "number", "default": 2, "min": 0, "max": 4, "step": 1 },
    { "key": "hangingRails", "label": "Hanging Rails", "kind": "number", "default": 1, "min": 0, "max": 2, "step": 1 },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#7c3aed" }
  ],

  "geometry": {
    "description": "Wardrobe with two representations chosen by 'Show Interior': CLOSED = a body with a plinth, top cornice and one proud door panel per Door (handles placed by Door Style); OPEN = a carcass (back/sides/top + plinth) split by a centre divider into a hanging section (left, with 1–2 rails + a top shelf) and a storage column (right, with Shelves above and Drawer fronts below). Standard depth ~0.6 m, single rail ~1.65 m / double 2.0 & 1.0 m. All pieces extrude to real heights.",
    "emit": "shapes",
    "vars": {
      "W": "width",
      "D": "depth",
      "H": "height",
      "pt": "0.02",
      "ND": "max(1, round(doors))",
      "NS": "max(0, round(shelves))",
      "NDR": "max(0, round(drawers))",
      "NR": "max(0, round(hangingRails))",
      "dw": "width / max(1, round(doors))",
      "drawerTop": "0.1 + max(0, round(drawers)) * 0.26"
    },
    "cases": [
      {
        "when": "open",
        "description": "Open carcass with visible internals.",
        "rules": [
          { "comment": "back panel", "box": { "x0": "-W/2", "x1": "W/2", "y0": "D/2 - pt", "y1": "D/2", "h0": "0", "h1": "H" } },
          { "comment": "left side", "box": { "x0": "-W/2", "x1": "-W/2 + pt", "y0": "-D/2", "y1": "D/2", "h0": "0", "h1": "H" } },
          { "comment": "right side", "box": { "x0": "W/2 - pt", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "0", "h1": "H" } },
          { "comment": "top", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "H - pt", "h1": "H" } },
          { "comment": "plinth", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "0", "h1": "0.1" } },
          { "comment": "centre divider", "box": { "x0": "-pt/2", "x1": "pt/2", "y0": "-D/2", "y1": "D/2 - pt", "h0": "0.1", "h1": "H" } },
          { "comment": "hanging rails", "repeat": "NR", "as": "k", "box": { "x0": "-W/2 + pt + 0.03", "x1": "-0.03", "y0": "D/2 - 0.12", "y1": "D/2 - 0.09", "h0": "H - 0.15 - k*(H*0.45)", "h1": "H - 0.12 - k*(H*0.45)" } },
          { "comment": "hanging top shelf", "box": { "x0": "-W/2 + pt", "x1": "0", "y0": "-D/2 + pt", "y1": "D/2 - pt", "h0": "H - 0.32", "h1": "H - 0.3" } },
          { "comment": "shelves (storage column)", "repeat": "NS", "as": "k", "box": { "x0": "pt", "x1": "W/2 - pt", "y0": "-D/2 + pt", "y1": "D/2 - pt", "h0": "drawerTop + (k+1)/(NS+1)*(H - drawerTop)", "h1": "drawerTop + (k+1)/(NS+1)*(H - drawerTop) + 0.02" } },
          { "comment": "drawer fronts (storage column)", "repeat": "NDR", "as": "k", "box": { "x0": "0.03", "x1": "W/2 - pt - 0.03", "y0": "-D/2", "y1": "-D/2 + 0.03", "h0": "0.1 + k*0.26 + 0.02", "h1": "0.1 + (k+1)*0.26" } }
        ]
      },
      {
        "description": "Closed body with door panels + handles.",
        "rules": [
          { "comment": "body", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2 + 0.02", "y1": "D/2", "h0": "0", "h1": "H" } },
          { "comment": "plinth", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2 + 0.02", "y1": "D/2", "h0": "0", "h1": "0.1" } },
          { "comment": "top cornice", "box": { "x0": "-W/2 - 0.02", "x1": "W/2 + 0.02", "y0": "-D/2", "y1": "D/2", "h0": "H - 0.04", "h1": "H + 0.02" } },
          { "comment": "door panels", "repeat": "ND", "as": "k", "box": { "x0": "-W/2 + k*dw + 0.01", "x1": "-W/2 + (k+1)*dw - 0.01", "y0": "-D/2", "y1": "-D/2 + 0.03", "h0": "0.12", "h1": "H - 0.06" } },
          { "comment": "handles", "repeat": "ND", "as": "k", "box": { "x0": "doorStyle == 'sliding' ? -W/2 + (k+0.5)*dw - 0.02 : -W/2 + (k+1)*dw - 0.06", "x1": "doorStyle == 'sliding' ? -W/2 + (k+0.5)*dw + 0.02 : -W/2 + (k+1)*dw - 0.03", "y0": "-D/2 - 0.02", "y1": "-D/2", "h0": "0.95", "h1": "1.2" } }
        ]
      }
    ]
  }
}
