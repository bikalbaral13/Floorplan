{
  "kind": "parametric-object",
  "version": 2,
  "meta": { "id": "bed.v2", "name": "Bed", "category": "Furniture/Bedroom", "units": "m", "icon": { "paths": ["M3 8h18v9H3z", "M3 12h18", "M6 8V6h5v2", "M3 17v2", "M21 17v2"] } },
  "parameters": [
    { "key": "size", "label": "Size", "kind": "select", "default": "queen", "options": [
      { "value": "single", "label": "Single / Twin (0.97×1.90)" },
      { "value": "twinxl", "label": "Twin XL (0.97×2.03)" },
      { "value": "full", "label": "Full / Double (1.37×1.90)" },
      { "value": "queen", "label": "Queen (1.52×2.03)" },
      { "value": "king", "label": "King (1.93×2.03)" },
      { "value": "calking", "label": "Cal King (1.83×2.13)" },
      { "value": "custom", "label": "Custom (use Width / Length)" }
    ] },
    { "key": "width", "label": "Custom Width", "kind": "number", "default": 1.6, "min": 0.7, "max": 2.4, "step": 0.01, "unit": "m" },
    { "key": "length", "label": "Custom Length", "kind": "number", "default": 2.0, "min": 1.6, "max": 2.3, "step": 0.01, "unit": "m" },
    { "key": "mattressThickness", "label": "Mattress Thickness", "kind": "number", "default": 0.25, "min": 0.1, "max": 0.45, "step": 0.01, "unit": "m" },
    { "key": "legHeight", "label": "Leg / Base Height", "kind": "number", "default": 0.2, "min": 0.05, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "railWidth", "label": "Frame Rail Width", "kind": "number", "default": 0.08, "min": 0.03, "max": 0.2, "step": 0.01, "unit": "m" },
    { "key": "headboardHeight", "label": "Headboard Height", "kind": "number", "default": 1.05, "min": 0.4, "max": 1.6, "step": 0.05, "unit": "m" },
    { "key": "headboardThickness", "label": "Headboard Thickness", "kind": "number", "default": 0.1, "min": 0.04, "max": 0.25, "step": 0.01, "unit": "m" },
    { "key": "footboard", "label": "Footboard", "kind": "checkbox", "default": false },
    { "key": "footboardHeight", "label": "Footboard Height", "kind": "number", "default": 0.45, "min": 0.2, "max": 1.0, "step": 0.05, "unit": "m" },
    { "key": "pillows", "label": "Pillows", "kind": "number", "default": 2, "min": 0, "max": 4, "step": 1 },
    { "key": "backCushions", "label": "Back Cushions", "kind": "number", "default": 2, "min": 0, "max": 5, "step": 1 },
    { "key": "cushionHeight", "label": "Cushion Height", "kind": "number", "default": 0.4, "min": 0.15, "max": 0.7, "step": 0.05, "unit": "m" },
    { "key": "bolster", "label": "Bolster", "kind": "checkbox", "default": false },
    { "key": "blanket", "label": "Blanket / Throw", "kind": "checkbox", "default": true },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#8b5cf6" }
  ],

  "geometry": {
    "description": "Detailed bed: corner legs + frame deck + side/foot rails + mattress, with a headboard at the head (+Y), an optional footboard at the foot (−Y), and soft elements driven by counts — pillows, back cushions (leaning on the headboard), an optional bolster and a folded blanket across the foot. `size` maps to standard mattress dimensions; 'custom' uses Width/Length. Each piece is a box extruded to its real height, so the 3D mesh and the 2D plan come from the same parameters.",
    "emit": "shapes",
    "vars": {
      "mw": "size == 'single' ? 0.97 : size == 'twinxl' ? 0.97 : size == 'full' ? 1.37 : size == 'queen' ? 1.52 : size == 'king' ? 1.93 : size == 'calking' ? 1.83 : width",
      "ml": "size == 'single' ? 1.90 : size == 'twinxl' ? 2.03 : size == 'full' ? 1.90 : size == 'queen' ? 2.03 : size == 'king' ? 2.03 : size == 'calking' ? 2.13 : length",
      "rw": "railWidth",
      "W": "mw + 2*rw",
      "D": "ml + 2*rw",
      "L": "legHeight",
      "mt": "mattressThickness",
      "mtop": "L + mt",
      "hbt": "headboardThickness",
      "NP": "max(0, round(pillows))",
      "NC": "max(0, round(backCushions))",
      "ch": "cushionHeight",
      "pw": "mw / max(1, NP)",
      "cw": "mw / max(1, NC)"
    },
    "cases": [
      { "rules": [
        { "comment": "leg FL", "box": { "x0": "-W/2 + 0.02", "x1": "-W/2 + 0.08", "y0": "-D/2 + 0.02", "y1": "-D/2 + 0.08", "h0": "0", "h1": "L" } },
        { "comment": "leg FR", "box": { "x0": "W/2 - 0.08", "x1": "W/2 - 0.02", "y0": "-D/2 + 0.02", "y1": "-D/2 + 0.08", "h0": "0", "h1": "L" } },
        { "comment": "leg BL", "box": { "x0": "-W/2 + 0.02", "x1": "-W/2 + 0.08", "y0": "D/2 - 0.08", "y1": "D/2 - 0.02", "h0": "0", "h1": "L" } },
        { "comment": "leg BR", "box": { "x0": "W/2 - 0.08", "x1": "W/2 - 0.02", "y0": "D/2 - 0.08", "y1": "D/2 - 0.02", "h0": "0", "h1": "L" } },
        { "comment": "frame deck", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "L - 0.05", "h1": "L" } },
        { "comment": "left rail", "box": { "x0": "-W/2", "x1": "-W/2 + rw", "y0": "-D/2", "y1": "D/2", "h0": "L", "h1": "L + 0.12" } },
        { "comment": "right rail", "box": { "x0": "W/2 - rw", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "L", "h1": "L + 0.12" } },
        { "comment": "foot rail", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "-D/2 + rw", "h0": "L", "h1": "L + 0.12" } },
        { "comment": "mattress", "box": { "x0": "-mw/2", "x1": "mw/2", "y0": "-ml/2", "y1": "ml/2", "h0": "L", "h1": "mtop" } },
        { "comment": "headboard", "box": { "x0": "-W/2", "x1": "W/2", "y0": "D/2 - hbt", "y1": "D/2", "h0": "0", "h1": "headboardHeight" } },
        { "comment": "footboard", "when": "footboard", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "-D/2 + 0.06", "h0": "0", "h1": "footboardHeight" } },
        { "comment": "pillows", "repeat": "NP", "as": "k", "box": { "x0": "-mw/2 + k*pw + 0.05", "x1": "-mw/2 + (k+1)*pw - 0.05", "y0": "ml/2 - 0.58", "y1": "ml/2 - 0.2", "h0": "mtop", "h1": "mtop + 0.12" } },
        { "comment": "back cushions (leaning on headboard)", "repeat": "NC", "as": "k", "box": { "x0": "-mw/2 + k*cw + 0.04", "x1": "-mw/2 + (k+1)*cw - 0.04", "y0": "ml/2 - 0.14", "y1": "ml/2 + 0.02", "h0": "mtop", "h1": "mtop + ch" } },
        { "comment": "bolster (across head)", "when": "bolster", "box": { "x0": "-mw/2 + 0.05", "x1": "mw/2 - 0.05", "y0": "ml/2 - 0.78", "y1": "ml/2 - 0.62", "h0": "mtop", "h1": "mtop + 0.18" } },
        { "comment": "blanket across the foot", "when": "blanket", "box": { "x0": "-mw/2", "x1": "mw/2", "y0": "-ml/2", "y1": "-ml/2 + 0.45*ml", "h0": "mtop", "h1": "mtop + 0.05" } },
        { "comment": "blanket fold line", "when": "blanket", "line": { "pts": [["-mw/2", "-ml/2 + 0.45*ml"], ["mw/2", "-ml/2 + 0.45*ml"]] } }
      ] }
    ]
  }
}
