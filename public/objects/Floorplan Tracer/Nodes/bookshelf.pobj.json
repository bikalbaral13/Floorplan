{
  "kind": "parametric-object",
  "version": 2,
  "meta": { "id": "bookshelf.v1", "name": "Bookshelf", "category": "Furniture/Storage", "units": "m" },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 1.0, "min": 0.4, "max": 2.4, "step": 0.05, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 0.3, "min": 0.2, "max": 0.5, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 1.8, "min": 0.6, "max": 2.6, "step": 0.05, "unit": "m" },
    { "key": "shelves", "label": "Shelves", "kind": "number", "default": 4, "min": 1, "max": 8, "step": 1 },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#b45309" }
  ],
  "geometry": {
    "description": "Bookshelf: a back/body box plus a front opening line. Shelves are thin slabs stacked up the height (visible in 3D / elevation).",
    "emit": "shapes",
    "vars": { "W": "width", "D": "depth", "H": "height", "N": "max(1, round(shelves))" },
    "cases": [
      { "rules": [
        { "comment": "body", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-D/2", "y1": "D/2", "h0": "0", "h1": "H" } },
        { "comment": "shelves", "repeat": "N + 1", "as": "k", "box": { "x0": "-W/2 + 0.02", "x1": "W/2 - 0.02", "y0": "-D/2 + 0.02", "y1": "D/2 - 0.02", "h0": "k/N*(H - 0.03)", "h1": "k/N*(H - 0.03) + 0.03" } }
      ] }
    ]
  }
}
