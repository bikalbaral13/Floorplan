{
  "kind": "parametric-object",
  "version": 2,
  "meta": { "id": "window.standard.v1", "name": "Window", "category": "Openings/Windows", "units": "m", "symbol": "window" },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 1.2, "min": 0.3, "max": 4.0, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 1.2, "min": 0.3, "max": 3.0, "step": 0.05, "unit": "m" },
    { "key": "shape", "label": "Shape", "kind": "select", "default": "lines", "options": [
      { "value": "polygon", "label": "Polygon (filled)" },
      { "value": "lines", "label": "Lines (frame + glass)" },
      { "value": "detailed", "label": "Detailed (panes)" }
    ] },
    { "key": "thickness", "label": "Frame Thickness", "kind": "number", "default": 0.1, "min": 0.02, "max": 0.6, "step": 0.01, "unit": "m" },
    { "key": "panes", "label": "Panes", "kind": "number", "default": 2, "min": 1, "max": 8, "step": 1 },
    { "key": "operation", "label": "Operation", "kind": "select", "default": "fixed", "options": [
      { "value": "fixed", "label": "Fixed" },
      { "value": "casement", "label": "Casement" },
      { "value": "sliding", "label": "Sliding" },
      { "value": "awning", "label": "Awning" }
    ] },
    { "key": "sillHeight", "label": "Sill Height", "kind": "number", "default": 0.9, "min": 0, "max": 3.0, "step": 0.05, "unit": "m" },
    { "key": "lintelHeight", "label": "Lintel Height", "kind": "number", "default": 2.1, "min": 0, "max": 5.0, "step": 0.05, "unit": "m" },
    { "key": "frame", "label": "Frame", "kind": "checkbox", "default": true },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#0891b2" }
  ],

  "geometry": {
    "description": "Window symbol anchored at the node: the opening runs along local X (centred on the node), the wall thickness along Y. The frame is a closed box (filled in plan, extruded between Sill and Lintel heights for 3D); a centre glazing line + (Panes − 1) mullions divide it. Sliding/awning operation adds a guide line.",
    "emit": "shapes",
    "vars": {
      "W": "width",
      "th": "max(0.02, thickness)",
      "P": "max(1, round(panes))",
      "sill": "sillHeight",
      "lintel": "max(sillHeight + 0.05, lintelHeight)"
    },
    "cases": [
      {
        "rules": [
          { "comment": "frame + glazing block (extruded sill→lintel)", "box": { "x0": "-W/2", "x1": "W/2", "y0": "-th/2", "y1": "th/2", "h0": "sill", "h1": "lintel" } },
          { "comment": "centre glass line", "line": { "pts": [["-W/2", "0"], ["W/2", "0"]] } },
          { "comment": "pane mullions", "repeat": "P - 1", "as": "k", "line": { "pts": [
            ["-W/2 + (k+1)/P*W", "-th/2"],
            ["-W/2 + (k+1)/P*W", "th/2"]
          ] } },
          { "comment": "operation guide (sliding/awning) — a diagonal across the first pane", "when": "operation == 'casement' || operation == 'awning'", "line": { "pts": [
            ["-W/2", "-th/2"],
            ["-W/2 + W/P", "0"],
            ["-W/2", "th/2"]
          ] } }
        ]
      }
    ]
  }
}
