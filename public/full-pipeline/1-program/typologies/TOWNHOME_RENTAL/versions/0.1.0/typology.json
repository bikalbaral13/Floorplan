{
 "id": "TOWNHOME_RENTAL",
 "version": "0.1.0",
 "title": "Town home rentals: 4 ground-floor units with a central open court and staircase",
 "frame": "Feet. Site frame: x east from the west plot edge, y south from the road (north) edge. Planning depth = shorter of the west and east sides.",
 "road_sides_supported": ["N"],
 "unit_count": 4,
 "facings": ["North", "East"],
 "planner": "planner/town_home_rental_planner.html",
 "parameters": {
  "option":             {"type": "choice", "default": "A", "options": ["A","B","C","D","E","F","G","H","I","J"], "label": "Layout option"},
  "plot_width_ft":      {"type": "number", "default": 36,    "min": 20,  "max": 60,  "unit": "ft", "label": "Plot width (road frontage)"},
  "plot_west_ft":       {"type": "number", "default": 106,   "min": 40,  "max": 160, "unit": "ft", "label": "West side length"},
  "plot_east_ft":       {"type": "number", "default": 105.5, "min": 40,  "max": 160, "unit": "ft", "label": "East side length"},
  "setback_west_ft":    {"type": "number", "default": 0,     "min": 0,   "max": 6,   "unit": "ft", "label": "West setback (0 or 3-6)"},
  "setback_east_ft":    {"type": "number", "default": 6,     "min": 0,   "max": 6,   "unit": "ft", "label": "East setback (0 or 3-6)"},
  "setback_front_ft":   {"type": "number", "default": 10,    "min": 5,   "max": 20,  "unit": "ft", "label": "Front setback (road side)"},
  "setback_rear_ft":    {"type": "number", "default": 5,     "min": 3,   "max": 10,  "unit": "ft", "label": "Rear setback"},
  "court_ft":           {"type": "number", "default": 12,    "min": 0,   "max": 20,  "unit": "ft", "label": "Central court depth"},
  "front_share_pct":    {"type": "number", "default": 50,    "min": 35,  "max": 65,  "unit": "%",  "label": "Front row share of the unit depth"},
  "passage_ft":         {"type": "number", "default": 4,     "min": 3,   "max": 6,   "unit": "ft", "label": "Passage width (options B, G, H, I)"},
  "floor_height_ft":    {"type": "number", "default": 10,    "min": 9,   "max": 12,  "unit": "ft", "label": "Floor-to-floor height"},
  "max_riser_in":       {"type": "number", "default": 7,     "min": 5.5, "max": 7.5, "unit": "in", "label": "Maximum riser"},
  "tread_in":           {"type": "number", "default": 10,    "min": 9,   "max": 12,  "unit": "in", "label": "Tread"},
  "flight_width_ft":    {"type": "number", "default": 3.5,   "min": 3,   "max": 4.5, "unit": "ft", "label": "Flight width"},
  "stair_position":     {"type": "choice", "default": "E", "options": ["W","C","E"], "label": "Stair position in the court"},
  "stair_first_flight": {"type": "choice", "default": "W", "options": ["N","E","S","W"], "label": "First flight goes up towards"},
  "stair_turn":         {"type": "choice", "default": "R", "options": ["L","R"], "label": "Turn at landing"},
  "door1_pct":          {"type": "number", "default": 50, "min": 0, "max": 100, "unit": "%", "label": "Unit 1 door position"},
  "door2_pct":          {"type": "number", "default": 50, "min": 0, "max": 100, "unit": "%", "label": "Unit 2 door position"},
  "door3_pct":          {"type": "number", "default": 50, "min": 0, "max": 100, "unit": "%", "label": "Unit 3 door position"},
  "door4_pct":          {"type": "number", "default": 50, "min": 0, "max": 100, "unit": "%", "label": "Unit 4 door position"},
  "drawing_north":      {"type": "choice", "default": "up", "options": ["up","down"], "label": "Drawing orientation (presentation only)"}
 },
 "options": {
  "A": {"title": "2 + 2, side lane",              "facing": "All north facing. Rear pair opens onto the court",            "units": "NNNN", "needs": ["court"]},
  "B": {"title": "2 + 2, front passage",          "facing": "All north facing. Passage between front units to the court",  "units": "NNNN", "needs": ["court"]},
  "C": {"title": "4 stacked",                     "facing": "All east facing on the east lane",                            "units": "EEEE", "needs": ["east_lane"]},
  "D": {"title": "1 + 3 stacked",                 "facing": "Unit 1 north facing, units 2 to 4 east facing",               "units": "NEEE", "needs": ["east_lane"]},
  "E": {"title": "2 front + 2 stacked rear",      "facing": "Front pair north, rear pair east facing",                     "units": "NNEE", "needs": ["east_lane"]},
  "F": {"title": "2 stacked front + 2 rear",      "facing": "Front pair east, rear pair north onto the court",             "units": "EENN", "needs": ["east_lane", "court"]},
  "G": {"title": "Twin columns, spine passage",   "facing": "All east facing, west column on a central passage",           "units": "EEEE", "needs": ["east_lane"]},
  "H": {"title": "2 front + rear twins",          "facing": "Front pair north, rear pair east on a rear passage",          "units": "NNEE", "needs": ["east_lane"]},
  "I": {"title": "Stacked front + rear twins",    "facing": "All east facing, rear passage off the court",                 "units": "EEEE", "needs": ["east_lane"]},
  "J": {"title": "Mixed front + 2 rear",          "facing": "Front west north, front east east, rear pair north",          "units": "NENN", "needs": ["east_lane", "court"]}
 },
 "rule_defaults": {
  "_note": "Draft values only. P3_RULES asks the user to confirm them against the local authority's rules before they are used.",
  "authority": "",
  "side_setback_min_ft": 3, "side_setback_max_ft": 6, "one_side_zero_allowed": true,
  "front_setback_min_ft": 5, "rear_setback_min_ft": 3,
  "coverage_max_pct": 75,
  "min_unit_area_sqft": 450, "min_unit_dim_ft": 12,
  "stair_max_riser_in": 7.5, "stair_min_tread_in": 10, "stair_min_flight_ft": 3,
  "court_clear_min_ft": 3.5, "two_wheeler_lane_min_ft": 4, "passage_min_ft": 3
 },
 "brief_defaults": {
  "unit_count": 4, "facing_allowed": ["North", "East"], "future_floors": true,
  "options": ["A","B","C","D","E","F","G","H","I","J"]
 }
}
