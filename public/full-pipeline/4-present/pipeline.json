{
 "schema": "pipeline/1",
 "id": "walkthrough-video",
 "title": "Walkthrough Video generation Pipeline",
 "version": "0.1.0",
 "phase": "present",
 "entry": {
  "agents": "AGENTS.md",
  "run": "python tools/run_task.py {CODE}",
  "new_project": "python tools/new_project.py {CODE} --title \"...\"",
  "selftest": "python tools/selftest.py --blender"
 },
 "kit": "0.3.1",
 "inputs": [
  { "id": "blend", "from": "scope:blend_path", "required": true, "note": "any .blend (e.g. the exterior or interior mesh pipeline's output); opened read-only, never overwritten, kept outside public/" },
  { "id": "script", "from": "scope:script_file", "required": false, "note": "voiceover / video script (PDF, DOCX, TXT)" },
  { "id": "path", "from": "scope:path_file", "required": false, "note": "camera-path drawing / shot list (PDF or image)" },
  { "id": "audio", "from": "scope:audio_file", "required": false, "note": "voiceover or music laid under the final cut" }
 ],
 "library_pins": [
  { "path": "library/Pipelines/_kit/", "version": "0.3.1", "local_copy": "_vendor/pipeline_kit" }
 ],
 "outputs": {
  "keep": [
   { "id": "shots", "local": "project:shots.json", "to": "Projects/{CODE}/walkthrough/shots.json", "schema": "walkthrough-shots.v1" },
   { "id": "prompts", "local": "project:prompts.json", "to": "Projects/{CODE}/walkthrough/prompts.json", "schema": "walkthrough-prompts.v1" },
   { "id": "blend", "local": "output/{CODE}_walkthrough.blend", "to": "Projects/{CODE}/walkthrough/{CODE}_walkthrough.blend", "binary": true },
   { "id": "preview", "local": "output/{CODE}_preview.mp4", "to": "Projects/{CODE}/walkthrough/{CODE}_preview.mp4", "binary": true },
   { "id": "clips", "local": "output/ai/*.mp4", "to": "Projects/{CODE}/walkthrough/clips/", "binary": true, "after": "S10_REVIEW" },
   { "id": "final", "local": "output/{CODE}_final.mp4", "to": "Projects/{CODE}/walkthrough/{CODE}_final.mp4", "binary": true, "after": "S10_REVIEW" },
   { "id": "handoff", "local": "project:handoff.json", "to": "Projects/{CODE}/walkthrough/handoff.json", "after": "S10_REVIEW" },
   { "id": "report", "local": "project:REPORT.md", "to": "Projects/{CODE}/runs/walkthrough-video/" }
  ],
  "temp": ["jobs/**", "intake/**", "output/preview/**", "output/*.blend1"]
 },
 "deliver": {
  "mode": "local-first",
  "after": "S10_REVIEW",
  "rule": "every stage runs on the user's PC (Blender headless + Python); AI generation spends the user's credits only after the S7 gate; nothing is published before S10",
  "steps": [ { "publish": "outputs.keep", "to": "Projects/{CODE}/walkthrough/" } ]
 }
}
