{
 "schema": "pipeline/1",
 "id": "build-from-deck",
 "title": "Build (from roombrief or Plan Deck)",
 "version": "0.5.0",
 "phase": "build",
 "entry": {
  "agents": "AGENTS.md",
  "run": "five stages S1 Brief · S2 Plan · S3 Objects · S4 Fit-out · S5 3D, each one skill; runner.json"
 },
 "kit": "0.3.2",
 "inputs": [
  {
   "id": "roombrief",
   "from": "Projects/{PROJECT}/2-plan/space-brief/output/roombrief.json",
   "schema": "roombrief.v1",
   "required": false,
   "note": "from the Plan/Design phase (space-brief S8 archive); replaces deck intake S1-S2"
  },
  {
   "id": "plan",
   "from": "Projects/{PROJECT}/2-plan/space-brief/output/plan.canvas.json",
   "schema": "canvas.v1",
   "required": false,
   "note": "the design canvas; S3 starts from it instead of tracing deck pixels"
  },
  {
   "id": "deck",
   "from": "project:inputs/decks/*.{pptx,pdf,png,jpg,webp}",
   "required": false,
   "note": "a plan-phase deck (.pptx / .pdf) or one moodboard image (.png / .jpg / .webp) when no roombrief exists"
  },
  {
   "id": "room",
   "from": "project:project.json",
   "required": true,
   "note": "chosen by the USER (room picker), never by the agent"
  }
 ],
 "library_pins": [],
 "outputs": {
  "keep": [
   {
    "id": "roombrief",
    "local": "project:roombrief.json",
    "to": "{OUT}roombrief.json",
    "schema": "roombrief.v1"
   },
   {
    "id": "canvas",
    "local": "project:{CODE}.room.canvas.json",
    "to": "{OUT}{CODE}.room.canvas.json",
    "schema": "canvas.v1",
    "after": "S4_PLACE"
   },
   {
    "id": "resolve",
    "local": "project:resolve.json",
    "to": "{OUT}resolve.json",
    "after": "S3_CHECK"
   },
   {
    "id": "model",
    "local": "3d/*",
    "to": "{OUT}3d/",
    "binary": true,
    "after": "S5_3D"
   }
  ],
  "temp": [
   "deck/**",
   "catalog.json",
   "render/stills/**",
   "*.baked.json"
  ]
 },
 "skills": {
  "deck": {
   "id": "deck-reader",
   "version": "1.1.0"
  },
  "tracer": {
   "id": "floorplan-tracer",
   "version": "1.0.1"
  },
  "resolver": {
   "id": "object-resolver",
   "version": "1.1.0"
  },
  "improver": {
   "id": "floorplan-improver",
   "version": "1.1.0"
  },
  "renderer": {
   "id": "floorplan-renderer",
   "version": "1.0.0"
  }
 },
 "stages": [
  {
   "id": "S1",
   "title": "Brief",
   "skill": "deck",
   "gate": "brief",
   "tab": "brief"
  },
  {
   "id": "S2",
   "title": "Plan",
   "skill": "tracer",
   "gate": "plan",
   "tab": "plan"
  },
  {
   "id": "S3",
   "title": "Objects",
   "skill": "resolver",
   "gate": "objects",
   "tab": "objects"
  },
  {
   "id": "S4",
   "title": "Fit-out",
   "skill": "improver",
   "gate": "fitout",
   "tab": "fitout"
  },
  {
   "id": "S5",
   "title": "3D",
   "skill": "renderer",
   "gate": "3d",
   "tab": "3d"
  }
 ]
}
