{
 "schema": "pipeline/1",
 "id": "build-from-deck",
 "title": "Build (deck or image → live design → 3D)",
 "version": "0.6.0",
 "phase": "build",
 "entry": {
  "agents": "AGENTS.md",
  "run": "five stages S1 Brief · S2 Plan · S3 Objects · S4 Fit-out · S5 3D, each one skill; runner.json"
 },
 "kit": "0.3.2",
 "inputs": [
  {
   "id": "roombrief",
   "from": "Projects/{PROJECT}/2-plan/space-brief/output/roombrief.json",
   "schema": "roombrief.v1",
   "required": false,
   "note": "from the Plan/Design phase (space-brief S8 archive); replaces deck intake S1-S2"
  },
  {
   "id": "plan",
   "from": "Projects/{PROJECT}/2-plan/space-brief/output/plan.canvas.json",
   "schema": "canvas.v1",
   "required": false,
   "note": "the design canvas; S3 starts from it instead of tracing deck pixels"
  },
  {
   "id": "deck",
   "from": "project:inputs/decks/*.{pptx,pdf,png,jpg,webp}",
   "required": false,
   "note": "a plan-phase deck (.pptx / .pdf) or one moodboard image (.png / .jpg / .webp) when no roombrief exists"
  },
  {
   "id": "room",
   "from": "project:project.json",
   "required": true,
   "note": "chosen by the USER (room picker), never by the agent"
  }
 ],
 "library_pins": [],
 "outputs": {
  "keep": [
   {
    "id": "roombrief",
    "from": "{STEPS}S2_BRIEF/roombrief.json",
    "schema": "roombrief.v1"
   },
   {
    "id": "canvas",
    "from": "{STEPS}S2_PLAN/5-final.canvas.json",
    "schema": "canvas.v1",
    "by": "Claude (S2)"
   },
   {
    "id": "model",
    "from": "{OUT}<CODE>.glb",
    "binary": true,
    "by": "the editor (S3 export3d)"
   },
   {
    "id": "snapshots",
    "from": "{OUT}<CODE>.<view>.png",
    "binary": true,
    "by": "the editor (S3 export3d)"
   }
  ],
  "temp": [
   "deck/**"
  ]
 },
 "skills": {
  "deck": {
   "id": "deck-reader",
   "version": "1.3.0"
  },
  "tracer": {
   "id": "floorplan-tracer",
   "version": "1.2.0"
  },
  "resolver": {
   "id": "object-resolver",
   "version": "1.1.0"
  },
  "improver": {
   "id": "floorplan-improver",
   "version": "1.1.0"
  },
  "renderer": {
   "id": "floorplan-renderer",
   "version": "1.1.1"
  }
 },
 "stages": [
  {
   "id": "S1",
   "title": "Read",
   "skill": "deck",
   "gate": "brief",
   "tab": "brief"
  },
  {
   "id": "S2",
   "title": "Design",
   "skill": "tracer",
   "also": [
    "resolver",
    "improver"
   ],
   "gate": "plan",
   "tab": "plan",
   "live": true,
   "note": "Claude works on the live canvas through the connector: overlay + scale + north, walls / doors / windows, library objects, materials, lighting + additions — one canvas per sub-step (steps/S2_PLAN/<n>-*.canvas.json); the user answers each sub-step in the app (s2/* docs)."
  },
  {
   "id": "S3",
   "title": "3D",
   "gate": "3d",
   "tab": "3d",
   "in_app": true,
   "note": "The editor exports its live 3D scene (GLB + PNG snapshots) to output/ — pipeline.export3d; no runner, no Blender."
  }
 ]
}
