    "blenderNode": "ShaderNodeTexWave",
    "params": {
      "waveType": "BANDS",
      "bandsDirection": "X",
      "waveProfile": "SIN",
      "scale": 22,
      "distortion": 2.5,
      "detail": 4,
      "detailScale": 3,
      "detailRoughness": 0.6,
      "phaseOffset": 0,
      "colorA": "#dcc39d",
      "colorB": "#c9a97f"
    }
  },
  "pbr": {
