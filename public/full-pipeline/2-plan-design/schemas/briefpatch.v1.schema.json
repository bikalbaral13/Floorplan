{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "briefpatch.v1",
 "title": "spacebrief-patch/1 — what the briefing agent wants to change, and why",
 "description": "Written by the briefing agent (agents/BRIEFING_AGENT.md). tools/brief_agent.py compile checks it against the live brief and turns it into a spacebrief-run/1 the app applies as drafts and can undo. Every change cites the instruction items it came from.",
 "type": "object",
 "required": ["schema", "session", "mode", "instructions", "ops"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "spacebrief-patch/1"},
  "session": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{3,80}$", "description": "briefing session id, e.g. 2026-10-10-oneshot"},
  "mode": {"enum": ["one-shot", "conversation"]},
  "model": {"type": "string", "description": "the agent's model id, for the record"},
  "summary": {"type": "string", "maxLength": 300},
  "instructions": {
   "type": "array", "minItems": 1,
   "description": "The architect's input, itemised. One item per distinct instruction or file. These are the only grounds for a change.",
   "items": {"type": "object", "required": ["id", "kind", "summary"], "additionalProperties": false, "properties": {
     "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,15}$"},
     "kind": {"enum": ["text", "chat", "image", "sketch", "pdf", "voice", "link", "library", "app-message", "request"]},
     "source": {"type": "string", "description": "file path under the session folder, app message id (agent/<id>), request id or URL"},
     "summary": {"type": "string", "maxLength": 400}}}
  },
  "ops": {"type": "array", "items": {"type": "object", "required": ["op"], "properties": {
     "op": {"enum": ["spec", "set", "dims", "option", "library", "ref", "request", "fulfil", "new", "say", "done"]},
     "el": {"type": "string", "description": "element code (FL-01) or id"},
     "cites": {"type": "array", "items": {"type": "string"}},
     "set": {}, "field": {"enum": ["name", "notes", "cat", "code"]}, "value": {"type": "string"},
     "add": {"type": "object"}, "path": {"type": "string"}, "use": {"enum": ["spec", "option", "object", "ref"]},
     "file": {"type": "string"}, "files": {"type": "array", "items": {"type": "string"}}, "title": {"type": "string"},
     "source": {"enum": ["upload", "ai", "agent", "library"]}, "prompt": {"type": "string"}, "model": {"type": "string"},
     "style": {"type": "string"}, "n": {"type": "integer"}, "request": {"type": "string"},
     "name": {"type": "string"}, "cat": {"type": "string"}, "code": {"type": "string"},
     "place": {"type": "object"}, "like": {"type": "string"},
     "text": {"type": "string"}, "questions": {"type": "array"}, "msg": {"type": "string"}, "reply_to": {"type": "string"}}}}
 }
}
