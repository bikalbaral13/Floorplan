        "tool": "expr",
        "params": {
          "name": "Door maths",
          "expr": "ar = wa*PI/180\nux = cos(ar)\nuy = sin(ar)\nhw = len/2\njLx = px - hw*ux\njLy = py - hw*uy\njRx = px + hw*ux\njRy = py + hw*uy\nhgn = hinge == 'right' ? 1 : -1\nhx = px + hgn*hw*ux\nhy = py + hgn*hw*uy\nsgn = swing == 'right' ? -1 : 1\nqx = 0 - uy*sgn\nqy = ux*sgn\nlcx = hx + hw*qx\nlcy = hy + hw*qy\nlang = atan2(qy, qx)*180/PI\ncaStart = atan2(0 - hgn*uy, 0 - hgn*ux)*180/PI\ncaEnd = atan2(qy, qx)*180/PI\nnwa = 0 - wa"
        }
      }
    },
