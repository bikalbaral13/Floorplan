{
  "version": 1,
  "id": "watershed-delineation",
  "title": "Watershed Delineation",
  "category": "Hydrology",
  "description": "Pure MATRIX pipeline. Grid → synthetic DEM (Grid Field) → Grid Geometry (field→matrix) → Fill Depressions → Flow Direction → Flow Accumulation → Grid Threshold (streams) → Marching Squares (streamlines); Flow Direction → Watershed (basin) — all chained over val-matrix. Flow Accumulation, Watershed & (their) consumers rebuild the D8 direction channel from the incoming matrix where needed. Render Grid draws the accumulation channels (heatmap) and the catchment (categorical); the Marching Squares streamlines overlay them. Create a Grid on the canvas, then tune the DEM ramp, ε, the stream threshold and the Watershed outlet.",
  "nodes": [
    { "id": "grid", "position": { "x": 0, "y": 0 }, "data": { "tool": "grid-source", "params": { "id": "", "grabFromSelection": true } } },
    { "id": "dem", "position": { "x": 240, "y": 0 }, "data": { "tool": "grid-field", "params": { "direction": "top-bottom", "high": 100, "low": 0, "randomness": 0.35, "seed": 7, "inciseOccupied": false, "inciseDepth": 20, "lowColor": "#1e3a8a", "highColor": "#ef4444", "showCellValues": false } } },
    { "id": "grid-geo", "position": { "x": 500, "y": 0 }, "data": { "tool": "grid-geometry", "params": {} } },
    { "id": "filled", "position": { "x": 760, "y": 0 }, "data": { "tool": "fill-depressions", "params": { "matrix": "", "epsilon": 0.01, "edgesAreOutlets": true } } },
    { "id": "flowdir", "position": { "x": 1020, "y": 0 }, "data": { "tool": "flow-direction", "params": { "matrix": "", "method": "d8" } } },
    { "id": "flowacc", "position": { "x": 1300, "y": -120 }, "data": { "tool": "flow-accumulation", "params": { "matrix": "", "asArea": false } } },
    { "id": "streams", "position": { "x": 1580, "y": -280 }, "data": { "tool": "grid-threshold", "params": { "matrix": "", "op": ">", "threshold": 20 } } },
    { "id": "streamlines", "position": { "x": 1860, "y": -280 }, "data": { "tool": "marching-squares", "params": { "matrix": "", "levels": 1 } } },
    { "id": "basin", "position": { "x": 1300, "y": 160 }, "data": { "tool": "watershed", "params": { "matrix": "", "outlet": "5,14" } } },
    { "id": "render-acc", "position": { "x": 1580, "y": -40 }, "data": { "tool": "render-grid", "params": { "mode": "heatmap", "lowColor": "#f1f5f9", "highColor": "#1d4ed8", "cellSize": 1, "originX": 0, "originY": 0, "showCellValues": false } } },
    { "id": "render-basin", "position": { "x": 1580, "y": 160 }, "data": { "tool": "render-grid", "params": { "mode": "categorical", "cellSize": 1, "originX": 14, "originY": 0, "showCellValues": false } } }
  ],
  "edges": [
    { "id": "e1", "source": "grid", "target": "dem", "sourceHandle": null, "targetHandle": null },
    { "id": "e2", "source": "dem", "target": "grid-geo", "sourceHandle": null, "targetHandle": null },
    { "id": "e3", "source": "grid-geo", "target": "filled", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e4", "source": "filled", "target": "flowdir", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e5", "source": "flowdir", "target": "flowacc", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e6", "source": "flowdir", "target": "basin", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e7", "source": "flowacc", "target": "streams", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e8", "source": "streams", "target": "streamlines", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e9", "source": "flowacc", "target": "render-acc", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" },
    { "id": "e10", "source": "basin", "target": "render-basin", "sourceHandle": "val-matrix", "targetHandle": "valin-matrix" }
  ]
}
