{
  "version": 1,
  "id": "raster-to-spaces",
  "title": "Raster to Spaces (Auto-Tune)",
  "category": "Floorplan",
  "description": "Trace a plan/survey raster into closed Spaces without slider hit-and-trial. Image → Vectorisation → Graph to Spaces; press AUTO-TUNE on the Vectorisation node — it loops the tracing parameters (colour tolerance, despeckle, gap close, bridge gaps, node snap, spur pruning, plus the line colour itself), scores every combo on real results (closed spaces found, minus noise faces and open ends) with live progress, and bakes the best values back into the sliders. The Output node shows Spaces / Total Area / Open Ends / Traced Lines; Run commits the faces as wall loops → selectable Spaces. Set Min space area so text boxes and hatching don't count as rooms.",
  "nodes": [
    {
      "id": "image_1",
      "position": { "x": 40, "y": 220 },
      "data": { "tool": "image", "params": {} }
    },
    {
      "id": "vectorise_1",
      "position": { "x": 300, "y": 40 },
      "data": {
        "tool": "vectorise",
        "params": {
          "colorMode": "black",
          "tolerance": 50,
          "despeckle": 12,
          "dilate": 3,
          "spurLength": 10,
          "simplifyEpsilon": 2,
          "minLength": 30,
          "snapTolerance": 8,
          "connectGap": 12,
          "mergeAngle": 7,
          "orthoSnap": 0,
          "orthoTol": 10,
          "tuneMinArea": 1,
          "tuneColour": true
        }
      }
    },
    {
      "id": "graph-to-spaces_1",
      "position": { "x": 680, "y": 180 },
      "data": {
        "tool": "graph-to-spaces",
        "params": { "outputMode": "single", "minArea": 1 }
      }
    },
    {
      "id": "output_1",
      "position": { "x": 980, "y": 120 },
      "data": {
        "tool": "output",
        "params": {
          "slots": [
            { "id": "s1", "label": "Spaces" },
            { "id": "s2", "label": "Total Area (m²)" },
            { "id": "s3", "label": "Open Ends" },
            { "id": "s4", "label": "Traced Lines" }
          ]
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "image_1", "target": "vectorise_1", "sourceHandle": null, "targetHandle": null },
    { "id": "e2", "source": "vectorise_1", "target": "graph-to-spaces_1", "sourceHandle": null, "targetHandle": null },
    { "id": "e3", "source": "graph-to-spaces_1", "target": "output_1", "sourceHandle": "val-spaces", "targetHandle": "valin-s1" },
    { "id": "e4", "source": "graph-to-spaces_1", "target": "output_1", "sourceHandle": "val-totalArea", "targetHandle": "valin-s2" },
    { "id": "e5", "source": "vectorise_1", "target": "output_1", "sourceHandle": "val-openEnds", "targetHandle": "valin-s3" },
    { "id": "e6", "source": "vectorise_1", "target": "output_1", "sourceHandle": "val-lines", "targetHandle": "valin-s4" }
  ]
}
