{
  "kind": "flow-node",
  "version": 2,
  "tool": "math",
  "meta": {
    "label": "Math",
    "category": "Calculate",
    "color": "#ca8a04"
  },
  "description": "result = A (op) B, optionally rounded. e.g. BUA ÷ footprint, ceil = floors.",
  "instructions": "A generic value calculator: `result = A <op> B`, optionally rounded. A and B come from wired value inputs (`valin-a` / `valin-b`) or the fallback fields when unwired. Publishes `val-result`.\n\nTIP: the classic use is FSI BUA ÷ footprint area with round=ceil → number of floors (wire val-result into Massing's Floors). Chain Math nodes for multi-step arithmetic.",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      { "key": "a", "label": "A" },
      { "key": "b", "label": "B" }
    ],
    "valueOutputs": [
      { "key": "result", "label": "Result" }
    ]
  },
  "parameters": [
    { "key": "a", "label": "A (if no input)", "kind": "number", "default": 0, "step": 1 },
    { "key": "b", "label": "B (if no input)", "kind": "number", "default": 1, "step": 1 },
    {
      "key": "op",
      "label": "Operation",
      "kind": "select",
      "default": "divide",
      "options": [
        { "value": "divide", "label": "÷ Divide (A ÷ B)" },
        { "value": "multiply", "label": "× Multiply" },
        { "value": "add", "label": "+ Add" },
        { "value": "subtract", "label": "− Subtract (A − B)" },
        { "value": "min", "label": "Min (smaller of A, B)" },
        { "value": "max", "label": "Max (larger of A, B)" }
      ]
    },
    {
      "key": "round",
      "label": "Round",
      "kind": "select",
      "default": "ceil",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "ceil", "label": "Ceil (round up)" },
        { "value": "floor", "label": "Floor (round down)" },
        { "value": "round", "label": "Nearest" }
      ]
    }
  ]
}
