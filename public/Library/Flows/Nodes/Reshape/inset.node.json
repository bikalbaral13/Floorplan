{
  "kind": "flow-node",
  "version": 2,
  "tool": "inset",
  "meta": {
    "label": "Inset",
    "category": "Reshape",
    "color": "#0369a1"
  },
  "description": "A pure CALCULATION node — offset the boundary inward or outward: coordinates in, coordinates out. Draws nothing on canvas.",
  "instructions": "A value-only node: it takes a polygon as a coordinate LIST and returns the result as a coordinate list. It has no geometry input or output and draws nothing on the canvas — wire val-polygons into a Polygon node when you want it drawn.\n\nINPUT: `polygon` takes the outline as JSON [[x,y],...] metre pairs, local to the anchor. Wire Space Geometry's val-points into valin-polygon. A nested [[[x,y],...],...] list is accepted too — the LARGEST piece is used, since this node works on one polygon.\n\nOUTPUT: val-polygons publishes the result as a nested [[[x,y],...],...] list, which a Polygon node accepts directly.\n\nEvery parameter is wireable (valin-*).",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      {
        "key": "polygon",
        "label": "Polygon"
      },
      {
        "key": "uniformSetback",
        "label": "Offset"
      },
      {
        "key": "front",
        "label": "Front offset"
      },
      {
        "key": "remaining",
        "label": "Remaining offset"
      },
      {
        "key": "frontEdgeIndex",
        "label": "Edge index"
      },
      {
        "key": "inside",
        "label": "Inside"
      },
      {
        "key": "mode",
        "label": "Mode"
      },
      {
        "key": "frontEdgeMode",
        "label": "Front edge"
      },
      {
        "key": "setbacks",
        "label": "Setbacks"
      }
    ],
    "valueOutputs": [
      {
        "key": "area",
        "label": "Area",
        "unit": "m²"
      },
      {
        "key": "points",
        "label": "Points"
      },
      {
        "key": "polygons",
        "label": "Polygons (JSON)"
      }
    ]
  },
  "parameters": [
    {
      "key": "polygon",
      "label": "Polygon (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "inside",
      "label": "Inside",
      "kind": "checkbox",
      "default": true
    },
    {
      "key": "mode",
      "label": "Mode",
      "kind": "select",
      "default": "equal",
      "options": [
        {
          "value": "equal",
          "label": "Equal"
        },
        {
          "value": "front-remaining",
          "label": "Front & Remaining"
        },
        {
          "value": "variable",
          "label": "Per-edge"
        }
      ]
    },
    {
      "key": "uniformSetback",
      "label": "Offset",
      "kind": "range",
      "default": 1,
      "min": 0,
      "max": 5,
      "step": 0.05,
      "unit": "m",
      "showWhen": "mode == 'equal'"
    },
    {
      "key": "front",
      "label": "Front offset",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 5,
      "step": 0.05,
      "unit": "m",
      "showWhen": "mode == 'front-remaining'"
    },
    {
      "key": "remaining",
      "label": "Remaining offset",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 5,
      "step": 0.05,
      "unit": "m",
      "showWhen": "mode == 'front-remaining'"
    },
    {
      "key": "frontEdgeMode",
      "label": "Front edge",
      "kind": "select",
      "default": "longest",
      "options": [
        {
          "value": "longest",
          "label": "Longest (auto)"
        },
        {
          "value": "index",
          "label": "By edge index"
        }
      ],
      "showWhen": "mode == 'front-remaining'"
    },
    {
      "key": "frontEdgeIndex",
      "label": "Edge index",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 19,
      "step": 1,
      "showWhen": "mode == 'front-remaining' && frontEdgeMode == 'index'"
    },
    {
      "key": "setbacks",
      "label": "Setbacks (per edge)",
      "kind": "text",
      "default": "1, 0.5, 0.5",
      "placeholder": "1, 0.5, 0.5, 2",
      "showWhen": "mode == 'variable'"
    }
  ]
}
