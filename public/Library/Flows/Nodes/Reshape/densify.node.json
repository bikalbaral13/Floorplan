{
  "kind": "flow-node",
  "version": 2,
  "tool": "densify",
  "meta": {
    "label": "Resample",
    "category": "Reshape",
    "color": "#16a34a"
  },
  "description": "A pure CALCULATION node — add vertices along the boundary (shape unchanged): coordinates in, coordinates out. Draws nothing on canvas.",
  "instructions": "A value-only node: it takes a polygon as a coordinate LIST and returns the result as a coordinate list. It has no geometry input or output and draws nothing on the canvas — wire val-polygons into a Polygon node when you want it drawn.\n\nINPUT: polygon takes the outline as JSON [[x,y],...] metre pairs, local to the anchor. Wire Space Geometry val-points into valin-polygon. A nested [[[x,y],...],...] list (from Split / Voronoi / BSP …) is accepted too — the LARGEST piece is used, since this node works on one polygon.\n\nOUTPUT: val-polygons publishes the result as a nested [[[x,y],...],...] list, which a Polygon node accepts directly.\n\nEvery parameter is wireable (valin-*).",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      {
        "key": "polygon",
        "label": "Polygon"
      },
      {
        "key": "maxLength",
        "label": "Max segment length"
      },
      {
        "key": "count",
        "label": "Points / edge"
      },
      {
        "key": "rdpTol",
        "label": "Tolerance"
      },
      {
        "key": "targetVertices",
        "label": "Target vertices"
      },
      {
        "key": "stride",
        "label": "Keep every Nth"
      }
    ],
    "valueOutputs": [
      {
        "key": "polygons",
        "label": "Polygons (JSON)"
      }
    ]
  },
  "parameters": [
    {
      "key": "polygon",
      "label": "Polygon (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "mode",
      "label": "Mode",
      "kind": "select",
      "default": "length",
      "options": [
        {
          "value": "length",
          "label": "Densify · by max length"
        },
        {
          "value": "count",
          "label": "Densify · points / edge"
        },
        {
          "value": "collinear",
          "label": "Simplify · remove collinear"
        },
        {
          "value": "rdp",
          "label": "Simplify · Douglas-Peucker"
        },
        {
          "value": "visvalingam",
          "label": "Simplify · target vertices"
        },
        {
          "value": "stride",
          "label": "Reduce · keep every Nth"
        }
      ]
    },
    {
      "key": "maxLength",
      "label": "Max segment length",
      "kind": "range",
      "default": 5,
      "min": 0.2,
      "max": 50,
      "step": 0.2,
      "unit": "m",
      "showWhen": "mode == 'length'"
    },
    {
      "key": "count",
      "label": "Points / edge",
      "kind": "range",
      "default": 2,
      "min": 1,
      "max": 20,
      "step": 1,
      "showWhen": "mode == 'count'"
    },
    {
      "key": "collinearTol",
      "label": "Angle tolerance",
      "kind": "range",
      "default": 1,
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "°",
      "showWhen": "mode == 'collinear'"
    },
    {
      "key": "rdpTol",
      "label": "Tolerance",
      "kind": "range",
      "default": 1,
      "min": 0.05,
      "max": 20,
      "step": 0.05,
      "unit": "m",
      "showWhen": "mode == 'rdp'"
    },
    {
      "key": "targetVertices",
      "label": "Target vertices",
      "kind": "range",
      "default": 8,
      "min": 3,
      "max": 60,
      "step": 1,
      "showWhen": "mode == 'visvalingam'"
    },
    {
      "key": "stride",
      "label": "Keep every Nth",
      "kind": "range",
      "default": 2,
      "min": 2,
      "max": 10,
      "step": 1,
      "showWhen": "mode == 'stride'"
    }
  ]
}
