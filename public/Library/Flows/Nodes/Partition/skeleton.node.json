{
  "kind": "flow-node",
  "version": 2,
  "tool": "skeleton",
  "materialisesSpace": true,
  "meta": { "label": "Skeleton", "category": "Partition", "color": "#0891b2" },
  "description": "Medial axis of the space → closed Regions (spaces, default) or Branches (lines). Prune+Join reduces the region count. Longest branch keeps only the main run; Make path turns the branches into ONE seamless constant-width band (closed polygons) of Path width.",
  "instructions": "Computes the medial axis of each input Space. TYPE (`type`) = Sampled Voronoi / Sweepline (segments) / Straight Skeleton. EMIT (`emit`) = Regions (closed face polygons → Spaces, insettable) or Branches (raw medial-axis lines).\n\nStraight-skeleton controls: `level` (detail), `reduceLevel` (midpoint segment reduction), `pruneEnds` (drop short spurs) → then `joinToBoundary` (extend pruned tips to the boundary) / `longestBranch` (keep only the main run); `makePath` + `pathWidth` turn the branches into ONE seamless constant-width band. Sampled/sweepline use `samples`.\n\nOne output handle per region/space, or a single bundle (`outputMode`). TIP: feed Regions into Inset for corridor rooms; Make path for a corridor spine.",
  "handles": {
    "input": true,
    "output": true,
    "outputCount": "outputMode == 'single' ? 1 : max(1, min(40, round(handleCount)))"
  },
  "parameters": [
    {
      "key": "type",
      "label": "Type",
      "kind": "select",
      "default": "straight-skeleton",
      "options": [
        { "value": "sampled-voronoi", "label": "Sampled Voronoi" },
        { "value": "segment-sweepline", "label": "Sweepline (segments)" },
        { "value": "straight-skeleton", "label": "Straight Skeleton" }
      ]
    },
    {
      "key": "emit",
      "label": "Emit",
      "kind": "select",
      "default": "regions",
      "options": [
        { "value": "regions", "label": "Regions (spaces)" },
        { "value": "branches", "label": "Branches (lines)" }
      ]
    },
    {
      "key": "outputMode",
      "label": "Outputs",
      "kind": "select",
      "default": "perCell",
      "options": [
        { "value": "perCell", "label": "Per cell (one each)" },
        { "value": "single", "label": "Single (all)" }
      ]
    },
    { "key": "samples", "label": "Samples", "kind": "range", "default": 8, "min": 2, "max": 20, "step": 1, "showWhen": "type != 'straight-skeleton'" },
    { "key": "level", "label": "Level", "kind": "range", "default": 1, "min": 1, "max": 4, "step": 1, "showWhen": "type == 'straight-skeleton'" },
    { "key": "reduceLevel", "label": "Reduce segments", "kind": "range", "default": 0, "min": 0, "max": 5, "step": 1, "showWhen": "type == 'straight-skeleton'" },
    { "key": "pruneEnds", "label": "Prune ends", "kind": "checkbox", "default": true, "showWhen": "type == 'straight-skeleton'" },
    { "key": "joinToBoundary", "label": "Join to boundary", "kind": "checkbox", "default": false, "showWhen": "type == 'straight-skeleton' && pruneEnds" },
    { "key": "longestBranch", "label": "Longest branch", "kind": "checkbox", "default": false, "showWhen": "type == 'straight-skeleton' && pruneEnds" },
    { "key": "makePath", "label": "Make path", "kind": "checkbox", "default": false, "showWhen": "type == 'straight-skeleton'" },
    { "key": "pathWidth", "label": "Path width", "kind": "range", "default": 1, "min": 0, "max": 50, "step": 0.1, "unit": "m", "showWhen": "type == 'straight-skeleton' && makePath" }
  ]
}
