{
  "kind": "flow-node",
  "version": 2,
  "tool": "split",
  "meta": {
    "label": "Split",
    "category": "Partition",
    "color": "#0d9488"
  },
  "description": "Split a polygon into pieces — a pure CALCULATION node: coordinates in, coordinates out. Draws nothing on canvas.",
  "instructions": "A value-only node: it takes a polygon as a coordinate LIST and returns its pieces as a coordinate list. It has no geometry input or output and draws nothing on the canvas — wire val-polygons into a Polygon node when you want the pieces drawn.\n\nINPUT: polygon takes the outline as JSON [[x,y],...] metre pairs, local to the anchor. Wire Space Geometry val-points into valin-polygon.\n\nOUTPUT: val-polygons publishes every piece as a nested [[[x,y],...],...] list, which a Polygon node accepts directly. NOTE: this is the WHOLE set — there are no per-piece handles any more, so a single piece can no longer be selected downstream.\n\nSPLIT: type / count / mode / target / ratios / angle / principalMethod shape the cut. Every parameter is wireable (valin-*).",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      {
        "key": "polygon",
        "label": "Polygon"
      },
      {
        "key": "type",
        "label": "Type"
      },
      {
        "key": "count",
        "label": "Pieces"
      },
      {
        "key": "principalMethod",
        "label": "Method"
      },
      {
        "key": "mode",
        "label": "Sizing"
      },
      {
        "key": "target",
        "label": "First piece area"
      },
      {
        "key": "ratios",
        "label": "Ratios"
      },
      {
        "key": "splitAlongMinorPrincipalAxis",
        "label": "Along minor axis"
      },
      {
        "key": "angle",
        "label": "Angle"
      },
      {
        "key": "stripLength",
        "label": "Strip length"
      },
      {
        "key": "stripPosition",
        "label": "Strip position"
      }
    ],
    "valueOutputs": [
      {
        "key": "polygons",
        "label": "Polygons (JSON)"
      }
    ]
  },
  "parameters": [
    {
      "key": "polygon",
      "label": "Polygon (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "type",
      "label": "Type",
      "kind": "select",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "strip",
          "label": "Strip"
        },
        {
          "value": "principal",
          "label": "Principal Axes"
        }
      ]
    },
    {
      "key": "count",
      "label": "Pieces",
      "kind": "range",
      "default": 2,
      "min": 2,
      "max": 12,
      "step": 1,
      "showWhen": "(type == 'normal' && mode != 'ratio') || type == 'principal'"
    },
    {
      "key": "principalMethod",
      "label": "Method",
      "kind": "select",
      "default": "pca",
      "options": [
        {
          "value": "pca",
          "label": "PCA (moments)"
        },
        {
          "value": "obb",
          "label": "Min-area OBB"
        },
        {
          "value": "skeleton",
          "label": "Straight Skeleton"
        }
      ],
      "showWhen": "type == 'principal'"
    },
    {
      "key": "mode",
      "label": "Sizing",
      "kind": "select",
      "default": "equal",
      "options": [
        {
          "value": "equal",
          "label": "Equal (area)"
        },
        {
          "value": "target",
          "label": "Target area"
        },
        {
          "value": "ratio",
          "label": "Ratio"
        }
      ],
      "showWhen": "type == 'normal'"
    },
    {
      "key": "target",
      "label": "First piece area",
      "kind": "range",
      "default": 20,
      "min": 1,
      "max": 200,
      "step": 1,
      "unit": "m²",
      "showWhen": "type == 'normal' && mode == 'target'"
    },
    {
      "key": "ratios",
      "label": "Ratios",
      "kind": "text",
      "default": "1, 2, 1",
      "placeholder": "1, 2, 1",
      "showWhen": "type == 'normal' && mode == 'ratio'"
    },
    {
      "key": "splitAlongMinorPrincipalAxis",
      "label": "Along minor axis",
      "kind": "checkbox",
      "default": false,
      "showWhen": "type == 'normal'"
    },
    {
      "key": "angle",
      "label": "Angle",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°",
      "showWhen": "type != 'principal' && !splitAlongMinorPrincipalAxis"
    },
    {
      "key": "stripLength",
      "label": "Strip length",
      "kind": "range",
      "default": 1,
      "min": 0.1,
      "max": 20,
      "step": 0.05,
      "unit": "m",
      "showWhen": "type == 'strip'"
    },
    {
      "key": "stripPosition",
      "label": "Strip position",
      "kind": "range",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "showWhen": "type == 'strip'"
    }
  ]
}
