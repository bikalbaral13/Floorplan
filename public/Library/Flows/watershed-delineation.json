      "target": "flowacc",
      "sourceHandle": null,
      "targetHandle": null
    },
    {
      "id": "e5",
      "source": "flowacc",
      "target": "streams",
      "sourceHandle": null,
      "targetHandle": null
    },
    {
      "id": "e6",
      "source": "streams",
      "target": "streamlines",
      "sourceHandle": null,
      "targetHandle": null
    },
    {
      "id": "e7",
      "source": "flowdir",
      "target": "basin",
      "sourceHandle": null,
      "targetHandle": null
    }
  ]
