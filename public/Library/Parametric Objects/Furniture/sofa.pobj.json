      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "seatHeight",
      "label": "Seat Height",
      "kind": "number",
      "default": 0.45,
      "min": 0.38,
      "max": 0.55,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "backHeight",
      "label": "Back Height",
      "kind": "number",
      "default": 0.85,
      "min": 0.6,
