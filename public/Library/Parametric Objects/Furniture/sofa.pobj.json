    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#0ea5e9"
    }
  ],
  "geometry": {
    "description": "Detailed sofa: width derives from Seats × Seat Width (+ arms). Frame base on four legs (CYLINDRICAL — drawn as a circle in plan and a cylinder in 3D — or square), a back panel at +Y, two arms (style sets their height; 'Armless' removes them), one seat cushion per seat, optional back cushions, and an optional left/right chaise extension. Every piece extrudes to its real height, so the 2D plan and the 3D mesh come from the same params.",
    "emit": "shapes",
    "vars": {
      "N": "max(1, round(seats))",
      "sw": "seatWidth",
      "aw": "armStyle == 'none' ? 0 : armWidth",
      "ah": "armStyle == 'low' ? 0.55 : armStyle == 'standard' ? 0.68 : 0",
      "sd": "seatDepth",
      "bt": "0.18",
      "W": "N*seatWidth + 2*(armStyle == 'none' ? 0 : armWidth)",
      "D": "seatDepth + 0.18",
      "L": "legHeight",
      "sh": "seatHeight",
      "bh": "backHeight",
      "lr": "legRadius",
      "lx": "W/2 - lr - 0.03",
      "ly": "D/2 - lr - 0.03",
      "cyl": "legStyle == 'cylindrical'",
      "ext": "chaise == 'none' ? 0 : max(0, chaiseLength - (seatDepth + 0.18))"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "cylindrical legs",
            "when": "cyl",
            "circle": {
              "cx": "-lx",
              "cy": "-ly",
              "r": "lr",
              "h0": "0",
              "h1": "L",
              "sides": "20"
            }
          },
          {
            "comment": "cylindrical legs",
            "when": "cyl",
            "circle": {
              "cx": "lx",
              "cy": "-ly",
              "r": "lr",
              "h0": "0",
              "h1": "L",
              "sides": "20"
            }
          },
          {
            "comment": "cylindrical legs",
            "when": "cyl",
            "circle": {
              "cx": "-lx",
              "cy": "ly",
              "r": "lr",
              "h0": "0",
              "h1": "L",
              "sides": "20"
            }
          },
          {
            "comment": "cylindrical legs",
            "when": "cyl",
            "circle": {
              "cx": "lx",
              "cy": "ly",
              "r": "lr",
              "h0": "0",
              "h1": "L",
              "sides": "20"
            }
          },
          {
            "comment": "square legs",
            "when": "legStyle == 'square'",
            "box": {
              "x0": "-lx - lr",
              "x1": "-lx + lr",
              "y0": "-ly - lr",
              "y1": "-ly + lr",
              "h0": "0",
              "h1": "L"
            }
          },
          {
            "comment": "square legs",
            "when": "legStyle == 'square'",
            "box": {
              "x0": "lx - lr",
              "x1": "lx + lr",
              "y0": "-ly - lr",
              "y1": "-ly + lr",
              "h0": "0",
              "h1": "L"
            }
          },
          {
            "comment": "square legs",
            "when": "legStyle == 'square'",
            "box": {
              "x0": "-lx - lr",
              "x1": "-lx + lr",
              "y0": "ly - lr",
              "y1": "ly + lr",
              "h0": "0",
              "h1": "L"
            }
          },
          {
            "comment": "square legs",
            "when": "legStyle == 'square'",
            "box": {
              "x0": "lx - lr",
              "x1": "lx + lr",
              "y0": "ly - lr",
              "y1": "ly + lr",
              "h0": "0",
              "h1": "L"
            }
          },
          {
            "comment": "frame base",
            "box": {
              "x0": "-W/2",
              "x1": "W/2",
              "y0": "-D/2",
              "y1": "D/2",
              "h0": "L",
              "h1": "L + 0.1"
            }
          },
          {
            "comment": "back panel",
            "box": {
              "x0": "-W/2",
              "x1": "W/2",
              "y0": "D/2 - bt",
              "y1": "D/2",
              "h0": "L",
              "h1": "bh"
            }
          },
          {
            "comment": "left arm",
            "when": "armStyle != 'none'",
            "box": {
              "x0": "-W/2",
              "x1": "-W/2 + aw",
              "y0": "-D/2",
              "y1": "D/2",
              "h0": "L",
              "h1": "ah"
            }
          },
          {
            "comment": "right arm",
            "when": "armStyle != 'none'",
            "box": {
              "x0": "W/2 - aw",
              "x1": "W/2",
              "y0": "-D/2",
              "y1": "D/2",
              "h0": "L",
              "h1": "ah"
            }
          },
          {
            "comment": "seat cushions",
            "repeat": "N",
            "as": "k",
            "box": {
              "x0": "-W/2 + aw + k*sw + 0.03",
              "x1": "-W/2 + aw + (k+1)*sw - 0.03",
              "y0": "-D/2 + 0.05",
              "y1": "D/2 - bt - 0.03",
              "h0": "L + 0.1",
              "h1": "sh"
            }
          },
          {
            "comment": "back cushions",
            "when": "backCushions",
            "repeat": "N",
            "as": "k",
            "box": {
              "x0": "-W/2 + aw + k*sw + 0.03",
              "x1": "-W/2 + aw + (k+1)*sw - 0.03",
              "y0": "D/2 - bt - 0.2",
              "y1": "D/2 - bt - 0.02",
              "h0": "sh",
              "h1": "sh + 0.32"
            }
          },
          {
            "comment": "chaise left",
            "when": "chaise == 'left'",
            "box": {
              "x0": "-W/2 + aw",
              "x1": "-W/2 + aw + sw",
              "y0": "-D/2 - ext",
              "y1": "-D/2",
              "h0": "L",
              "h1": "sh"
            }
          },
          {
            "comment": "chaise right",
            "when": "chaise == 'right'",
            "box": {
              "x0": "W/2 - aw - sw",
              "x1": "W/2 - aw",
              "y0": "-D/2 - ext",
              "y1": "-D/2",
              "h0": "L",
              "h1": "sh"
            }
          }
        ]
      }
    ]
  },
  "hostKind": "node"
}
