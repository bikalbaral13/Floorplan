    },
    {
      "key": "wallOffset",
      "label": "Offset from Wall",
      "kind": "number",
      "default": 0,
      "min": -2,
      "max": 2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Clearance from Floor",
      "kind": "number",
      "default": 0,
      "min": 0,
