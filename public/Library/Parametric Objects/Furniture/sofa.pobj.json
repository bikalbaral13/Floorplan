      "unit": "m"
    },
    {
      "key": "legStyle",
      "label": "Leg Style",
      "kind": "select",
      "default": "cylindrical",
      "options": [
        {
          "value": "cylindrical",
          "label": "Cylindrical"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "key": "legHeight",
      "label": "Leg Height",
      "kind": "number",
      "default": 0.12,
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "legRadius",
      "label": "Leg Radius",
      "kind": "number",
      "default": 0.03,
      "min": 0.015,
      "max": 0.08,
