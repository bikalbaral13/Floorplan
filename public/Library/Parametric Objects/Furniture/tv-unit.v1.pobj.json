{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "tv-unit.v1",
    "name": "TV Unit",
    "category": "Furniture/Living"
  },
  "parameters": [
    {
      "key": "width",
      "label": "Width",
      "kind": "number",
      "default": 1.8,
      "min": 1,
      "max": 3,
      "unit": "m"
    },
    {
      "key": "depth",
      "label": "Depth",
      "kind": "number",
      "default": 0.45,
      "min": 0.3,
      "max": 0.8,
      "unit": "m"
    },
    {
      "key": "height",
      "label": "Height",
      "kind": "number",
      "default": 0.5,
      "min": 0.3,
      "max": 1,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#4b5563"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "w2": "width / 2",
      "d2": "depth / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "box": {
              "x0": "-w2",
              "x1": "w2",
              "y0": "-d2",
              "y1": "d2",
              "h0": 0,
              "h1": "height"
            }
          },
          {
            "comment": "TV Screen",
            "box": {
              "x0": "-w2 * 0.8",
              "x1": "w2 * 0.8",
              "y0": "d2 - 0.05",
              "y1": "d2",
              "h0": "height",
              "h1": "height + 0.8"
            }
          }
        ]
      }
    ]
  }
}
