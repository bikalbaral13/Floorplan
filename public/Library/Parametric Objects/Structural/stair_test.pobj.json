{
  "kind": "parametric-object",
  "version": 3,
  "meta": {
    "id": "stair_test",
    "name": "Stair Test",
    "category": "Structural",
    "units": "m"
  },
  "description": "PILOT — parameters ONLY (no geometry block), mirroring staircase.pobj.json's parameter set exactly. The staircase is built from GENERAL flow nodes (Match + Math + Rectangle + Loop + Cuboid + Loop 3D), not the pobj render engine — see staircase-flow.json, which reproduces the Staircase node's buildStaircaseBoxes layout for ALL configurations (straight / u-shape / u-shape-mid), in 2D plan and 3D, including direction, midSteps overrides and landings. Declared-for-parity but not consumed by the flow (matching the Staircase node, which also ignores them): stepStyle, treadThickness (the flow's Loop 3D has a `liftBase` toggle for floating treads if wanted), landingCuts (a plan annotation).",
  "parameters": [
    { "key": "config", "label": "Configuration", "kind": "select", "default": "straight", "options": [ { "value": "straight", "label": "Straight" }, { "value": "u-shape", "label": "U-shape" }, { "value": "u-shape-mid", "label": "U-shape (mid landing)" } ] },
    { "key": "steps", "label": "Number of Steps", "kind": "number", "default": 14, "min": 2, "max": 60, "step": 1 },
    { "key": "tread", "label": "Tread (going)", "kind": "number", "default": 0.28, "min": 0.2, "max": 0.5, "step": 0.005, "unit": "m" },
    { "key": "riser", "label": "Riser (rise)", "kind": "number", "default": 0.17, "min": 0.1, "max": 0.22, "step": 0.005, "unit": "m" },
    { "key": "width", "label": "Width", "kind": "number", "default": 1.0, "min": 0.6, "max": 2.5, "step": 0.05, "unit": "m" },
    { "key": "direction", "label": "Direction", "kind": "select", "default": "ltr", "options": [ { "value": "ltr", "label": "Left → Right" }, { "value": "rtl", "label": "Right → Left" } ] },
    { "key": "midSteps", "label": "Mid / split steps", "kind": "number", "default": 0, "min": 0, "max": 30, "step": 1 },
    { "key": "landingWidth", "label": "Landing depth", "kind": "number", "default": 1.0, "min": 0, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "midSpace", "label": "Mid space (between flights)", "kind": "number", "default": 0.1, "min": 0, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "landingCuts", "label": "Landing cuts", "kind": "number", "default": 1, "min": 1, "max": 6, "step": 1 },
    { "key": "stepStyle", "label": "Step style", "kind": "select", "default": "solid", "options": [ { "value": "solid", "label": "Solid (filled)" }, { "value": "open", "label": "Open (tread only)" } ] },
    { "key": "treadThickness", "label": "Tread thickness", "kind": "number", "default": 0.06, "min": 0.02, "max": 0.2, "step": 0.005, "unit": "m" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#0f766e" }
  ]
}
