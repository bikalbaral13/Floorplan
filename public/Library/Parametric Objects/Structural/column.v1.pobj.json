{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "column.v1",
    "name": "Column",
    "category": "Structural",
    "symbol": "wall",
    "icon": {
      "paths": [
        "M8 4h8v16H8z",
        "M12 4v16"
      ]
    }
  },
  "parameters": [
    {
      "key": "shape",
      "label": "Shape",
      "kind": "select",
      "default": "rectangular",
      "options": [
        {
          "value": "rectangular",
          "label": "Rectangular"
        },
        {
          "value": "circular",
          "label": "Circular"
        }
      ]
    },
    {
      "key": "length",
      "label": "Length",
      "kind": "number",
      "default": 0.4,
      "min": 0.1,
      "max": 2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "breadth",
      "label": "Breadth",
      "kind": "number",
      "default": 0.4,
      "min": 0.1,
      "max": 2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "radius",
      "label": "Radius",
      "kind": "number",
      "default": 0.2,
      "min": 0.05,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "height",
      "label": "Height",
      "kind": "number",
      "default": 3,
      "min": 0.1,
      "max": 12,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#94a3b8"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "cases": [
      {
        "rules": [
          {
            "when": "shape == 'rectangular'",
            "box": {
              "x0": "-length / 2",
              "x1": "length / 2",
              "y0": "-breadth / 2",
              "y1": "breadth / 2",
              "h0": 0,
              "h1": "height"
            }
          },
          {
            "when": "shape == 'circular'",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "radius",
              "h0": 0,
              "h1": "height"
            }
          }
        ]
      }
    ]
  }
}