{
  "kind": "parametric-object",
  "version": 3,
  "meta": { "id": "footing_test", "name": "Footing Test", "category": "Structural", "units": "m" },
  "description": "PILOT — parameters ONLY (no geometry block), mirroring footing.ts's toFootingSpec. The footing is built from GENERAL flow nodes (a multi-output Expression block + Cuboids for the 3D layer stack + Rectangles for the plan footprints), not the footing render engine — see footing-flow.json, which reproduces buildFootingLayers for the SPREAD type (column + RCC pad + PCC + soling), in 2D plan and 3D. Declared-for-parity but not consumed by the flow (they need primitives that don't exist yet — a tapered-prism 'frustum' and a per-instance-scaled loop): the SLOPED type's frustum and the STEPPED type's widening steps.",
  "parameters": [
    { "key": "type", "label": "Footing type", "kind": "select", "default": "spread", "options": [ { "value": "spread", "label": "Spread (flat pad)" }, { "value": "sloped", "label": "Sloped (frustum)" }, { "value": "stepped", "label": "Stepped" } ] },
    { "key": "columnWidth", "label": "Column width", "kind": "number", "default": 0.3, "min": 0.1, "max": 1.5, "step": 0.01, "unit": "m" },
    { "key": "columnDepth", "label": "Column depth", "kind": "number", "default": 0.3, "min": 0.1, "max": 1.5, "step": 0.01, "unit": "m" },
    { "key": "columnHeight", "label": "Column height", "kind": "number", "default": 1.0, "min": 0.2, "max": 6, "step": 0.05, "unit": "m" },
    { "key": "baseWidth", "label": "Base width", "kind": "number", "default": 1.5, "min": 0.3, "max": 5, "step": 0.05, "unit": "m" },
    { "key": "baseDepth", "label": "Base depth", "kind": "number", "default": 1.5, "min": 0.3, "max": 5, "step": 0.05, "unit": "m" },
    { "key": "rccThickness", "label": "RCC thickness", "kind": "number", "default": 0.2, "min": 0.05, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "pccThickness", "label": "PCC thickness", "kind": "number", "default": 0.1, "min": 0, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "solingThickness", "label": "Soling thickness", "kind": "number", "default": 0.1, "min": 0, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "frustumHeight", "label": "Frustum height", "kind": "number", "default": 0.2, "min": 0.05, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "frustumTopWidth", "label": "Frustum top width", "kind": "number", "default": 0.6, "min": 0.1, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "frustumTopDepth", "label": "Frustum top depth", "kind": "number", "default": 0.6, "min": 0.1, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "steps", "label": "Steps", "kind": "number", "default": 3, "min": 1, "max": 8, "step": 1 },
    { "key": "skew", "label": "Eccentric skew", "kind": "select", "default": "center", "options": [ { "value": "center", "label": "Centred" }, { "value": "left", "label": "Left face flush" }, { "value": "right", "label": "Right face flush" } ] },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#7c3aed" }
  ]
}
