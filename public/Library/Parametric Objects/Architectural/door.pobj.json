{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "door.single.v1",
    "name": "Door",
    "category": "Openings/Doors",
    "units": "m",
    "symbol": "door",
    "icon": {
      "paths": ["M6 21V4h8v17", "M14 4a11 11 0 0 1 5 10", "M14 21h6"]
    }
  },
  "parameters": [
    { "key": "doorType", "label": "Type", "kind": "select", "default": "hinged", "options": [
      { "value": "hinged", "label": "Hinged (single)" },
      { "value": "double", "label": "Double swing" },
      { "value": "french", "label": "French (glazed double)" },
      { "value": "sliding", "label": "Sliding" },
      { "value": "sliding-double", "label": "Sliding (bypass)" },
      { "value": "pocket", "label": "Pocket" },
      { "value": "bifold", "label": "Bi-fold" }
    ] },
    { "key": "width", "label": "Leaf width", "kind": "number", "default": 0.9, "min": 0.4, "max": 2.4, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 2.1, "min": 1.8, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "swing", "label": "Swing angle", "kind": "number", "default": 90, "min": 0, "max": 180, "step": 5, "unit": "°" },
    { "key": "hinge", "label": "Hinge / slide side", "kind": "select", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "key": "openFrac", "label": "Open amount", "kind": "number", "default": 0.7, "min": 0, "max": 1, "step": 0.05 },
    { "key": "leafThickness", "label": "Leaf thickness", "kind": "number", "default": 0.04, "min": 0.02, "max": 0.1, "step": 0.005, "unit": "m" },
    { "key": "frame", "label": "Frame / jambs", "kind": "checkbox", "default": true },
    { "key": "leaves", "label": "Leaves (legacy)", "kind": "select", "default": "single", "options": [ { "value": "single", "label": "Single" }, { "value": "double", "label": "Double" } ] },
    { "key": "glassColor", "label": "Glass color", "kind": "color", "default": "#bae6fd" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°" },
    { "key": "color", "label": "Leaf color", "kind": "color", "default": "#b45309" }
  ],
  "geometry": {
    "description": "Segment-hosted door, opening centred on the node along local X, swinging into +Y. `doorType` picks the symbol; the legacy `leaves` select still forces a double swing. Contract preserved: single-leaf types put jambs at ±W/2, double at ±W; the leaf is a thin extruded panel (0→Height) and the swing arc is a plan-only polyline.",
    "emit": "shapes",
    "vars": {
      "W": "width",
      "H": "height",
      "sr": "swing * PI / 180",
      "hs": "hinge == 'right' ? -1 : 1",
      "t": "leafThickness",
      "arcN": "14",
      "of": "min(1, max(0, openFrac))",
      "effType": "doorType == 'hinged' ? (leaves == 'double' ? 'double' : 'hinged') : doorType",
      "py": "0.06"
    },
    "cases": [
      {
        "when": "effType == 'double' || effType == 'french'",
        "description": "Two leaves hinged at ±W meeting at centre; french tints them as glass.",
        "vars": { "lc": "effType == 'french' ? glassColor : color" },
        "rules": [
          { "comment": "left leaf", "poly": { "h0": 0, "h1": "H", "color": "lc", "pts": [ [ "-W", 0 ], [ "-W + W*cos(sr)", "W*sin(sr)" ], [ "-W + W*cos(sr) - t*sin(sr)", "W*sin(sr) + t*cos(sr)" ], [ "-W - t*sin(sr)", "t*cos(sr)" ] ] } },
          { "comment": "right leaf", "poly": { "h0": 0, "h1": "H", "color": "lc", "pts": [ [ "W", 0 ], [ "W - W*cos(sr)", "W*sin(sr)" ], [ "W - W*cos(sr) + t*sin(sr)", "W*sin(sr) + t*cos(sr)" ], [ "W + t*sin(sr)", "t*cos(sr)" ] ] } },
          { "comment": "left swing arc", "repeat": "arcN", "as": "k", "line": { "pts": [ [ "-W + W*cos(k/arcN*sr)", "W*sin(k/arcN*sr)" ], [ "-W + W*cos((k+1)/arcN*sr)", "W*sin((k+1)/arcN*sr)" ] ] } },
          { "comment": "right swing arc", "repeat": "arcN", "as": "k", "line": { "pts": [ [ "W - W*cos(k/arcN*sr)", "W*sin(k/arcN*sr)" ], [ "W - W*cos((k+1)/arcN*sr)", "W*sin((k+1)/arcN*sr)" ] ] } },
          { "comment": "left jamb", "when": "frame", "box": { "x0": "-W - 0.05", "x1": "-W", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } },
          { "comment": "right jamb", "when": "frame", "box": { "x0": "W", "x1": "W + 0.05", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } }
        ]
      },
      {
        "when": "effType == 'sliding'",
        "description": "One panel sliding parallel to the wall; parks toward the hinge side by openFrac.",
        "vars": { "shift": "hs * W * of" },
        "rules": [
          { "comment": "track", "box": { "x0": "-W/2 - W*of - 0.02", "x1": "W/2 + 0.02", "y0": "py + 0.005", "y1": "py + 0.02", "h0": "H - 0.04", "h1": "H", "color": "'#94a3b8'" } },
          { "comment": "panel", "box": { "x0": "-W/2 + shift", "x1": "W/2 + shift", "y0": "py + 0.02", "y1": "py + 0.02 + t", "h0": 0, "h1": "H", "color": "color" } },
          { "comment": "left jamb", "when": "frame", "box": { "x0": "-W/2 - 0.05", "x1": "-W/2", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } },
          { "comment": "right jamb", "when": "frame", "box": { "x0": "W/2", "x1": "W/2 + 0.05", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } }
        ]
      },
      {
        "when": "effType == 'sliding-double'",
        "description": "Two bypassing panels sliding apart; each covers half the opening when closed.",
        "vars": { "sh": "(W/2) * of" },
        "rules": [
          { "comment": "track", "box": { "x0": "-W/2 - sh - 0.02", "x1": "W/2 + sh + 0.02", "y0": "py + 0.005", "y1": "py + 0.02", "h0": "H - 0.04", "h1": "H", "color": "'#94a3b8'" } },
          { "comment": "left panel (slides -x, front rail)", "box": { "x0": "-W/2 - sh", "x1": "-sh", "y0": "py + 0.02", "y1": "py + 0.02 + t", "h0": 0, "h1": "H", "color": "color" } },
          { "comment": "right panel (slides +x, rear rail)", "box": { "x0": "sh", "x1": "W/2 + sh", "y0": "py + 0.03 + t", "y1": "py + 0.03 + 2*t", "h0": 0, "h1": "H", "color": "color" } },
          { "comment": "left jamb", "when": "frame", "box": { "x0": "-W/2 - 0.05", "x1": "-W/2", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } },
          { "comment": "right jamb", "when": "frame", "box": { "x0": "W/2", "x1": "W/2 + 0.05", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } }
        ]
      },
      {
        "when": "effType == 'pocket'",
        "description": "Panel slides into the wall cavity on the hinge side (shown as a recess outline).",
        "vars": { "dir": "-hs", "pStart": "hs > 0 ? -W/2 : W/2" },
        "rules": [
          { "comment": "pocket cavity outline in the wall", "line": { "pts": [ [ "pStart", "-py" ], [ "pStart + dir * W", "-py" ], [ "pStart + dir * W", "py" ], [ "pStart", "py" ] ] } },
          { "comment": "panel (parked in the pocket by openFrac)", "box": { "x0": "min(pStart, pStart + dir * W * of)", "x1": "max(pStart, pStart + dir * W * of) + (W - W*of)", "y0": "-t/2", "y1": "t/2", "h0": 0, "h1": "H", "color": "color" } },
          { "comment": "leading jamb (open side)", "when": "frame", "box": { "x0": "hs > 0 ? W/2 : -W/2 - 0.05", "x1": "hs > 0 ? W/2 + 0.05 : -W/2", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } }
        ]
      },
      {
        "when": "effType == 'bifold'",
        "description": "Two folding panels (accordion) hinged at one jamb; fold depth follows the swing angle.",
        "vars": {
          "hx": "-hs * (W/2)",
          "fa": "sr * 0.5 + 0.3",
          "p1x": "hx + hs * (W/2) * cos(fa)",
          "p1y": "(W/2) * sin(fa)"
        },
        "rules": [
          { "comment": "panel 1 (jamb → fold)", "poly": { "h0": 0, "h1": "H", "color": "color", "pts": [ [ "hx", 0 ], [ "p1x", "p1y" ], [ "p1x - t*sin(fa)", "p1y + t*cos(fa)" ], [ "hx - t*sin(fa)", "t*cos(fa)" ] ] } },
          { "comment": "panel 2 (fold → centre, folds back)", "poly": { "h0": 0, "h1": "H", "color": "color", "pts": [ [ "p1x", "p1y" ], [ "p1x + hs * (W/2) * cos(fa) * 0.2 + hs * (W/2)", 0 ], [ "p1x + hs * (W/2) * cos(fa) * 0.2 + hs * (W/2)", "t" ], [ "p1x", "p1y + t" ] ] } },
          { "comment": "left jamb", "when": "frame", "box": { "x0": "-W/2 - 0.05", "x1": "-W/2", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } },
          { "comment": "right jamb", "when": "frame", "box": { "x0": "W/2", "x1": "W/2 + 0.05", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } }
        ]
      },
      {
        "description": "Single leaf hinged at one jamb; opening spans W with jambs at ±W/2. Default (also the composition contract).",
        "vars": { "hx": "-hs * (W/2)" },
        "rules": [
          { "comment": "leaf", "poly": { "h0": 0, "h1": "H", "color": "color", "pts": [ [ "hx", 0 ], [ "hx + W*hs*cos(sr)", "W*sin(sr)" ], [ "hx + W*hs*cos(sr) - t*sin(sr)", "W*sin(sr) + t*hs*cos(sr)" ], [ "hx - t*sin(sr)", "t*hs*cos(sr)" ] ] } },
          { "comment": "swing arc", "repeat": "arcN", "as": "k", "line": { "pts": [ [ "hx + W*hs*cos(k/arcN*sr)", "W*sin(k/arcN*sr)" ], [ "hx + W*hs*cos((k+1)/arcN*sr)", "W*sin((k+1)/arcN*sr)" ] ] } },
          { "comment": "left jamb", "when": "frame", "box": { "x0": "-W/2 - 0.05", "x1": "-W/2", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } },
          { "comment": "right jamb", "when": "frame", "box": { "x0": "W/2", "x1": "W/2 + 0.05", "y0": "-py", "y1": "py", "h0": 0, "h1": "H" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "openingWidth", "label": "Opening width", "expr": "effType == 'double' || effType == 'french' ? 2 * width : width", "unit": "m" }
  ],
  "hostKind": "segment"
}
