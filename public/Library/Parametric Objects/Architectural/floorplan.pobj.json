  "geometry": {
    "description": "Rectangular → built-in BSP generator, which now COMPOSES its doors (door.single.v1), windows (window.standard.v1) and furniture (sofa.v2 / table.dining.v1 in the largest room, bed.v2 elsewhere, gated by Furnish) as ref children with stable instance paths (door[k] / window[k] / bed[k] / sofa[0] / table[0]); inline symbols only as a no-library fallback. L / T / I / C / Z / stepped → the same built-in generator, but the footprint is a rectilinear OUTLINE decomposed into non-overlapping rectangular cells (each independently BSP'd) + arm/band seams drawn as partition walls so a Door joins them; the floor slab is the outline polygon and the perimeter walls are its edges. Each shape's proportions come from this scope's case `vars` (flangeD/webW, armD/backW, barT/stemW) or the `steps` param, with matching in-code defaults. Doors, Windows and furniture compose identically across all modes. With `have_spine` on, each cell is first split into a central corridor strip (along its longer side) + the two flanking sub-cells; only the flanks feed the BSP, the corridor is drawn as a light circulation-floor fill, and each spine edge is a partition wall opened with a door for every room along it. North arrow drawn on every mode.",
    "emit": "shapes",
    "vars": {
      "_doc": "Boundary sizing: `auto` derives W×D (centreline span) from Rooms × Avg Area at Aspect; `inner`/`outer` take Dim X/Y as the CLEAR inner (or overall outer) boundary dimensions and convert to the centreline using the perimeter wall thickness (Interior Wall in rectangular mode, Exterior Wall for L/T shells).",
      "area": "max(4, rooms * roomArea)",
      "Wauto": "sqrt(area * max(0.2, aspect))",
      "pT": "extWall",
      "W": "sizeMode == 'inner' ? dimX + pT : (sizeMode == 'outer' ? dimX - pT : Wauto)",
      "D": "sizeMode == 'inner' ? dimY + pT : (sizeMode == 'outer' ? dimY - pT : area / Wauto)",
      "ww": "wallWidth",
      "wh": "wallHeight",
      "eh": "extWall / 2",
      "sill": "sillHeight",
      "lintel": "max(sillHeight + 0.1, lintelHeight)",
      "dw": "doorWidth",
      "wdw": "windowWidth",
      "dhx": "-dw/2",
      "dhy": "-D/2 + eh",
      "nx": "W/2 + 0.95",
      "ny": "D/2 - 0.55"
    },
    "cases": [
      {
        "comment": "L-SHAPE — left arm (width lw) + full-width bottom arm (depth ld); notch top-right. Seeded-BSP rooms fill both arms + a door joins them (see generateFloorplan).",
        "when": "mode == 'L-shape'",
        "vars": {
          "lw": "W * 0.45",
          "ld": "D * 0.45"
        },
        "rules": [
          {
            "floorplan": true
          },
          {
            "comment": "north ring",
            "when": "showNorth",
            "circle": {
              "cx": "nx",
              "cy": "ny",
              "r": "0.42",
              "sides": "24",
              "h0": "0",
              "h1": "0"
            }
          },
          {
            "comment": "north shaft",
            "when": "showNorth",
            "line": {
              "h0": "0",
              "h1": "0",
              "pts": [
                [
                  "nx",
                  "ny-0.3"
                ],
                [
                  "nx",
                  "ny+0.18"
                ]
              ]
            }
          },
          {
            "comment": "north head",
            "when": "showNorth",
            "poly": {
              "h0": "0",
              "h1": "0",
              "pts": [
                [
                  "nx",
                  "ny+0.42"
                ],
                [
                  "nx-0.12",
                  "ny+0.12"
                ],
                [
                  "nx+0.12",
                  "ny+0.12"
                ]
              ]
            }
          }
        ]
      },
      {
        "comment": "T-SHAPE — top bar + centred stem (width sw) down to ty. Seeded-BSP rooms fill bar + stem + a door joins them (see generateFloorplan).",
        "when": "mode == 'T-shape'",
        "vars": {
          "sw": "W * 0.42",
          "ty": "D/2 - D*0.42"
        },
        "rules": [
          {
            "floorplan": true
          },
          {
            "comment": "north ring",
            "when": "showNorth",
            "circle": {
              "cx": "nx",
              "cy": "ny",
              "r": "0.42",
              "sides": "24",
              "h0": "0",
              "h1": "0"
            }
          },
          {
            "comment": "north shaft",
            "when": "showNorth",
            "line": {
              "h0": "0",
              "h1": "0",
