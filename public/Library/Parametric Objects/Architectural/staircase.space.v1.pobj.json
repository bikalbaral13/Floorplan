{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "staircase.space.v1",
    "name": "Staircase",
    "category": "Architecture/Circulation",
    "symbol": "staircase"
  },
  "parameters": [
    {
      "key": "steps",
      "label": "Steps",
      "kind": "number",
      "default": 10,
      "min": 2,
      "max": 30
    },
    {
      "key": "height",
      "label": "Total Height",
      "kind": "number",
      "default": 3,
      "unit": "m"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#94a3b8"
    }
  ],
  "hostKind": "space",
  "geometry": {
    "vars": {
      "stepH": "height / steps"
    },
    "cases": [
      {
        "rules": [
          {
            "repeat": "steps",
            "as": "i",
            "vars": {
              "insetM": "i * 0.3"
            },
            "host": {
              "inset": "insetM",
              "h0": "i * stepH",
              "h1": "(i + 1) * stepH"
            }
          }
        ]
      }
    ]
  }
}