{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "path.v1",
    "name": "Path",
    "category": "Architectural"
  },
  "parameters": [
    {
      "key": "width",
      "label": "Width",
      "kind": "number",
      "default": 1
    },
    {
      "key": "length",
      "label": "Length",
      "kind": "number",
      "default": 5
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#ADD8E6"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "cases": [
      {
        "rules": [
          {
            "box": {
              "x0": "-length / 2",
              "x1": "length / 2",
              "y0": "-width / 2",
              "y1": "width / 2",
              "h0": 0,
              "h1": 0.1
            },
            "color": "color"
          }
        ]
      }
    ]
  }
}