{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "turbine.v1",
    "name": "Turbine",
    "category": "Hydraulics/Powerhouse",
    "units": "m",
    "icon": { "paths": ["M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0", "M12 12l6 -3", "M12 12l-6 -3", "M12 12v7", "M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"] }
  },
  "parameters": [
    { "key": "type", "label": "Type", "kind": "select", "default": "francis", "options": [ { "value": "pelton", "label": "Pelton" }, { "value": "francis", "label": "Francis" }, { "value": "kaplan", "label": "Kaplan" } ] },
    { "key": "Q", "label": "Discharge Q", "kind": "number", "default": 5.0, "min": 0.1, "max": 100, "step": 0.5, "unit": "m³/s" },
    { "key": "H_net", "label": "Net head", "kind": "number", "default": 200, "min": 2, "max": 1000, "step": 5, "unit": "m" },
    { "key": "eta", "label": "Efficiency η", "kind": "number", "default": 0.88, "min": 0.7, "max": 0.95, "step": 0.01 },
    { "key": "freq", "label": "Grid frequency", "kind": "number", "default": 50, "min": 50, "max": 60, "step": 10, "unit": "Hz" },
    { "key": "poles", "label": "Generator poles", "kind": "number", "default": 6, "min": 2, "max": 40, "step": 2 },
    { "key": "runnerDiameter", "label": "Runner diameter", "kind": "number", "default": 1.4, "min": 0.3, "max": 6, "step": 0.1, "unit": "m" },
    { "key": "shaftDiameter", "label": "Shaft diameter", "kind": "number", "default": 0.35, "min": 0.1, "max": 1.2, "step": 0.05, "unit": "m" },
    { "key": "casingDiameter", "label": "Casing diameter", "kind": "number", "default": 3.0, "min": 0.6, "max": 12, "step": 0.1, "unit": "m" },
    { "key": "shaftHeight", "label": "Shaft height", "kind": "number", "default": 2.2, "min": 0.5, "max": 6, "step": 0.1, "unit": "m" },
    { "key": "blades", "label": "Buckets / blades", "kind": "number", "default": 16, "min": 3, "max": 30, "step": 1 },
    { "key": "nJets", "label": "Pelton jets", "kind": "number", "default": 4, "min": 1, "max": 6, "step": 1 },
    { "key": "sides", "label": "Roundness", "kind": "number", "default": 32, "min": 8, "max": 64, "step": 1 },
    { "key": "color", "label": "Runner color", "kind": "color", "default": "#64748b" },
    { "key": "casingColor", "label": "Casing color", "kind": "color", "default": "#475569" },
    { "key": "shaftColor", "label": "Shaft color", "kind": "color", "default": "#94a3b8" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -5, "max": 5, "step": 0.1, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 5, "step": 0.1, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "description": "Representative turbine footprint: casing/volute + runner + shaft, with Pelton buckets & jets or Francis/Kaplan blades. Power, synchronous speed and specific speed (which sets the turbine type) are computed as outputs exactly like the sizing tool.",
    "vars": {
      "rr": "runnerDiameter / 2",
      "cr": "casingDiameter / 2",
      "sr": "shaftDiameter / 2",
      "nsides": "max(8, round(sides))",
      "nb": "max(3, round(blades))",
      "nj": "max(1, round(nJets))",
      "base": "0.3",
      "runnerTop": "0.3 + runnerDiameter * 0.35",
      "casingTop": "0.3 + runnerDiameter * 0.5"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Foundation / pit", "circle": { "cx": 0, "cy": 0, "r": "cr * 1.08", "sides": "nsides", "h0": 0, "h1": "base", "color": "casingColor" } },
          { "comment": "Francis volute / Kaplan casing", "when": "type != 'pelton'", "circle": { "cx": 0, "cy": 0, "r": "cr", "sides": "nsides", "h0": "base", "h1": "casingTop", "color": "casingColor" } },
          { "comment": "Pelton wheel pit ring", "when": "type == 'pelton'", "circle": { "cx": 0, "cy": 0, "r": "cr", "sides": "nsides", "h0": "base", "h1": "base + 0.12", "color": "casingColor" } },
          { "comment": "Draft tube below (reaction turbines)", "when": "type != 'pelton'", "circle": { "cx": 0, "cy": 0, "r": "rr * 0.85", "sides": "nsides", "h0": "-runnerDiameter * 0.8", "h1": "base", "color": "casingColor" } },
          { "comment": "Runner disc", "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "base", "h1": "runnerTop", "color": "color" } },
          {
            "comment": "Pelton buckets around the rim",
            "when": "type == 'pelton'",
            "repeat": "nb",
            "as": "k",
            "vars": { "a": "k * 2 * PI / nb", "bx": "cos(a) * rr", "by": "sin(a) * rr" },
            "box": { "x0": "bx - 0.05", "x1": "bx + 0.05", "y0": "by - 0.05", "y1": "by + 0.05", "h0": "base", "h1": "runnerTop + 0.03", "color": "color" }
          },
          {
            "comment": "Francis / Kaplan blades radiating from the hub",
            "when": "type != 'pelton'",
            "repeat": "nb",
            "as": "k",
            "vars": { "a": "k * 2 * PI / nb", "ca": "cos(a)", "sa": "sin(a)", "px": "-sa", "py": "ca" },
            "poly": {
              "h0": "base + 0.02", "h1": "runnerTop", "color": "color",
              "pts": [ [ "sr * ca + px * 0.02", "sr * sa + py * 0.02" ], [ "rr * ca + px * 0.02", "rr * sa + py * 0.02" ], [ "rr * ca - px * 0.02", "rr * sa - py * 0.02" ], [ "sr * ca - px * 0.02", "sr * sa - py * 0.02" ] ]
            }
          },
          {
            "comment": "Pelton jets / nozzles aimed at the runner",
            "when": "type == 'pelton'",
            "repeat": "nj",
            "as": "k",
            "vars": { "a": "PI + k * 2 * PI / nj * 0.5", "nx": "cos(a)", "ny": "sin(a)" },
            "box": { "x0": "nx * cr - 0.06", "x1": "nx * cr + 0.06", "y0": "ny * cr - 0.06", "y1": "ny * cr + 0.06", "h0": "base", "h1": "base + 0.12", "color": "shaftColor" }
          },
          { "comment": "Shaft up to the generator floor", "circle": { "cx": 0, "cy": 0, "r": "sr", "sides": 16, "h0": "runnerTop", "h1": "runnerTop + shaftHeight", "color": "shaftColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "power_kW", "label": "Power output", "expr": "round(eta * 9.81 * Q * H_net)", "unit": "kW" },
    { "key": "power_MW", "label": "Power output", "expr": "round(eta * 9.81 * Q * H_net / 100) / 10", "unit": "MW" },
    { "key": "N_sync", "label": "Synchronous speed", "expr": "round(60 * freq / (poles / 2))", "unit": "rpm" },
    { "key": "Ns", "label": "Specific speed Ns", "expr": "round((60 * freq / (poles / 2)) * sqrt(eta * 9.81 * Q * H_net) / pow(H_net, 1.25))" },
    { "key": "jetVelocity", "label": "Jet velocity (Pelton)", "expr": "round(0.97 * sqrt(2 * 9.81 * H_net) * 10) / 10", "unit": "m/s" }
  ]
}
