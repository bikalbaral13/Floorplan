{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "gravel-trap.v1",
    "name": "Gravel Trap",
    "category": "Hydraulics/Sediment",
    "units": "m",
    "icon": { "paths": ["M4 6h16v3l-2 9H6l-2 -9z", "M4 9h16", "M9 6V4h6v2"] }
  },
  "parameters": [
    { "key": "Q", "label": "Design discharge Q", "kind": "number", "default": 5.0, "min": 0.1, "max": 100, "step": 0.5, "unit": "m³/s" },
    { "key": "d_mm", "label": "Trap particle size d", "kind": "number", "default": 2.0, "min": 0.2, "max": 20, "step": 0.1, "unit": "mm" },
    { "key": "rho_s", "label": "Sediment density", "kind": "number", "default": 2650, "min": 1500, "max": 3200, "step": 50, "unit": "kg/m³" },
    { "key": "rho_w", "label": "Water density", "kind": "number", "default": 1000, "min": 950, "max": 1100, "step": 10, "unit": "kg/m³" },
    { "key": "nu", "label": "Kinematic viscosity ×1e6", "kind": "number", "default": 1.0, "min": 0.3, "max": 2, "step": 0.05, "unit": "e-6 m²/s" },
    { "key": "vh", "label": "Horizontal velocity", "kind": "number", "default": 0.6, "min": 0.1, "max": 2, "step": 0.05, "unit": "m/s" },
    { "key": "BoverY", "label": "Width / depth ratio", "kind": "number", "default": 3.0, "min": 1, "max": 8, "step": 0.5 },
    { "key": "k", "label": "Length safety factor", "kind": "number", "default": 1.2, "min": 1, "max": 2, "step": 0.05 },
    { "key": "freeboard", "label": "Freeboard", "kind": "number", "default": 0.3, "min": 0, "max": 1, "step": 0.05, "unit": "m" },
    { "key": "storageDepth", "label": "Sediment storage depth", "kind": "number", "default": 0.3, "min": 0, "max": 2, "step": 0.05, "unit": "m" },
    { "key": "wallThickness", "label": "Wall thickness", "kind": "number", "default": 0.3, "min": 0.1, "max": 1, "step": 0.05, "unit": "m" },
    { "key": "color", "label": "Concrete color", "kind": "color", "default": "#9ca3af" },
    { "key": "waterColor", "label": "Water color", "kind": "color", "default": "#38bdf8" },
    { "key": "siltColor", "label": "Sediment color", "kind": "color", "default": "#92400e" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -5, "max": 5, "step": 0.1, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 5, "step": 0.1, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "description": "Open rectangular gravel trap. Chamber width B, depth y and settling length L are DERIVED from the discharge, horizontal velocity and the Zanke settling velocity (w) exactly like the design tool: A=Q/vh, B=sqrt(BoverY·A), y=A/B, L = k·vh·(y/w).",
    "vars": {
      "g": "9.81",
      "d": "d_mm / 1000",
      "s": "rho_s / rho_w",
      "nuv": "nu * 0.000001",
      "term": "1 + 0.01 * (s - 1) * g * pow(d, 3) / pow(nuv, 2)",
      "w": "(10 * nuv / d) * (sqrt(term) - 1)",
      "A": "Q / vh",
      "B": "sqrt(BoverY * A)",
      "y": "A / (sqrt(BoverY * A))",
      "ts": "(A / (sqrt(BoverY * A))) / w",
      "L": "k * vh * ((A / (sqrt(BoverY * A))) / w)",
      "yTotal": "A / (sqrt(BoverY * A)) + storageDepth + freeboard",
      "wt": "wallThickness",
      "L2": "k * vh * ((A / (sqrt(BoverY * A))) / w) / 2",
      "B2": "sqrt(BoverY * A) / 2"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Base slab", "box": { "x0": "-L2 - wt", "x1": "L2 + wt", "y0": "-B2 - wt", "y1": "B2 + wt", "h0": "-wt", "h1": 0, "color": "color" } },
          { "comment": "Left end wall", "box": { "x0": "-L2 - wt", "x1": "-L2", "y0": "-B2 - wt", "y1": "B2 + wt", "h0": 0, "h1": "yTotal", "color": "color" } },
          { "comment": "Right end wall", "box": { "x0": "L2", "x1": "L2 + wt", "y0": "-B2 - wt", "y1": "B2 + wt", "h0": 0, "h1": "yTotal", "color": "color" } },
          { "comment": "Front side wall", "box": { "x0": "-L2", "x1": "L2", "y0": "-B2 - wt", "y1": "-B2", "h0": 0, "h1": "yTotal", "color": "color" } },
          { "comment": "Back side wall", "box": { "x0": "-L2", "x1": "L2", "y0": "B2", "y1": "B2 + wt", "h0": 0, "h1": "yTotal", "color": "color" } },
          { "comment": "Sediment storage zone", "when": "storageDepth > 0", "box": { "x0": "-L2", "x1": "L2", "y0": "-B2", "y1": "B2", "h0": 0, "h1": "storageDepth", "color": "siltColor" } },
          { "comment": "Water body", "box": { "x0": "-L2", "x1": "L2", "y0": "-B2", "y1": "B2", "h0": "storageDepth", "h1": "storageDepth + y", "color": "waterColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "B", "label": "Chamber width B", "expr": "sqrt(BoverY * (Q / vh))", "unit": "m" },
    { "key": "y", "label": "Water depth y", "expr": "(Q / vh) / sqrt(BoverY * (Q / vh))", "unit": "m" },
    { "key": "L", "label": "Settling length L", "expr": "k * vh * (((Q / vh) / sqrt(BoverY * (Q / vh))) / w)", "unit": "m" },
    { "key": "w", "label": "Settling velocity w", "expr": "w * 1000", "unit": "mm/s" },
    { "key": "volume", "label": "Chamber volume", "expr": "(k * vh * (((Q / vh) / sqrt(BoverY * (Q / vh))) / w)) * sqrt(BoverY * (Q / vh)) * ((Q / vh) / sqrt(BoverY * (Q / vh)))", "unit": "m³" },
    { "key": "Re", "label": "Particle Reynolds", "expr": "w * d / nuv" }
  ]
}
