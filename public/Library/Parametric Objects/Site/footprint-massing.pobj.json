{
  "kind": "parametric-object",
  "version": 3,
  "meta": {
    "id": "footprint.massing.v1",
    "name": "Footprint Massing",
    "category": "Architecture/Massing",
    "units": "m",
    "symbol": "massing"
  },
  "description": "Self-contained Site-Massing study (the whole Flow recipe dissolved into one object). Attach to a SPACE (the plot). INPUTS = the flow's input-props (setbacks, FSI rates, fungible, podium, floor height). CALCULATIONS live in `geometry.vars` (the FSI/BUA math chain). GEOMETRY runs a pipeline over the host footprint: tower = host → front/remaining inset (front applied to the `frontEdgeIndex` edge, `remaining` to the rest) → SPLIT (carve a buildable zone of area `footprintEstimate`; the remainder is emitted as a flat AMENITY open-space footprint) → optimise rectangle → floor-massing UP (floors derived from FSI BUA); basement = host → equal podium inset → floor-massing DOWN. OUTPUTS = published metrics (areas, BUA, floors, height, coverage) read via evalParametricOutputs and shown in the Space Properties → Output Metrics block. Per-segment front/side is by EDGE INDEX for now (no per-segment type tag yet).",
  "parameters": [
    {
      "key": "front",
      "label": "Front Setback",
      "kind": "number",
      "default": 10.8,
      "min": 0,
      "max": 30,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "remaining",
      "label": "Side / Rear Setback",
      "kind": "number",
      "default": 3.2,
      "min": 0,
      "max": 30,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "frontEdgeIndex",
      "label": "Front Edge Index",
      "kind": "number",
      "default": 3,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "key": "amenityOsRate",
      "label": "Amenity Open Space Rate",
      "kind": "number",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "basicFsi",
      "label": "Basic FSI",
      "kind": "number",
      "default": 1,
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    {
      "key": "premiumFsi",
      "label": "Premium FSI",
      "kind": "number",
      "default": 0.5,
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    {
      "key": "tdr",
      "label": "TDR",
      "kind": "number",
      "default": 0.9,
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    {
      "key": "fung",
      "label": "Fungible Rate",
      "kind": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "schemeFsi",
      "label": "Scheme FSI Area",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 50000,
      "step": 100,
      "unit": "m²"
    },
    {
      "key": "otherNonFsi",
      "label": "Other Non-FSI Area",
      "kind": "number",
      "default": 8000,
      "min": 0,
      "max": 50000,
      "step": 100,
      "unit": "m²"
    },
    {
      "key": "carParks",
      "label": "Car Parks",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 2000,
      "step": 1
    },
    {
      "key": "areaPerCarPark",
      "label": "Area / Car Park",
      "kind": "number",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "m²"
    },
    {
      "key": "groundCoverage",
      "label": "Ground Coverage (footprint est.)",
      "kind": "number",
      "default": 0.5,
      "min": 0.05,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "podiumOffset",
      "label": "Podium / Basement Setback",
      "kind": "number",
      "default": 2.8,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "splitAngle",
      "label": "Split Angle",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°"
    },
    {
      "key": "floorHeight",
      "label": "Floor-to-floor Height",
      "kind": "number",
      "default": 3,
      "min": 2,
      "max": 6,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "rectCount",
      "label": "Number of Rectangles",
      "kind": "number",
      "default": 1,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#64748b"
    }
  ],
  "geometry": {
    "vars": {
      "_doc": "FSI / BUA calculation chain — mirrors the Site-massing flow's Math nodes.",
      "amenityArea": "hostArea * amenityOsRate",
      "netPlot": "hostArea - amenityArea",
      "basicBua": "netPlot * basicFsi",
      "premiumBua": "netPlot * premiumFsi",
      "tdrBua": "netPlot * tdr",
      "schemeBua": "schemeFsi",
      "exFungBua": "basicBua + premiumBua + tdrBua + schemeBua",
      "fungZonal": "basicBua * fung",
      "fungOthers": "(schemeBua + tdrBua) * fung",
      "fsiBua": "exFungBua + fungZonal + fungOthers",
      "nonFsiBua": "otherNonFsi + carParks * areaPerCarPark",
      "footprintEstimate": "netPlot * groundCoverage",
      "towerFloors": "max(1, ceil(fsiBua / max(1, footprintEstimate)))",
      "basementFloors": "max(1, ceil(nonFsiBua / max(1, netPlot)))"
    },
    "pipeline": [
      {
        "op": "host"
      },
      {
        "op": "inset",
        "params": {
          "mode": "front-remaining",
          "front": "front",
          "remaining": "remaining",
          "frontEdgeMode": "index",
          "frontEdgeIndex": "frontEdgeIndex",
          "inside": true
        }
      },
      {
        "op": "outline"
      },
      {
        "op": "split",
        "params": {
          "mode": "target",
          "target": {
            "$expr": "footprintEstimate"
          },
          "angle": "splitAngle",
          "keep": 0
        }
      },
      {
        "op": "outline"
      },
      {
        "op": "optimise-rect",
        "params": {
          "shape": "rectangle",
          "count": "rectCount",
          "reference": "none"
        }
      },
      {
        "op": "outline"
      },
      {
        "op": "floor-massing",
        "params": {
          "n": {
            "$expr": "towerFloors"
          },
          "direction": "upward",
          "floorHeight": "floorHeight"
        }
      },
      {
        "op": "host"
      },
      {
        "op": "inset",
        "params": {
          "mode": "equal",
          "uniformSetback": "podiumOffset",
          "inside": true
        }
      },
      {
        "op": "floor-massing",
        "params": {
          "n": {
            "$expr": "basementFloors"
          },
          "direction": "downward",
          "floorHeight": "floorHeight"
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "plotArea",
      "label": "Plot Area",
      "expr": "hostArea",
      "unit": "m²"
    },
    {
      "key": "amenityArea",
      "label": "Amenity Open Space",
      "expr": "amenityArea",
      "unit": "m²"
    },
    {
      "key": "netPlot",
      "label": "Net Plot Area",
      "expr": "netPlot",
      "unit": "m²"
    },
    {
      "key": "fsiBua",
      "label": "FSI BUA",
      "expr": "fsiBua",
      "unit": "m²"
    },
    {
      "key": "nonFsiBua",
      "label": "Non-FSI BUA",
      "expr": "nonFsiBua",
      "unit": "m²"
    },
    {
      "key": "totalBua",
      "label": "Total BUA",
      "expr": "fsiBua + nonFsiBua",
      "unit": "m²"
    },
    {
      "key": "towerFloors",
      "label": "Number of Floors",
      "expr": "towerFloors"
    },
    {
      "key": "basementFloors",
      "label": "Basement Floors",
      "expr": "basementFloors"
    },
    {
      "key": "buildingHeight",
      "label": "Building Height",
      "expr": "towerFloors * floorHeight",
      "unit": "m"
    },
    {
      "key": "groundCoverage",
      "label": "Ground Coverage",
      "expr": "footprintEstimate / max(1, hostArea)"
    }
  ],
  "hostKind": "space"
}
