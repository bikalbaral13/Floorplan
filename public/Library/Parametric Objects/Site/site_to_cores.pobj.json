{
  "kind": "parametric-object",
  "version": 3,
  "meta": {
    "id": "site.to.cores.v1",
    "name": "Site to Cores",
    "category": "Site",
    "units": "m",
    "symbol": "massing"
  },
  "description": "The Site-to-Cores flow recipe dissolved into one object — attach to a SPACE (the plot). PARAMETERS are exactly the flow's Input Properties (FSI / setback / massing / core controls). CALCULATIONS (`geometry.vars`) mirror the flow's Math chain (amenity → net plot → BUA → floors). GEOMETRY runs the flow's ops over the host footprint via three host-reset branches: (1) CORES = inset (setbacks) → split (keep buildable) → optimise rectangle → corridor → core-racking → fill (the racked core Spaces); (2) TOWER = same footprint → floor-massing UP (towerFloors from FSI BUA); (3) BASEMENT = footprint → podium outset → floor-massing DOWN. OUTPUTS = the flow's Output metrics. NOTE: floor counts use a footprint ESTIMATE (netPlot × 0.5) since a pobj var can't read the live optimised-rectangle area; corridor / core-racking sizes are the flow's baked values.",
  "hostKind": "space",
  "parameters": [
    { "key": "amenityOsRate", "label": "Amenity OS Rate", "kind": "number", "default": 0.1, "min": 0, "max": 1, "step": 0.01 },
    { "key": "losRate", "label": "LOS Rate", "kind": "number", "default": 0.15, "min": 0, "max": 1, "step": 0.01 },
    { "key": "basicFsi", "label": "Basic FSI", "kind": "number", "default": 1, "min": 0, "max": 5, "step": 0.1 },
    { "key": "premiumFsi", "label": "Premium FSI", "kind": "number", "default": 0.5, "min": 0, "max": 5, "step": 0.1 },
    { "key": "tdr", "label": "TDR FSI", "kind": "number", "default": 0.9, "min": 0, "max": 5, "step": 0.1 },
    { "key": "fung", "label": "Fungible Rate", "kind": "number", "default": 0.35, "min": 0, "max": 1, "step": 0.01 },
    { "key": "schemeFsi", "label": "Scheme FSI (m²)", "kind": "number", "default": 11721.6, "min": 0, "max": 50000, "step": 0.1 },
    { "key": "inSitu", "label": "In-Situ FSI", "kind": "number", "default": 2, "min": 0, "max": 5, "step": 0.1 },
    { "key": "carParks", "label": "Car Parks", "kind": "number", "default": 417, "min": 0, "max": 2000, "step": 1 },
    { "key": "areaPerCarPark", "label": "Area / Car Park", "kind": "number", "default": 30, "min": 0, "max": 100, "step": 1 },
    { "key": "otherNonFsi", "label": "Other Non-FSI", "kind": "number", "default": 6000, "min": 0, "max": 50000, "step": 1 },
    { "key": "wings", "label": "Wings / Cores", "kind": "number", "default": 4, "min": 1, "max": 20, "step": 1 },
    { "key": "podiumOffset", "label": "Podium Offset", "kind": "number", "default": 2.8, "min": 0, "max": 20, "step": 0.1 },
    { "key": "front", "label": "Front Setback", "kind": "number", "default": 10.8, "min": 0, "max": 30, "step": 0.1 },
    { "key": "remaining", "label": "Other Setback", "kind": "number", "default": 3.2, "min": 0, "max": 30, "step": 0.1 },
    { "key": "edgeIndex", "label": "Front Edge Index", "kind": "number", "default": 3, "min": 0, "max": 19, "step": 1 },
    { "key": "axisTilt", "label": "Axis Tilt", "kind": "number", "default": 99, "min": 0, "max": 360, "step": 1 },
    { "key": "rectangles", "label": "Rectangles", "kind": "number", "default": 1, "min": 1, "max": 10, "step": 1 },
    { "key": "splitAngle", "label": "Split Angle", "kind": "number", "default": 271, "min": 0, "max": 360, "step": 1 },
    { "key": "p_1_nnz6", "label": "Optimise Axis Tilt", "kind": "checkbox", "default": false },
    { "key": "p_1_k0gu", "label": "Floor Height", "kind": "number", "default": 3.2, "min": 0, "max": 10, "step": 0.1 }
  ],
  "geometry": {
    "vars": {
      "_doc": "FSI / BUA calculation chain — mirrors the flow's Math nodes (plot area = hostArea).",
      "amenityArea": "amenityOsRate * hostArea",
      "netPlot": "hostArea - amenityArea",
      "zonal": "netPlot * basicFsi",
      "premium": "netPlot * premiumFsi",
      "tdrBua": "netPlot * tdr",
      "premtdr": "premium + tdrBua",
      "premtdrscheme": "premtdr + schemeFsi",
      "totalexfung": "zonal + premtdrscheme",
      "fungzonal": "zonal * fung",
      "fungothers": "premtdrscheme * fung",
      "fungtotal": "fungzonal + fungothers",
      "fsiBua": "totalexfung + fungtotal",
      "parking": "carParks * areaPerCarPark",
      "nonFsiBua": "parking + otherNonFsi",
      "footprintEstimate": "netPlot * 0.5",
      "towerFloors": "max(1, ceil(fsiBua / max(1, footprintEstimate)))",
      "basementFloors": "max(1, ceil(nonFsiBua / max(1, netPlot)))"
    },
    "pipeline": [
      { "op": "host" },
      { "op": "inset", "params": { "mode": "front-remaining", "front": "front", "remaining": "remaining", "frontEdgeMode": "index", "frontEdgeIndex": "edgeIndex", "inside": true } },
      { "op": "outline" },
      { "op": "split", "params": { "mode": "target", "target": { "$expr": "amenityArea" }, "angle": "splitAngle", "keep": 1 } },
      { "op": "outline" },
      { "op": "optimise-rect", "params": { "shape": "rectangle", "count": "rectangles", "axisAngle": "axisTilt", "optimiseAxisTilt": "p_1_nnz6", "reference": "none" } },
      { "op": "outline" },
      { "op": "corridoor", "params": { "shape": "vertical", "width": 1.2, "offset": 0.5, "count": 3 } },
      { "op": "outline" },
      { "op": "core-racking", "params": { "length": 4, "breadth": 4, "gap": 18.2, "side": "both", "margin": 0, "orientation": "auto" } },
      { "op": "fill" },

      { "op": "host" },
      { "op": "inset", "params": { "mode": "front-remaining", "front": "front", "remaining": "remaining", "frontEdgeMode": "index", "frontEdgeIndex": "edgeIndex", "inside": true } },
      { "op": "split", "params": { "mode": "target", "target": { "$expr": "amenityArea" }, "angle": "splitAngle", "keep": 1 } },
      { "op": "optimise-rect", "params": { "shape": "rectangle", "count": "rectangles", "axisAngle": "axisTilt", "optimiseAxisTilt": "p_1_nnz6", "reference": "none" } },
      { "op": "floor-massing", "params": { "n": { "$expr": "towerFloors" }, "direction": "upward", "floorHeight": "p_1_k0gu" } },

      { "op": "host" },
      { "op": "inset", "params": { "mode": "front-remaining", "front": "front", "remaining": "remaining", "frontEdgeMode": "index", "frontEdgeIndex": "edgeIndex", "inside": true } },
      { "op": "split", "params": { "mode": "target", "target": { "$expr": "amenityArea" }, "angle": "splitAngle", "keep": 1 } },
      { "op": "optimise-rect", "params": { "shape": "rectangle", "count": "rectangles", "axisAngle": "axisTilt", "optimiseAxisTilt": "p_1_nnz6", "reference": "none" } },
      { "op": "inset", "params": { "mode": "equal", "uniformSetback": "podiumOffset", "inside": false } },
      { "op": "floor-massing", "params": { "n": { "$expr": "basementFloors" }, "direction": "downward", "floorHeight": "p_1_k0gu" } }
    ]
  },
  "outputs": [
    { "key": "amenityArea", "label": "Amenities Open Space Area", "expr": "amenityArea", "unit": "m²" },
    { "key": "netPlot", "label": "Net Plot Area", "expr": "netPlot", "unit": "m²" },
    { "key": "fsiBua", "label": "FSI BUA", "expr": "fsiBua", "unit": "m²" },
    { "key": "nonFsiBua", "label": "Non-FSI BUA", "expr": "nonFsiBua", "unit": "m²" },
    { "key": "totalBua", "label": "Total BUA Area", "expr": "fsiBua + nonFsiBua", "unit": "m²" },
    { "key": "towerFloors", "label": "Number of Floors", "expr": "towerFloors" },
    { "key": "basementFloors", "label": "Number of Basement Floors", "expr": "basementFloors" },
    { "key": "buildingHeight", "label": "Total Height of Building", "expr": "towerFloors * p_1_k0gu", "unit": "m" },
    { "key": "groundCoverage", "label": "Ground Coverage Ratio", "expr": "footprintEstimate / max(1, hostArea)" }
  ]
}
