{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "site-flow.v1",
    "name": "Site Flow",
    "category": "Architecture/Site",
    "units": "m",
    "icon": {
      "paths": [
        "M3 3h18v18H3V3zm2 2v14h14V5H5zm4 4h6v6H9V9z"
      ]
    }
  },
  "parameters": [
    {
      "key": "insetFront",
      "label": "Inset: Front",
      "kind": "number",
      "default": 6,
      "min": 0,
      "max": 50,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "insetSide",
      "label": "Inset: Side/Rear",
      "kind": "number",
      "default": 3,
      "min": 0,
      "max": 50,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "frontEdge",
      "label": "Front Edge Index",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "key": "splitAngle",
      "label": "Split Angle",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°"
    },
    {
      "key": "splitRatio",
      "label": "Split Ratio (Coverage)",
      "kind": "number",
      "default": 0.5,
      "min": 0.01,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "optShape",
      "label": "Optimise Shape",
      "kind": "select",
      "default": "rectangle",
      "options": [
        {
          "value": "rectangle",
          "label": "Rectangle"
        },
        {
          "value": "lshape",
          "label": "L-Shape"
        },
        {
          "value": "tshape",
          "label": "T-Shape"
        }
      ]
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#4d7c0f"
    }
  ],
  "hostKind": "space",
  "geometry": {
    "vars": {
      "targetArea": "hostArea * splitRatio"
    },
    "pipeline": [
      {
        "op": "host"
      },
      {
        "op": "inset",
        "params": {
          "mode": "front-remaining",
          "front": "insetFront",
          "remaining": "insetSide",
          "frontEdgeIndex": "frontEdge",
          "frontEdgeMode": "index",
          "inside": true
        }
      },
      {
        "op": "split",
        "params": {
          "mode": "target",
          "target": {
            "$expr": "targetArea"
          },
          "angle": "splitAngle",
          "keep": 0
        }
      },
      {
        "op": "optimise-rect",
        "params": {
          "shape": "optShape",
          "count": 1
        }
      },
      {
        "op": "fill"
      }
    ]
  }
}
