{
  "kind": "parametric-object",
  "version": 3,
  "meta": {
    "id": "core.v1",
    "name": "Core",
    "category": "Architecture/Core",
    "units": "m"
  },
  "description": "A SINGLE CORE shaft (flat 2D plan symbol — a `width × breadth` rectangle with an X shaft mark, no extrusion). Attach to a SPACE: it centres on the space's bounding-box centre (detached it centres on the anchor). In the corridor + cores recipe the REPEATED row of cores is drawn by `floor_plate.v1` (its coreCount / gap / axis / side params); use this object only to add one extra individual core to a space. Outputs: core area, aspect.",
  "parameters": [
    {
      "key": "width",
      "label": "Width",
      "kind": "number",
      "default": 3,
      "min": 1.5,
      "max": 12,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "breadth",
      "label": "Breadth",
      "kind": "number",
      "default": 5,
      "min": 1.5,
      "max": 12,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#64748b"
    }
  ],
  "geometry": {
    "vars": {
      "_doc": "Centred on the host bounding-box centre (0 without a host → anchor-centred). hw/hb = half extents.",
      "hasHost": "(hostW > 0 && hostH > 0) ? 1 : 0",
      "bcx": "hasHost ? (hostMinX + hostMaxX) / 2 : 0",
      "bcy": "hasHost ? (hostMinY + hostMaxY) / 2 : 0",
      "hw": "width / 2",
      "hb": "breadth / 2",
      "coreArea": "width * breadth",
      "aspect": "max(width, breadth) / min(width, breadth)"
    },
    "cases": [
      {
        "rules": [
          {
            "box": {
              "x0": "bcx - hw",
              "x1": "bcx + hw",
              "y0": "bcy - hb",
              "y1": "bcy + hb",
              "h0": 0,
              "h1": 0
            }
          },
          {
            "line": {
              "pts": [
                [
                  "bcx - hw",
                  "bcy - hb"
                ],
                [
                  "bcx + hw",
                  "bcy + hb"
                ]
              ],
              "h0": 0,
              "h1": 0
            }
          },
          {
            "line": {
              "pts": [
                [
                  "bcx - hw",
                  "bcy + hb"
                ],
                [
                  "bcx + hw",
                  "bcy - hb"
                ]
              ],
              "h0": 0,
              "h1": 0
            }
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "coreArea",
      "label": "Core Area",
      "expr": "coreArea",
      "unit": "m²"
    },
    {
      "key": "aspect",
      "label": "Aspect Ratio",
      "expr": "aspect"
    }
  ],
  "hostKind": "space"
}
