{
  "kind": "parametric-object",
  "version": 3,
  "meta": {
    "id": "circulation",
    "name": "Circulation",
    "category": "Site",
    "symbol": "massing",
    "units": "m"
  },
  "description": "Circulation — the Corridoor → Core Racking flow compiled into ONE object. Attach it to a Space: it cuts a corridor through the space (Corridoor) and racks fixed-size core Spaces flush along the corridor's sides (Core Racking). The corridor is drawn as a dashed reference; the cores are solid. Every operation is driven by the parameters below.",
  "parameters": [
    { "key": "shape", "label": "Corridor Shape", "kind": "select", "default": "horizontal", "options": [ { "value": "horizontal", "label": "Horizontal band" }, { "value": "vertical", "label": "Vertical band" }, { "value": "cross", "label": "Cross" }, { "value": "insetted", "label": "Insetted loop" }, { "value": "skeleton", "label": "Skeleton path" }, { "value": "bsp", "label": "BSP path" }, { "value": "split", "label": "Split path" } ] },
    { "key": "width", "label": "Corridor Width", "kind": "number", "default": 1.2, "min": 0.1, "max": 10, "step": 0.1, "unit": "m" },
    { "key": "offset", "label": "Corridor Inset Offset", "kind": "number", "default": 0.5, "min": 0, "max": 20, "step": 0.1, "unit": "m", "showWhen": "shape == 'insetted'" },
    { "key": "count", "label": "Corridor Cells", "kind": "number", "default": 3, "min": 2, "max": 12, "step": 1, "showWhen": "shape == 'skeleton' || shape == 'bsp' || shape == 'split'" },
    { "key": "length", "label": "Core Length", "kind": "number", "default": 2.4, "min": 0.5, "max": 20, "step": 0.1, "unit": "m" },
    { "key": "breadth", "label": "Core Breadth", "kind": "number", "default": 4, "min": 0.5, "max": 20, "step": 0.1, "unit": "m" },
    { "key": "gap", "label": "Core Gap", "kind": "number", "default": 0.5, "min": 0, "max": 10, "step": 0.1, "unit": "m" },
    { "key": "margin", "label": "Core End Margin", "kind": "number", "default": 0.4, "min": 0, "max": 10, "step": 0.1, "unit": "m" },
    { "key": "side", "label": "Core Side", "kind": "select", "default": "both", "options": [ { "value": "both", "label": "Both sides" }, { "value": "left", "label": "Left only" }, { "value": "right", "label": "Right only" } ] },
    { "key": "orientation", "label": "Core Orientation", "kind": "select", "default": "auto", "options": [ { "value": "auto", "label": "Auto (run axis)" }, { "value": "horizontal", "label": "Horizontal" }, { "value": "vertical", "label": "Vertical" } ] },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#7c3aed" }
  ],
  "geometry": {
    "vars": {
      "_doc": "Runs over the host footprint: corridoor carves the corridor, core-racking racks cores along its sides.",
      "plotArea": "hostArea"
    },
    "pipeline": [
      { "op": "host", "params": {} },
      { "op": "corridoor", "params": { "shape": "shape", "width": "width", "offset": "offset", "count": "count" } },
      { "op": "outline", "params": {} },
      { "op": "core-racking", "params": { "length": "length", "breadth": "breadth", "gap": "gap", "margin": "margin", "side": "side", "orientation": "orientation" } },
      { "op": "fill", "params": {} }
    ]
  },
  "outputs": [
    { "key": "plotArea", "label": "Plot Area", "expr": "plotArea", "unit": "m²" }
  ],
  "hostKind": "space"
}
