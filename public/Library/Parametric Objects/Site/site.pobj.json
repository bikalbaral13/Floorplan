{
  "kind": "parametric-object",
  "version": 3,
  "meta": {
    "id": "site",
    "name": "Site",
    "category": "Site",
    "symbol": "massing",
    "units": "m"
  },
  "description": "Site → Building Envelope, as ONE object (the site_to_building_envelope workflow compiled into a pipeline). Attach it to a plot Space: tick the operations you want — Apply Setback (inset), Split Plot, and Fit Rectangle (optimise-rect) — and each ticked op runs over the footprint. The setback polygon is drawn as a dashed reference; the final envelope is the solid footprint. Each operation's parameters only appear in Properties when its toggle is on.",
  "parameters": [
    { "key": "useInset", "label": "Apply Setback (Inset)", "kind": "checkbox", "default": true },
    { "key": "insetMode", "label": "Setback Mode", "kind": "select", "default": "front-remaining", "showWhen": "useInset", "options": [ { "value": "front-remaining", "label": "Front & sides/rear" }, { "value": "equal", "label": "Uniform" } ] },
    { "key": "setback", "label": "Uniform Setback", "kind": "number", "default": 3, "min": 0, "max": 30, "step": 0.5, "unit": "m", "showWhen": "useInset" },
    { "key": "frontSetback", "label": "Front Setback", "kind": "number", "default": 5, "min": 0, "max": 30, "step": 0.5, "unit": "m", "showWhen": "useInset" },
    { "key": "remainingSetback", "label": "Side / Rear Setback", "kind": "number", "default": 3, "min": 0, "max": 30, "step": 0.5, "unit": "m", "showWhen": "useInset" },
    { "key": "useSplit", "label": "Split Plot", "kind": "checkbox", "default": false },
    { "key": "splitTargetArea", "label": "Split First-Piece Area", "kind": "number", "default": 200, "min": 1, "max": 5000, "step": 1, "unit": "m²", "showWhen": "useSplit" },
    { "key": "splitAngle", "label": "Split Angle", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°", "showWhen": "useSplit" },
    { "key": "useOptimise", "label": "Fit Rectangle", "kind": "checkbox", "default": true },
    { "key": "rectShape", "label": "Envelope Shape", "kind": "select", "default": "rectangle", "showWhen": "useOptimise", "options": [ { "value": "rectangle", "label": "Rectangle" }, { "value": "square", "label": "Square" }, { "value": "lshape", "label": "L-shape" }, { "value": "tshape", "label": "T-shape" }, { "value": "cshape", "label": "C-shape" } ] },
    { "key": "rectCount", "label": "Rectangle Count", "kind": "number", "default": 1, "min": 1, "max": 20, "step": 1, "showWhen": "useOptimise" },
    { "key": "rectAxisAngle", "label": "Rectangle Axis Angle", "kind": "number", "default": 0, "min": 0, "max": 180, "step": 1, "unit": "°", "showWhen": "useOptimise" },
    { "key": "optimiseAxisTilt", "label": "Auto-optimise Tilt", "kind": "checkbox", "default": false, "showWhen": "useOptimise" },
    { "key": "useMassing", "label": "Extrude 3D Block", "kind": "checkbox", "default": false },
    { "key": "buildingHeight", "label": "Building Height", "kind": "number", "default": 12, "min": 3, "max": 300, "step": 1, "unit": "m", "showWhen": "useMassing" },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#4A90E2" }
  ],
  "geometry": {
    "vars": {
      "_doc": "plotArea = host footprint area (m²). The pipeline runs over the host footprint in local metres; each op is gated by its use* toggle.",
      "plotArea": "hostArea"
    },
    "pipeline": [
      { "op": "host", "params": {} },
      { "op": "inset", "when": "useInset", "params": { "mode": "insetMode", "inside": true, "uniformSetback": "setback", "front": "frontSetback", "remaining": "remainingSetback", "frontEdgeMode": "longest" } },
      { "op": "outline", "when": "useInset", "params": {} },
      { "op": "split", "when": "useSplit", "params": { "type": "normal", "mode": "target", "target": "splitTargetArea", "angle": "splitAngle", "count": 2, "keep": 0 } },
      { "op": "optimise-rect", "when": "useOptimise", "params": { "shape": "rectShape", "reference": "custom", "axisAngle": "rectAxisAngle", "optimiseAxisTilt": "optimiseAxisTilt", "count": "rectCount" } },
      { "op": "fill", "params": {} },
      { "op": "extrude", "when": "useMassing", "params": { "height": "buildingHeight" } }
    ]
  },
  "outputs": [
    { "key": "plotArea", "label": "Plot Area", "expr": "plotArea", "unit": "m²" }
  ],
  "hostKind": "space"
}
