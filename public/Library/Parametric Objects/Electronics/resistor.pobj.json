{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "resistor.v1",
    "name": "Resistor",
    "category": "Electronics/Components",
    "units": "m",
    "icon": { "paths": ["M2 12h4", "M18 12h4", "M6 9h12v6H6z", "M9.5 9v6", "M12 9v6", "M14.5 9v6"] }
  },
  "parameters": [
    { "key": "length", "label": "Body length", "kind": "number", "default": 0.24, "min": 0.06, "max": 0.8, "step": 0.01, "unit": "m" },
    { "key": "radius", "label": "Body radius", "kind": "number", "default": 0.055, "min": 0.02, "max": 0.2, "step": 0.005, "unit": "m" },
    { "key": "bands", "label": "Colour bands", "kind": "number", "default": 4, "min": 3, "max": 6, "step": 1 },
    { "key": "band1", "label": "Band 1", "kind": "color", "default": "#92400e" },
    { "key": "band2", "label": "Band 2", "kind": "color", "default": "#111827" },
    { "key": "band3", "label": "Band 3", "kind": "color", "default": "#b91c1c" },
    { "key": "band4", "label": "Band 4", "kind": "color", "default": "#d4a017" },
    { "key": "band5", "label": "Band 5", "kind": "color", "default": "#16a34a" },
    { "key": "band6", "label": "Band 6", "kind": "color", "default": "#8b5cf6" },
    { "key": "clearance", "label": "Height off floor", "kind": "number", "default": 0, "min": 0, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "deg" },
    { "key": "color", "label": "Body colour", "kind": "color", "default": "#e7d8b1" }
  ],
  "hostKind": "segment",
  "geometry": {
    "description": "Axial resistor lying along the host segment (local X): lead wire through, beige body with end bulges, and N colour bands — each band takes its own band1…band6 colour via the per-rule color expression. Attached to a wire segment it stretches to the segment length; radius and heights stay true.",
    "emit": "shapes",
    "vars": {
      "l2": "length / 2",
      "r": "radius",
      "bandW": "length * 0.06",
      "step": "length * 0.66 / max(1, bands - 1)"
    },
    "cases": [
      {
        "rules": [
          { "comment": "lead wire through the body", "box": { "x0": "-l2 * 1.5", "x1": "l2 * 1.5", "y0": "-r * 0.12", "y1": "r * 0.12", "h0": "r * 0.88", "h1": "r * 1.12" }, "color": "'#9ca3af'" },
          { "comment": "body (reserved color param = beige)", "box": { "x0": "-l2", "x1": "l2", "y0": "-r", "y1": "r", "h0": 0, "h1": "2 * r" } },
          {
            "comment": "end bulges",
            "repeat": "2",
            "as": "e",
            "vars": { "ex": "e == 0 ? -l2 + length * 0.09 : l2 - length * 0.09" },
            "box": { "x0": "ex - length * 0.09", "x1": "ex + length * 0.09", "y0": "-r * 1.12", "y1": "r * 1.12", "h0": 0, "h1": "2 * r * 1.06" }
          },
          {
            "comment": "colour bands — each ring reads its own band colour",
            "repeat": "bands",
            "as": "k",
            "vars": { "bx": "-l2 * 0.66 + k * step" },
            "box": { "x0": "bx - bandW / 2", "x1": "bx + bandW / 2", "y0": "-r * 1.06", "y1": "r * 1.06", "h0": 0, "h1": "2 * r * 1.03" },
            "color": "k == 0 ? band1 : k == 1 ? band2 : k == 2 ? band3 : k == 3 ? band4 : k == 4 ? band5 : band6"
          }
        ]
      }
    ]
  }
}
