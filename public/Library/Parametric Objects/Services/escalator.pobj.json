{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "escalator.v1",
    "name": "Escalator",
    "category": "Services/Vertical Circulation",
    "units": "m",
    "icon": { "paths": ["M4 18h4l8 -12h4", "M4 18l2 -3", "M8 13l2 -3", "M12 8l2 -3"] }
  },
  "parameters": [
    { "key": "run", "label": "Horizontal run", "kind": "number", "default": 4.5, "min": 2, "max": 12, "step": 0.1, "unit": "m" },
    { "key": "width", "label": "Width", "kind": "number", "default": 1.0, "min": 0.6, "max": 1.6, "step": 0.05, "unit": "m" },
    { "key": "rise", "label": "Total rise", "kind": "number", "default": 3.0, "min": 0.6, "max": 6, "step": 0.1, "unit": "m" },
    { "key": "steps", "label": "Steps", "kind": "number", "default": 16, "min": 4, "max": 40, "step": 1 },
    { "key": "direction", "label": "Direction", "kind": "select", "default": "up", "options": [ { "value": "up", "label": "Up (toward +X)" }, { "value": "down", "label": "Down (toward +X)" } ] },
    { "key": "balustradeHeight", "label": "Balustrade height", "kind": "number", "default": 0.95, "min": 0.5, "max": 1.4, "step": 0.05, "unit": "m" },
    { "key": "balustradeThick", "label": "Balustrade thickness", "kind": "number", "default": 0.12, "min": 0.05, "max": 0.3, "step": 0.01, "unit": "m" },
    { "key": "treadColor", "label": "Tread color", "kind": "color", "default": "#9ca3af" },
    { "key": "sideColor", "label": "Balustrade color", "kind": "color", "default": "#e5e7eb" },
    { "key": "railColor", "label": "Handrail color", "kind": "color", "default": "#1f2937" },
    { "key": "color", "label": "Base color", "kind": "color", "default": "#9ca3af" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 3, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "n": "max(2, round(steps))",
      "w2": "width / 2",
      "sl": "run / max(2, round(steps))",
      "bt": "balustradeThick"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Solid stepped incline (each tread rises one step)",
            "repeat": "n",
            "as": "k",
            "vars": { "kk": "direction == 'up' ? k : (n - 1 - k)", "z": "kk * rise / n" },
            "box": { "x0": "-run / 2 + k * sl", "x1": "-run / 2 + (k + 1) * sl", "y0": "-w2", "y1": "w2", "h0": "z", "h1": "z + rise / n * 1.05", "color": "treadColor" }
          },
          {
            "comment": "Left balustrade — stepped panel following the incline",
            "repeat": "n",
            "as": "k",
            "vars": { "kk": "direction == 'up' ? k : (n - 1 - k)", "z": "kk * rise / n" },
            "box": { "x0": "-run / 2 + k * sl", "x1": "-run / 2 + (k + 1) * sl", "y0": "w2", "y1": "w2 + bt", "h0": "z", "h1": "z + rise / n + balustradeHeight", "color": "sideColor" }
          },
          {
            "comment": "Right balustrade",
            "repeat": "n",
            "as": "k",
            "vars": { "kk": "direction == 'up' ? k : (n - 1 - k)", "z": "kk * rise / n" },
            "box": { "x0": "-run / 2 + k * sl", "x1": "-run / 2 + (k + 1) * sl", "y0": "-w2 - bt", "y1": "-w2", "h0": "z", "h1": "z + rise / n + balustradeHeight", "color": "sideColor" }
          },
          {
            "comment": "Left handrail cap",
            "repeat": "n",
            "as": "k",
            "vars": { "kk": "direction == 'up' ? k : (n - 1 - k)", "z": "kk * rise / n + rise / n + balustradeHeight" },
            "box": { "x0": "-run / 2 + k * sl", "x1": "-run / 2 + (k + 1) * sl", "y0": "w2 - 0.01", "y1": "w2 + bt + 0.02", "h0": "z", "h1": "z + 0.06", "color": "railColor" }
          },
          {
            "comment": "Right handrail cap",
            "repeat": "n",
            "as": "k",
            "vars": { "kk": "direction == 'up' ? k : (n - 1 - k)", "z": "kk * rise / n + rise / n + balustradeHeight" },
            "box": { "x0": "-run / 2 + k * sl", "x1": "-run / 2 + (k + 1) * sl", "y0": "-w2 - bt - 0.02", "y1": "-w2 + 0.01", "h0": "z", "h1": "z + 0.06", "color": "railColor" }
          }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "angle", "label": "Incline angle", "expr": "atan2(rise, run) * 180 / PI", "unit": "°" }
  ]
}
