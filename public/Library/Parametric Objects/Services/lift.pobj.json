{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "lift.v1",
    "name": "Lift / Elevator",
    "category": "Services/Vertical Circulation",
    "units": "m",
    "icon": { "paths": ["M5 3h14v18H5z", "M9 8l3 -3l3 3", "M9 16l3 3l3 -3"] }
  },
  "parameters": [
    { "key": "shaftWidth", "label": "Shaft width", "kind": "number", "default": 1.8, "min": 1, "max": 4, "step": 0.05, "unit": "m" },
    { "key": "shaftDepth", "label": "Shaft depth", "kind": "number", "default": 2.0, "min": 1, "max": 4, "step": 0.05, "unit": "m" },
    { "key": "wallThickness", "label": "Wall thickness", "kind": "number", "default": 0.2, "min": 0.1, "max": 0.4, "step": 0.02, "unit": "m" },
    { "key": "carHeight", "label": "Car height", "kind": "number", "default": 2.2, "min": 1.8, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "carClear", "label": "Car clearance", "kind": "number", "default": 0.06, "min": 0.02, "max": 0.2, "step": 0.01, "unit": "m" },
    { "key": "doorWidth", "label": "Door width", "kind": "number", "default": 0.9, "min": 0.6, "max": 1.6, "step": 0.05, "unit": "m" },
    { "key": "doorOpen", "label": "Door open", "kind": "number", "default": 0.3, "min": 0, "max": 1, "step": 0.05 },
    { "key": "shaftColor", "label": "Shaft color", "kind": "color", "default": "#6b7280" },
    { "key": "carColor", "label": "Car color", "kind": "color", "default": "#cbd5e1" },
    { "key": "doorColor", "label": "Door color", "kind": "color", "default": "#94a3b8" },
    { "key": "color", "label": "Base color", "kind": "color", "default": "#6b7280" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 3, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "sw2": "shaftWidth / 2",
      "sd2": "shaftDepth / 2",
      "wt": "wallThickness",
      "ch": "carHeight",
      "dw2": "doorWidth / 2",
      "carW2": "shaftWidth / 2 - wt - carClear",
      "carD2": "shaftDepth / 2 - carClear",
      "leaf": "doorWidth / 2 * (1 - doorOpen)",
      "slide": "doorWidth / 2 * doorOpen"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Back wall", "box": { "x0": "-sw2", "x1": "sw2", "y0": "sd2 - wt", "y1": "sd2", "h0": 0, "h1": "ch", "color": "shaftColor" } },
          { "comment": "Left wall", "box": { "x0": "-sw2", "x1": "-sw2 + wt", "y0": "-sd2", "y1": "sd2", "h0": 0, "h1": "ch", "color": "shaftColor" } },
          { "comment": "Right wall", "box": { "x0": "sw2 - wt", "x1": "sw2", "y0": "-sd2", "y1": "sd2", "h0": 0, "h1": "ch", "color": "shaftColor" } },
          { "comment": "Front pier — left", "box": { "x0": "-sw2", "x1": "-dw2", "y0": "-sd2", "y1": "-sd2 + wt", "h0": 0, "h1": "ch", "color": "shaftColor" } },
          { "comment": "Front pier — right", "box": { "x0": "dw2", "x1": "sw2", "y0": "-sd2", "y1": "-sd2 + wt", "h0": 0, "h1": "ch", "color": "shaftColor" } },
          { "comment": "Header above the door", "box": { "x0": "-dw2", "x1": "dw2", "y0": "-sd2", "y1": "-sd2 + wt", "h0": "ch - 0.25", "h1": "ch", "color": "shaftColor" } },
          { "comment": "Car cabin", "box": { "x0": "-carW2", "x1": "carW2", "y0": "-carD2 + wt", "y1": "carD2 - wt", "h0": 0, "h1": "ch * 0.97", "color": "carColor" } },
          { "comment": "Door leaf — left (slides toward -x)", "box": { "x0": "-dw2 - slide", "x1": "-dw2 + leaf - slide", "y0": "-sd2 + wt * 0.2", "y1": "-sd2 + wt * 0.6", "h0": 0, "h1": "ch - 0.25", "color": "doorColor" } },
          { "comment": "Door leaf — right (slides toward +x)", "box": { "x0": "dw2 - leaf + slide", "x1": "dw2 + slide", "y0": "-sd2 + wt * 0.2", "y1": "-sd2 + wt * 0.6", "h0": 0, "h1": "ch - 0.25", "color": "doorColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "carArea", "label": "Car area", "expr": "(shaftWidth - 2 * wallThickness) * (shaftDepth - wallThickness)", "unit": "m²" }
  ]
}
