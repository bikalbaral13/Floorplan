{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "stove.v2",
    "name": "Stove",
    "category": "Fixtures/Kitchen",
    "units": "m",
    "icon": {
      "paths": [
        "M5 7h14v14H5z",
        "M5 7V4h14v3",
        "M9.5 12m-1.8 0a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0 -3.6 0",
        "M14.5 12m-1.8 0a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0 -3.6 0",
        "M7 17h10"
      ]
    }
  },
  "parameters": [
    {
      "key": "width",
      "label": "Width",
      "kind": "number",
      "default": 0.6,
      "min": 0.5,
      "max": 0.9,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "depth",
      "label": "Depth",
      "kind": "number",
      "default": 0.6,
      "min": 0.5,
      "max": 0.7,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "height",
      "label": "Height",
      "kind": "number",
      "default": 0.9,
      "min": 0.8,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "burners",
      "label": "Burners",
      "kind": "number",
      "default": 4,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "key": "backguard",
      "label": "Backguard",
      "kind": "checkbox",
      "default": true
    },
    {
      "key": "wallOffset",
      "label": "Offset from Wall",
      "kind": "number",
      "default": 0,
      "min": -1,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#1f2937"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "description": "Freestanding cooking range: body + N burners on top (2-column grid) + oven-door handle (front -Y) + optional backguard (+Y).",
    "emit": "shapes",
    "vars": {
      "w2": "width / 2",
      "d2": "depth / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "body",
            "box": {
              "x0": "-w2",
              "x1": "w2",
              "y0": "-d2",
              "y1": "d2",
              "h0": 0,
              "h1": "height"
            }
          },
          {
            "comment": "burners (2-column grid on the hob)",
            "repeat": "burners",
            "as": "k",
            "vars": {
              "rows": "ceil(burners / 2)",
              "nx": "k % 2",
              "ny": "floor(k / 2)",
              "bx": "burners == 1 ? 0 : (nx * 2 - 1) * width * 0.22",
              "by": "rows == 1 ? 0 : (ny - (rows - 1) / 2) * depth * 0.36"
            },
            "circle": {
              "cx": "bx",
              "cy": "by",
              "r": "min(width, depth) * 0.14",
              "sides": 16,
              "h0": "height",
              "h1": "height + 0.015"
            }
          },
          {
            "comment": "oven-door handle",
            "box": {
              "x0": "-w2 + 0.04",
              "x1": "w2 - 0.04",
              "y0": "-d2 - 0.03",
              "y1": "-d2",
              "h0": "height * 0.6",
              "h1": "height * 0.64"
            }
          },
          {
            "comment": "backguard",
            "when": "backguard",
            "box": {
              "x0": "-w2",
              "x1": "w2",
              "y0": "d2 - 0.03",
              "y1": "d2",
              "h0": "height",
              "h1": "height + 0.12"
            }
          }
        ]
      }
    ]
  }
}
