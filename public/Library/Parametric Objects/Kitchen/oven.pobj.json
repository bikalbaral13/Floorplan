{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "oven.v1",
    "name": "Oven",
    "category": "Fixtures/Kitchen",
    "units": "m",
    "icon": {
      "paths": [
        "M4 5h16v14H4z",
        "M6 9h12v8H6z",
        "M7 6.5v1",
        "M10 6.5v1",
        "M13 6.5v1"
      ]
    }
  },
  "parameters": [
    {
      "key": "width",
      "label": "Width",
      "kind": "number",
      "default": 0.6,
      "min": 0.45,
      "max": 0.9,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "depth",
      "label": "Depth",
      "kind": "number",
      "default": 0.57,
      "min": 0.4,
      "max": 0.7,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "height",
      "label": "Height",
      "kind": "number",
      "default": 0.6,
      "min": 0.45,
      "max": 0.9,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Mounting height",
      "kind": "number",
      "default": 0.85,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "wallOffset",
      "label": "Offset from Wall",
      "kind": "number",
      "default": 0,
      "min": -1,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#334155"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "description": "Built-in oven: body + glass door + handle bar + control knobs. clearance = mounting height (0.85 for a tower unit, 0 for under-counter).",
    "emit": "shapes",
    "vars": {
      "w2": "width / 2",
      "d2": "depth / 2",
      "doorT": "0.03"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "body",
            "box": {
              "x0": "-w2",
              "x1": "w2",
              "y0": "-d2 + doorT",
              "y1": "d2",
              "h0": 0,
              "h1": "height"
            }
          },
          {
            "comment": "glass door panel",
            "box": {
              "x0": "-w2 + 0.02",
              "x1": "w2 - 0.02",
              "y0": "-d2",
              "y1": "-d2 + doorT",
              "h0": 0.05,
              "h1": "height - 0.14"
            }
          },
          {
            "comment": "handle bar",
            "box": {
              "x0": "-w2 + 0.04",
              "x1": "w2 - 0.04",
              "y0": "-d2 - 0.035",
              "y1": "-d2",
              "h0": "height - 0.1",
              "h1": "height - 0.065"
            }
          },
          {
            "comment": "control knobs along the top front",
            "repeat": "4",
            "as": "k",
            "vars": {
              "kx": "-w2 + 0.1 + k * ((width - 0.2) / 3)"
            },
            "circle": {
              "cx": "kx",
              "cy": "-d2 - 0.012",
              "r": 0.014,
              "sides": 12,
              "h0": "height - 0.05",
              "h1": "height - 0.02"
            }
          }
        ]
      }
    ]
  }
}
