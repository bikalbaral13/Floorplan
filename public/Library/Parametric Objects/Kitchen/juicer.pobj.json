          {
            "comment": "juice bowl",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "baseRadius * 0.92",
              "sides": 18,
              "h0": "baseH",
              "h1": "baseH + bowlH"
            }
          },
          {
            "comment": "feed chute",
            "circle": {
              "cx": 0,
              "cy": 0.015,
              "r": 0.032,
              "sides": 14,
              "h0": "baseH + bowlH",
              "h1": "height"
            }
          },
          {
            "comment": "pusher",
            "circle": {
              "cx": 0,
              "cy": 0.015,
              "r": 0.014,
              "sides": 10,
              "h0": "height",
              "h1": "height + 0.035"
            }
          },
          {
            "comment": "spout",
            "box": {
              "x0": -0.014,
              "x1": 0.014,
              "y0": "-baseRadius - 0.055",
              "y1": "-baseRadius + 0.005",
              "h0": "baseH + 0.02",
