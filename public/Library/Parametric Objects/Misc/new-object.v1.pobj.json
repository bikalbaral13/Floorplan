{
  "kind": "parametric-object",
  "version": 2,
  "decompile": "primitives",
  "meta": {
    "id": "new-object.v1",
    "name": "new_object",
    "category": "Custom",
    "units": "m"
  },
  "parameters": [
    {
      "key": "length",
      "label": "Length",
      "kind": "number",
      "default": 1.9,
      "min": 1.6,
      "max": 2.2,
      "step": 0.05
    },
    {
      "key": "width",
      "label": "Width",
      "kind": "number",
      "default": 0.9,
      "min": 0.9,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "mattressThickness",
      "label": "Mattress thickness",
      "kind": "number",
      "default": 0.2,
      "min": 0.1,
      "max": 0.4,
      "step": 0.01
    },
    {
      "key": "legHeight",
      "label": "Leg height",
      "kind": "number",
      "default": 0.35,
      "min": 0.1,
      "max": 0.5,
      "step": 0.01
    },
    {
      "key": "headboardHeight",
      "label": "Headboard height",
      "kind": "number",
      "default": 0.75,
      "min": 0,
      "max": 1.2,
      "step": 0.05
    },
    {
      "key": "frameThickness",
      "label": "Frame thickness",
      "kind": "number",
      "default": 0.08,
      "min": 0.05,
      "max": 0.25,
      "step": 0.01
    }
  ],
  "geometry": {
    "emit": "shapes",
    "vars": {
      "px": "0",
      "py": "0",
      "legX": "length/2 - 0.12 + px",
      "negLegX": "0.12 - length/2 + px",
      "legZ": "width/2 - 0.12 + py",
      "negLegZ": "0.12 - width/2 + py",
      "baseY": "legHeight",
      "mattY": "legHeight + frameThickness",
      "mattTopY": "legHeight + frameThickness + mattressThickness",
      "mattL": "length - 0.12",
      "mattW": "width - 0.12",
      "headX": "0 - length/2 - 0.03 + px",
      "headTotalH": "legHeight + frameThickness + mattressThickness + headboardHeight",
      "pillX": "0.45 - length/2 + px",
      "pillZ": "width/4 + py",
      "negPillZ": "0 - width/4 + py",
      "pillW": "width/2 - 0.15",
      "cx": "px",
      "cy": "py"
    },
    "cases": [
      {
        "rules": [
          {
            "box": {
              "x0": "cx - ((length)/2)",
              "x1": "cx + (length)/2",
              "y0": "cy - ((width)/2)",
              "y1": "cy + (width)/2",
              "h0": "baseY",
              "h1": "baseY + frameThickness"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "cx - ((mattL)/2)",
              "x1": "cx + (mattL)/2",
              "y0": "cy - ((mattW)/2)",
              "y1": "cy + (mattW)/2",
              "h0": "mattY",
              "h1": "mattY + mattressThickness"
            },
            "color": "'#e8e4da'"
          },
          {
            "box": {
              "x0": "headX - ((0.06)/2)",
              "x1": "headX + (0.06)/2",
              "y0": "cy - ((width)/2)",
              "y1": "cy + (width)/2",
              "h0": "0",
              "h1": "headTotalH"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "negLegX - ((0.08)/2)",
              "x1": "negLegX + (0.08)/2",
              "y0": "legZ - ((0.08)/2)",
              "y1": "legZ + (0.08)/2",
              "h0": "0",
              "h1": "legHeight"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "negLegX - ((0.08)/2)",
              "x1": "negLegX + (0.08)/2",
              "y0": "negLegZ - ((0.08)/2)",
              "y1": "negLegZ + (0.08)/2",
              "h0": "0",
              "h1": "legHeight"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "legX - ((0.08)/2)",
              "x1": "legX + (0.08)/2",
              "y0": "legZ - ((0.08)/2)",
              "y1": "legZ + (0.08)/2",
              "h0": "0",
              "h1": "legHeight"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "legX - ((0.08)/2)",
              "x1": "legX + (0.08)/2",
              "y0": "negLegZ - ((0.08)/2)",
              "y1": "negLegZ + (0.08)/2",
              "h0": "0",
              "h1": "legHeight"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "pillX - ((0.5)/2)",
              "x1": "pillX + (0.5)/2",
              "y0": "pillZ - ((pillW)/2)",
              "y1": "pillZ + (pillW)/2",
              "h0": "mattTopY",
              "h1": "mattTopY + 0.14"
            },
            "color": "'#e8e4da'"
          },
          {
            "box": {
              "x0": "pillX - ((0.5)/2)",
              "x1": "pillX + (0.5)/2",
              "y0": "negPillZ - ((pillW)/2)",
              "y1": "negPillZ + (pillW)/2",
              "h0": "mattTopY",
              "h1": "mattTopY + 0.14"
            },
            "color": "'#e8e4da'"
          },
          {
            "box": {
              "x0": "cx - ((length)/2)",
              "x1": "cx + (length)/2",
              "y0": "cy - ((width)/2)",
              "y1": "cy + (width)/2",
              "h0": "0",
              "h1": "0"
            },
            "color": "'#6b4f3a'"
          },
          {
            "box": {
              "x0": "cx - ((mattL)/2)",
              "x1": "cx + (mattL)/2",
              "y0": "cy - ((mattW)/2)",
              "y1": "cy + (mattW)/2",
              "h0": "0",
              "h1": "0"
            },
            "color": "'#e8e4da'"
          },
          {
            "box": {
              "x0": "pillX - ((0.5)/2)",
              "x1": "pillX + (0.5)/2",
              "y0": "pillZ - ((pillW)/2)",
              "y1": "pillZ + (pillW)/2",
              "h0": "0",
              "h1": "0"
            },
            "color": "'#e8e4da'"
          },
          {
            "box": {
              "x0": "pillX - ((0.5)/2)",
              "x1": "pillX + (0.5)/2",
              "y0": "negPillZ - ((pillW)/2)",
              "y1": "negPillZ + (pillW)/2",
              "h0": "0",
              "h1": "0"
            },
            "color": "'#e8e4da'"
          }
        ]
      }
    ]
  },
  "hostKind": "node"
}