{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "switch.v1",
    "name": "Switch Board",
    "category": "Fixtures/Electrical",
    "units": "m",
    "icon": {
      "paths": [
        "M7 5h10v14H7z",
        "M11 9h2v6h-2z",
        "M12 9v3"
      ]
    }
  },
  "parameters": [
    {
      "key": "gangs",
      "label": "Switches (gangs)",
      "kind": "number",
      "default": 2,
      "min": 1,
      "max": 8,
      "step": 1
    },
    {
      "key": "plateHeight",
      "label": "Plate height",
      "kind": "number",
      "default": 0.09,
      "min": 0.07,
      "max": 0.18,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "depth",
      "label": "Plate depth",
      "kind": "number",
      "default": 0.012,
      "min": 0.008,
      "max": 0.03,
      "step": 0.002,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Mounting height",
      "kind": "number",
      "default": 1.2,
      "min": 0,
      "max": 3,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#f1f5f9"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "description": "Wall switch board: plate width grows with the gang count; rockers proud of the plate face (-Y). clearance = mounting height off the floor.",
    "emit": "shapes",
    "vars": {
      "plateW": "max(0.075, gangs * 0.035 + 0.028)",
      "w2": "plateW / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "plate",
            "box": {
              "x0": "-w2",
              "x1": "w2",
              "y0": "-depth",
              "y1": 0,
              "h0": 0,
              "h1": "plateHeight"
            }
          },
          {
            "comment": "rockers",
            "repeat": "gangs",
            "as": "k",
            "vars": {
              "px": "(k - (gangs - 1) / 2) * 0.035"
            },
            "box": {
              "x0": "px - 0.0085",
              "x1": "px + 0.0085",
              "y0": "-depth - 0.005",
              "y1": "-depth",
              "h0": "plateHeight * 0.28",
              "h1": "plateHeight * 0.72"
            }
          }
        ]
      }
    ]
  }
}
