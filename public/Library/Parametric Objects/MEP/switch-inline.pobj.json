{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "switch.inline.v1",
    "name": "Switch (Inline)",
    "category": "Electrical/Circuit",
    "units": "m",
    "icon": {
      "paths": [
        "M6 11h2v2H6z",
        "M16 11h2v2h-2z",
        "M8 12l7-5",
        "M3 12h3",
        "M18 12h3"
      ]
    }
  },
  "parameters": [
    {
      "key": "width",
      "label": "Base length",
      "kind": "number",
      "default": 0.18,
      "min": 0.08,
      "max": 0.5,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "baseDepth",
      "label": "Base depth",
      "kind": "number",
      "default": 0.09,
      "min": 0.04,
      "max": 0.25,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "on",
      "label": "Closed (ON)",
      "kind": "checkbox",
      "default": false
    },
    {
      "key": "leverAngle",
      "label": "Open angle",
      "kind": "number",
      "default": 35,
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "clearance",
      "label": "Height off floor",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#475569"
    }
  ],
  "hostKind": "segment",
  "geometry": {
    "description": "Knife-style inline switch on the host segment: base plate + two terminal posts + a lever that swings open in plan by leverAngle when OFF (closed bar when ON) — the circuit state reads in 2D and 3D.",
    "emit": "shapes",
    "vars": {
      "w2": "width / 2",
      "d2": "baseDepth / 2",
      "postR": "min(0.016, baseDepth * 0.18)",
      "px": "-(w2 - postR * 2)",
      "qx": "w2 - postR * 2",
      "armLen": "qx - px",
      "ang": "(on ? 0 : leverAngle) * PI / 180",
      "tipX": "px + cos(ang) * armLen",
      "tipY": "sin(ang) * armLen",
      "hw": "postR * 0.55",
      "ox": "-sin(ang) * hw",
      "oy": "cos(ang) * hw"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "base plate",
            "box": {
              "x0": "-w2",
              "x1": "w2",
              "y0": "-d2",
              "y1": "d2",
              "h0": 0,
              "h1": 0.02
            }
          },
          {
            "comment": "pivot terminal post",
            "circle": {
              "cx": "px",
              "cy": 0,
              "r": "postR",
              "sides": 12,
              "h0": 0.02,
              "h1": 0.055
            }
          },
          {
            "comment": "contact terminal post",
            "circle": {
              "cx": "qx",
              "cy": 0,
              "r": "postR",
              "sides": 12,
              "h0": 0.02,
              "h1": 0.055
            }
          },
          {
            "comment": "lever arm — closed onto the contact when ON, swung open by leverAngle when OFF",
            "poly": {
              "pts": [
                [
                  "px + ox",
                  "oy"
                ],
                [
                  "tipX + ox",
                  "tipY + oy"
                ],
                [
                  "tipX - ox",
                  "tipY - oy"
                ],
                [
                  "px - ox",
                  "-oy"
                ]
              ],
              "h0": 0.04,
              "h1": 0.055
            }
          },
          {
            "comment": "lever knob at the tip",
            "circle": {
              "cx": "tipX",
              "cy": "tipY",
              "r": "hw * 1.6",
              "sides": 10,
              "h0": 0.04,
              "h1": 0.06
            }
          }
        ]
      }
    ]
  }
}
