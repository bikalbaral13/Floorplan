{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "db.v1",
    "name": "Distribution Board",
    "category": "MEP/Electrical",
    "units": "m",
    "icon": { "paths": ["M5 3h14v18H5z", "M8 7h3v3H8z", "M13 7h3v3h-3z", "M8 12h3v3H8z", "M13 12h3v3h-3z"] }
  },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 0.3, "min": 0.15, "max": 0.8, "step": 0.01, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 0.36, "min": 0.15, "max": 0.9, "step": 0.01, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 0.11, "min": 0.06, "max": 0.25, "step": 0.01, "unit": "m" },
    { "key": "rows", "label": "Breaker rows", "kind": "number", "default": 2, "min": 1, "max": 5, "step": 1 },
    { "key": "perRow", "label": "Breakers / row", "kind": "number", "default": 6, "min": 1, "max": 16, "step": 1 },
    { "key": "door", "label": "Show door frame", "kind": "checkbox", "default": true },
    { "key": "color", "label": "Enclosure color", "kind": "color", "default": "#e5e7eb" },
    { "key": "breakerColor", "label": "Breaker color", "kind": "color", "default": "#1f2937" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Mount height", "kind": "number", "default": 1.5, "min": 0, "max": 2.5, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "w2": "width / 2", "d2": "depth / 2", "H": "height",
      "nr": "max(1, round(rows))", "nc": "max(1, round(perRow))",
      "innerW": "width * 0.8", "innerH": "height * 0.75",
      "bw": "width * 0.8 / max(1, round(perRow))",
      "bh": "height * 0.75 / max(1, round(rows))"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Enclosure box", "box": { "x0": "-w2", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": 0, "h1": "H", "color": "color" } },
          { "comment": "Front recessed panel", "box": { "x0": "-innerW / 2", "x1": "innerW / 2", "y0": "d2 - 0.015", "y1": "d2", "h0": "H * 0.12", "h1": "H * 0.88", "color": "'#cbd5e1'" } },
          {
            "comment": "Breaker grid on the front face",
            "repeat": "nr * nc",
            "as": "k",
            "vars": { "col": "k % nc", "row": "floor(k / nc)", "bx": "-innerW / 2 + (col + 0.5) * bw", "bz": "H * 0.12 + (row + 0.5) * bh" },
            "box": { "x0": "bx - bw * 0.35", "x1": "bx + bw * 0.35", "y0": "d2", "y1": "d2 + 0.008", "h0": "bz - bh * 0.3", "h1": "bz + bh * 0.3", "color": "breakerColor" }
          },
          { "comment": "Door frame border", "when": "door", "box": { "x0": "-w2", "x1": "-w2 + 0.02", "y0": "d2 - 0.01", "y1": "d2 + 0.01", "h0": 0, "h1": "H", "color": "breakerColor" } }
        ]
      }
    ]
  },
  "outputs": [ { "key": "ways", "label": "Ways", "expr": "round(rows) * round(perRow)" } ]
}
