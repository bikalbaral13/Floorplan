{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "chandelier.v1",
    "name": "Chandelier",
    "category": "Fixtures/Lighting",
    "icon": {
      "paths": [
        "M12 2v20M2 12h20M5 5l14 14M5 19L19 5"
      ]
    }
  },
  "parameters": [
    {
      "key": "radius",
      "label": "Radius",
      "kind": "number",
      "default": 0.5,
      "min": 0.1,
      "max": 2,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "arms",
      "label": "Arms",
      "kind": "number",
      "default": 6,
      "min": 3,
      "max": 12,
      "step": 1
    },
    {
      "key": "height",
      "label": "Fixture Height",
      "kind": "number",
      "default": 0.4,
      "min": 0.1,
      "max": 2,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "rodLength",
      "label": "Rod Length",
      "kind": "number",
      "default": 0.4,
      "min": 0,
      "max": 3,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Clearance (Height)",
      "kind": "number",
      "default": 2.4,
      "min": 0,
      "max": 10,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#fbbf24"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "hubR": "0.06",
      "lightR": "0.04",
      "armH": "height / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Central Rod",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": 0.015,
              "h0": "height",
              "h1": "height + rodLength"
            }
          },
          {
            "comment": "Central Hub",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "hubR",
              "h0": "armH - 0.05",
              "h1": "armH + 0.05"
            }
          },
          {
            "comment": "Arms and Lights",
            "repeat": "arms",
            "as": "k",
            "vars": {
              "angle": "k * 360 / arms",
              "rad": "angle * PI / 180",
              "x": "cos(rad) * radius",
              "y": "sin(rad) * radius"
            },
            "rules": [
              {
                "line": {
                  "pts": [
                    [
                      0,
                      0
                    ],
                    [
                      "x",
                      "y"
                    ]
                  ]
                }
              },
              {
                "circle": {
                  "cx": "x",
                  "cy": "y",
                  "r": "lightR",
                  "h0": "armH",
                  "h1": "armH + 0.2"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
