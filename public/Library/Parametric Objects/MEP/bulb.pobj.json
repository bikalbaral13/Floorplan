{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "bulb.v1",
    "name": "Light Bulb",
    "category": "Electrical/Circuit",
    "units": "m",
    "icon": {
      "paths": [
        "M12 3a6 6 0 0 1 4 10c-1 1-1.5 2-1.5 3h-5C9.5 15 9 14 8 13a6 6 0 0 1 4-10z",
        "M10 19h4",
        "M10.5 21h3"
      ]
    }
  },
  "parameters": [
    {
      "key": "radius",
      "label": "Globe radius",
      "kind": "number",
      "default": 0.09,
      "min": 0.04,
      "max": 0.3,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "baseHeight",
      "label": "Screw-base height",
      "kind": "number",
      "default": 0.07,
      "min": 0.03,
      "max": 0.15,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Mounting height",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 4,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#f59e0b"
    }
  ],
  "hostKind": "node",
  "geometry": {
    "description": "Light bulb standing base-down: screw base + stacked globe cylinders (rounded silhouette in 3D) + the classic crossed-filament symbol in plan. clearance = mounting height (0 = on the plan, e.g. 2.6 for a ceiling point).",
    "emit": "shapes",
    "vars": {
      "r": "radius",
      "bh": "baseHeight"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "screw base",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "r * 0.38",
              "sides": 14,
              "h0": 0,
              "h1": "bh"
            }
          },
          {
            "comment": "neck",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "r * 0.62",
              "sides": 16,
              "h0": "bh",
              "h1": "bh + r * 0.45"
            }
          },
          {
            "comment": "globe",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "r",
              "sides": 20,
              "h0": "bh + r * 0.45",
              "h1": "bh + r * 1.5"
            }
          },
          {
            "comment": "crown",
            "circle": {
              "cx": 0,
              "cy": 0,
              "r": "r * 0.6",
              "sides": 16,
              "h0": "bh + r * 1.5",
              "h1": "bh + r * 1.8"
            }
          },
          {
            "comment": "plan filament symbol (cross)",
            "line": {
              "pts": [
                [
                  "-r * 0.55",
                  "-r * 0.55"
                ],
                [
                  "r * 0.55",
                  "r * 0.55"
                ]
              ]
            }
          },
          {
            "comment": "plan filament symbol (cross)",
            "line": {
              "pts": [
                [
                  "-r * 0.55",
                  "r * 0.55"
                ],
                [
                  "r * 0.55",
                  "-r * 0.55"
                ]
              ]
            }
          }
        ]
      }
    ]
  }
}
