{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "wire.v1",
    "name": "Wire",
    "category": "Electrical/Circuit",
    "units": "m",
    "icon": {
      "paths": [
        "M3 16h8V8h10",
        "M3 16a1.5 1.5 0 1 0 .01 0"
      ]
    }
  },
  "parameters": [
    {
      "key": "length",
      "label": "Length",
      "kind": "number",
      "default": 1,
      "min": 0.05,
      "max": 20,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "gauge",
      "label": "Gauge (thickness)",
      "kind": "number",
      "default": 0.015,
      "min": 0.005,
      "max": 0.06,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "routeHeight",
      "label": "Routing height",
      "kind": "number",
      "default": 0.02,
      "min": 0,
      "max": 3,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#2563eb"
    }
  ],
  "hostKind": "segment",
  "geometry": {
    "description": "Conductor along the host segment (local X): a thin square-section run at routing height. Attached to a drawn segment it stretches to the segment length — the drawn line IS the wire; gauge and height stay true.",
    "emit": "shapes",
    "vars": {
      "l2": "length / 2",
      "g2": "gauge / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "conductor run",
            "box": {
              "x0": "-l2",
              "x1": "l2",
              "y0": "-g2",
              "y1": "g2",
              "h0": "routeHeight",
              "h1": "routeHeight + gauge"
            }
          }
        ]
      }
    ]
  }
}
