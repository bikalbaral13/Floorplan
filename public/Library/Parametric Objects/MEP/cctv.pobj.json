{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "cctv.v1",
    "name": "CCTV Camera",
    "category": "MEP/Security",
    "units": "m",
    "icon": { "paths": ["M3 7l14 -4l2 6l-14 4z", "M5 13v4h4", "M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"] }
  },
  "parameters": [
    { "key": "style", "label": "Type", "kind": "select", "default": "dome", "options": [ { "value": "dome", "label": "Dome" }, { "value": "bullet", "label": "Bullet" } ] },
    { "key": "bodyDia", "label": "Body diameter", "kind": "number", "default": 0.12, "min": 0.05, "max": 0.3, "step": 0.005, "unit": "m" },
    { "key": "bulletLen", "label": "Bullet length", "kind": "number", "default": 0.18, "min": 0.08, "max": 0.4, "step": 0.01, "unit": "m" },
    { "key": "sides", "label": "Roundness", "kind": "number", "default": 20, "min": 6, "max": 36, "step": 1 },
    { "key": "color", "label": "Body color", "kind": "color", "default": "#e5e7eb" },
    { "key": "lensColor", "label": "Lens color", "kind": "color", "default": "#0f172a" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Mount height", "kind": "number", "default": 2.6, "min": 0, "max": 4, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": { "R": "bodyDia / 2", "nsides": "max(6, round(sides))", "domeH": "bodyDia * 0.42" },
    "cases": [
      {
        "rules": [
          { "comment": "Dome base plate", "when": "style == 'dome'", "circle": { "cx": 0, "cy": 0, "r": "R * 1.1", "sides": "nsides", "h0": 0, "h1": 0.025, "color": "color" } },
          {
            "comment": "Dome bubble — stacked shrinking rings",
            "when": "style == 'dome'",
            "repeat": 3,
            "as": "k",
            "vars": { "t": "(k + 0.5) / 3", "rr": "R * sqrt(max(0.04, 1 - t * t))" },
            "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "0.025 + k / 3 * domeH", "h1": "0.025 + (k + 1) / 3 * domeH", "color": "color" }
          },
          { "comment": "Dome lens", "when": "style == 'dome'", "circle": { "cx": 0, "cy": "R * 0.2", "r": "R * 0.35", "sides": 12, "h0": 0.01, "h1": 0.026, "color": "lensColor" } },
          { "comment": "Bullet mount bracket", "when": "style == 'bullet'", "box": { "x0": "-0.02", "x1": "0.02", "y0": "-R - 0.02", "y1": "-R + 0.02", "h0": 0, "h1": 0.12, "color": "color" } },
          { "comment": "Bullet arm", "when": "style == 'bullet'", "box": { "x0": "-0.012", "x1": "0.012", "y0": "-R", "y1": "0.02", "h0": "0.1", "h1": "0.12", "color": "color" } },
          { "comment": "Bullet body", "when": "style == 'bullet'", "circle": { "cx": 0, "cy": "bulletLen / 2", "r": "R", "sides": "nsides", "h0": "0.12", "h1": "0.12 + bodyDia", "color": "color" } },
          { "comment": "Bullet body barrel", "when": "style == 'bullet'", "box": { "x0": "-R", "x1": "R", "y0": "0", "y1": "bulletLen", "h0": "0.12", "h1": "0.12 + bodyDia", "color": "color" } },
          { "comment": "Bullet lens", "when": "style == 'bullet'", "circle": { "cx": 0, "cy": "bulletLen", "r": "R * 0.7", "sides": 12, "h0": "0.13", "h1": "0.13 + bodyDia * 0.8", "color": "lensColor" } }
        ]
      }
    ]
  },
  "outputs": [ { "key": "mount", "label": "Mount height", "expr": "clearance", "unit": "m" } ]
}
