{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "battery.cell.v1",
    "name": "Dry Cell (Battery)",
    "category": "Electrical/Circuit",
    "units": "m",
    "icon": {
      "paths": [
        "M4 10h14v4H4z",
        "M18 11h2v2h-2z",
        "M7 10v4"
      ]
    }
  },
  "parameters": [
    {
      "key": "length",
      "label": "Length",
      "kind": "number",
      "default": 0.35,
      "min": 0.1,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "diameter",
      "label": "Diameter",
      "kind": "number",
      "default": 0.12,
      "min": 0.04,
      "max": 0.3,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Height off floor",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "deg"
    },
    {
      "key": "color",
      "label": "Color",
      "kind": "color",
      "default": "#1e293b"
    }
  ],
  "hostKind": "segment",
  "geometry": {
    "description": "Dry cell lying along the host segment (local X): body + negative end cap + positive terminal nub. Attached to a segment it stretches to the segment length; depth and heights stay true.",
    "emit": "shapes",
    "vars": {
      "l2": "length / 2",
      "d2": "diameter / 2",
      "capW": "length * 0.12",
      "nubW": "length * 0.06"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "cell body",
            "box": {
              "x0": "-l2 + capW",
              "x1": "l2 - nubW",
              "y0": "-d2",
              "y1": "d2",
              "h0": 0,
              "h1": "diameter"
            }
          },
          {
            "comment": "negative end cap (slightly proud)",
            "box": {
              "x0": "-l2",
              "x1": "-l2 + capW",
              "y0": "-d2 * 1.08",
              "y1": "d2 * 1.08",
              "h0": 0,
              "h1": "diameter * 1.05"
            }
          },
          {
            "comment": "positive terminal nub",
            "box": {
              "x0": "l2 - nubW",
              "x1": "l2",
              "y0": "-d2 * 0.35",
              "y1": "d2 * 0.35",
              "h0": "diameter * 0.3",
              "h1": "diameter * 0.7"
            }
          },
          {
            "comment": "plan polarity mark: + at the nub end",
            "line": {
              "pts": [
                [
                  "l2 - nubW * 2.6",
                  "-d2 * 0.45"
                ],
                [
                  "l2 - nubW * 2.6",
                  "d2 * 0.45"
                ]
              ]
            }
          },
          {
            "comment": "plan polarity mark (cross bar)",
            "line": {
              "pts": [
                [
                  "l2 - nubW * 3.4",
                  0
                ],
                [
                  "l2 - nubW * 1.8",
                  0
                ]
              ]
            }
          }
        ]
      }
    ]
  }
}
