{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "ac.v1",
    "name": "Split AC (Indoor)",
    "category": "MEP/HVAC",
    "units": "m",
    "icon": { "paths": ["M3 8h18v6H3z", "M6 14v2", "M12 14v2", "M18 14v2", "M6 11h12"] }
  },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 0.9, "min": 0.5, "max": 1.6, "step": 0.02, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 0.3, "min": 0.2, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 0.2, "min": 0.12, "max": 0.35, "step": 0.01, "unit": "m" },
    { "key": "louvers", "label": "Louver blades", "kind": "number", "default": 3, "min": 1, "max": 6, "step": 1 },
    { "key": "louverTilt", "label": "Louver drop", "kind": "number", "default": 0.03, "min": 0, "max": 0.1, "step": 0.005, "unit": "m" },
    { "key": "color", "label": "Body color", "kind": "color", "default": "#f8fafc" },
    { "key": "ventColor", "label": "Vent color", "kind": "color", "default": "#334155" },
    { "key": "accentColor", "label": "Accent color", "kind": "color", "default": "#3b82f6" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Mount height", "kind": "number", "default": 2.1, "min": 0, "max": 3, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": { "w2": "width / 2", "d2": "depth / 2", "H": "height", "vw": "width * 0.92", "nl": "max(1, round(louvers))" },
    "cases": [
      {
        "rules": [
          { "comment": "Body shell", "box": { "x0": "-w2", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": 0, "h1": "H", "color": "color" } },
          { "comment": "Front air outlet recess", "box": { "x0": "-vw / 2", "x1": "vw / 2", "y0": "d2 - 0.03", "y1": "d2", "h0": 0, "h1": "H * 0.34", "color": "ventColor" } },
          {
            "comment": "Louver blades in the outlet",
            "repeat": "nl",
            "as": "k",
            "vars": { "z": "H * 0.06 + k * (H * 0.28) / nl" },
            "box": { "x0": "-vw / 2", "x1": "vw / 2", "y0": "d2 - 0.01", "y1": "d2 + louverTilt", "h0": "z", "h1": "z + 0.015", "color": "color" }
          },
          { "comment": "Accent stripe", "box": { "x0": "-w2", "x1": "w2", "y0": "d2 - 0.005", "y1": "d2 + 0.005", "h0": "H - 0.02", "h1": "H", "color": "accentColor" } },
          { "comment": "Status display", "box": { "x0": "w2 - 0.14", "x1": "w2 - 0.04", "y0": "d2 - 0.005", "y1": "d2 + 0.008", "h0": "H * 0.45", "h1": "H * 0.62", "color": "accentColor" } }
        ]
      }
    ]
  },
  "outputs": [ { "key": "widthOut", "label": "Unit width", "expr": "width", "unit": "m" } ]
}
