{
  "kind": "parametric-object",
  "version": 2,
  "meta": {
    "id": "toilet.v1",
    "name": "Toilet",
    "category": "Fixtures/Bathroom",
    "units": "m",
    "icon": {
      "paths": [
        "M8 4h8v4H8z",
        "M9 8c-1 3-1 7 3 7s4-4 3-7",
        "M12 15v4",
        "M9 19h6"
      ]
    }
  },
  "hostKind": "node",
  "description": "Parametric WC / water-closet. `type` switches the cistern style — two-piece close-coupled (tank bolted on the bowl), one-piece (fused, lower tank), wall-hung (floating bowl + a concealed tank shown as a wall flush-plate), or corner (triangular tank for a 45° corner). `bowl` toggles an elongated vs round-front pan. All sizes are real fixture ranges: bowl width 0.32–0.42 m, overall depth 0.58–0.84 m (round ~0.69, elongated ~0.79), tank 0.36–0.56 m wide × 0.12–0.26 m deep, cistern top 0.64–0.95 m, seat/rim height 0.36–0.38 m standard or 0.43–0.48 m 'comfort/ADA'. `lidClosed` drops the lid (else the open pan shows its rim opening). Footprint frame: +Y is the wall/tank side, −Y the front; X is width. Drives the 2D plan and the 3D mesh from the same parameters.",
  "parameters": [
    {
      "key": "type",
      "label": "Type",
      "kind": "select",
      "default": "two-piece",
      "options": [
        {
          "value": "two-piece",
          "label": "Two-piece (close-coupled)"
        },
        {
          "value": "one-piece",
          "label": "One-piece"
        },
        {
          "value": "wall-hung",
          "label": "Wall-hung"
        },
        {
          "value": "corner",
          "label": "Corner"
        }
      ]
    },
    {
      "key": "bowl",
      "label": "Bowl shape",
      "kind": "select",
      "default": "elongated",
      "options": [
        {
          "value": "elongated",
          "label": "Elongated"
        },
        {
          "value": "round",
          "label": "Round-front"
        }
      ]
    },
    {
      "key": "bowlWidth",
      "label": "Bowl width",
      "kind": "number",
      "default": 0.37,
      "min": 0.32,
      "max": 0.42,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "depth",
      "label": "Overall depth",
      "kind": "number",
      "default": 0.72,
      "min": 0.58,
      "max": 0.84,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "tankWidth",
      "label": "Tank width",
      "kind": "number",
      "default": 0.46,
      "min": 0.36,
      "max": 0.56,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "tankDepth",
      "label": "Tank depth",
      "kind": "number",
      "default": 0.18,
      "min": 0.12,
      "max": 0.26,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "tankHeight",
      "label": "Cistern height",
      "kind": "number",
      "default": 0.79,
      "min": 0.64,
      "max": 0.95,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "seatHeight",
      "label": "Seat (rim) height",
      "kind": "number",
      "default": 0.4,
      "min": 0.36,
      "max": 0.5,
      "step": 0.005,
      "unit": "m"
    },
    {
      "key": "lidClosed",
      "label": "Lid closed",
      "kind": "checkbox",
      "default": false
    },
    {
      "key": "wallOffset",
      "label": "Offset from Wall",
      "kind": "number",
      "default": 0,
      "min": -2,
      "max": 2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "clearance",
      "label": "Clearance from Floor",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "kind": "number",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°"
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#cbd5e1"
    }
  ],
  "geometry": {
    "description": "Bowl pan (elliptical 12-gon) extruded floor→seat (or floating for wall-hung) + seat opening / lid + a type-dependent cistern (box, fused box, corner triangle, or wall flush-plate).",
    "vars": {
      "BW": "bowlWidth",
      "D": "depth",
      "TW": "tankWidth",
      "TD": "tankDepth",
      "TH": "tankHeight",
      "SH": "seatHeight",
      "yb": "D/2",
      "yf": "-D/2",
      "tf": "yb - TD",
      "wallhung": "type == 'wall-hung' ? 1 : 0",
      "isRound": "bowl == 'round' ? 1 : 0",
      "bback": "wallhung ? (yb - 0.03) : tf",
      "bcy": "(yf + bback) / 2",
      "brx": "BW / 2",
      "bry": "((bback - yf) / 2) * (isRound ? 0.9 : 1)",
      "lrx": "brx * 0.96",
      "lry": "bry * 0.96",
      "irx": "brx * 0.56",
      "iry": "bry * 0.56",
      "tbase": "type == 'one-piece' ? (SH - 0.12) : (SH - 0.03)"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "bowl pan — floor pedestal, or a floating mass for wall-hung",
            "poly": {
              "h0": "wallhung ? (SH - 0.22) : 0",
              "h1": "SH",
              "pts": [
                [
                  "brx",
                  "bcy"
                ],
                [
                  "0.866*brx",
                  "bcy + 0.5*bry"
                ],
                [
                  "0.5*brx",
                  "bcy + 0.866*bry"
                ],
                [
                  "0",
                  "bcy + bry"
                ],
                [
                  "-0.5*brx",
                  "bcy + 0.866*bry"
                ],
                [
                  "-0.866*brx",
                  "bcy + 0.5*bry"
                ],
                [
                  "-brx",
                  "bcy"
                ],
                [
                  "-0.866*brx",
                  "bcy - 0.5*bry"
                ],
                [
                  "-0.5*brx",
                  "bcy - 0.866*bry"
                ],
                [
                  "0",
                  "bcy - bry"
                ],
                [
                  "0.5*brx",
                  "bcy - 0.866*bry"
                ],
                [
                  "0.866*brx",
                  "bcy - 0.5*bry"
                ]
              ]
            }
          },
          {
            "comment": "open pan — rim opening (2D ring, flat)",
            "when": "!lidClosed",
            "poly": {
              "h0": "SH",
              "h1": "SH",
              "pts": [
                [
                  "irx",
                  "bcy"
                ],
                [
                  "0.707*irx",
                  "bcy + 0.707*iry"
                ],
                [
                  "0",
                  "bcy + iry"
                ],
                [
                  "-0.707*irx",
                  "bcy + 0.707*iry"
                ],
                [
                  "-irx",
                  "bcy"
                ],
                [
                  "-0.707*irx",
                  "bcy - 0.707*iry"
                ],
                [
                  "0",
                  "bcy - iry"
                ],
                [
                  "0.707*irx",
                  "bcy - 0.707*iry"
                ]
              ]
            }
          },
          {
            "comment": "closed lid — domed slab on the seat",
            "when": "lidClosed",
            "poly": {
              "h0": "SH",
              "h1": "SH + 0.05",
              "pts": [
                [
                  "lrx",
                  "bcy"
                ],
                [
                  "0.866*lrx",
                  "bcy + 0.5*lry"
                ],
                [
                  "0.5*lrx",
                  "bcy + 0.866*lry"
                ],
                [
                  "0",
                  "bcy + lry"
                ],
                [
                  "-0.5*lrx",
                  "bcy + 0.866*lry"
                ],
                [
                  "-0.866*lrx",
                  "bcy + 0.5*lry"
                ],
                [
                  "-lrx",
                  "bcy"
                ],
                [
                  "-0.866*lrx",
                  "bcy - 0.5*lry"
                ],
                [
                  "-0.5*lrx",
                  "bcy - 0.866*lry"
                ],
                [
                  "0",
                  "bcy - lry"
                ],
                [
                  "0.5*lrx",
                  "bcy - 0.866*lry"
                ],
                [
                  "0.866*lrx",
                  "bcy - 0.5*lry"
                ]
              ]
            }
          },
          {
            "comment": "cistern — close-coupled / one-piece (one-piece sits lower)",
            "when": "type == 'two-piece' || type == 'one-piece'",
            "box": {
              "x0": "-TW/2",
              "x1": "TW/2",
              "y0": "tf",
              "y1": "yb",
              "h0": "tbase",
              "h1": "TH"
            }
          },
          {
            "comment": "flush button on the cistern lid",
            "when": "type == 'two-piece' || type == 'one-piece'",
            "box": {
              "x0": "-0.045",
              "x1": "0.045",
              "y0": "yb - TD*0.65",
              "y1": "yb - TD*0.35",
              "h0": "TH",
              "h1": "TH + 0.012"
            }
          },
          {
            "comment": "corner cistern — triangular tank pointing into the corner (+Y)",
            "when": "type == 'corner'",
            "poly": {
              "h0": "tbase",
              "h1": "TH",
              "pts": [
                [
                  "0",
                  "yb"
                ],
                [
                  "TW/2",
                  "yb - TD*1.8"
                ],
                [
                  "-TW/2",
                  "yb - TD*1.8"
                ]
              ]
            }
          },
          {
            "comment": "wall-hung — concealed cistern shown as a wall flush-plate",
            "when": "type == 'wall-hung'",
            "box": {
              "x0": "-0.11",
              "x1": "0.11",
              "y0": "yb - 0.02",
              "y1": "yb",
              "h0": "SH + 0.12",
              "h1": "SH + 0.40"
            }
          }
        ]
      }
    ]
  }
}
