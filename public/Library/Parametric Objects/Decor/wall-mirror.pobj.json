{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "wall-mirror.v1",
    "name": "Mirror",
    "category": "Decor/Wall",
    "units": "m",
    "icon": { "paths": ["M6 3h12v18H6z", "M9 6l6 12", "M9 12l4 6"] }
  },
  "parameters": [
    { "key": "mount", "label": "Mount", "kind": "select", "default": "wall", "options": [ { "value": "wall", "label": "Wall-hung" }, { "value": "floor", "label": "Floor (full-length)" } ] },
    { "key": "width", "label": "Width", "kind": "number", "default": 0.6, "min": 0.15, "max": 2, "step": 0.01, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 0.9, "min": 0.2, "max": 2.2, "step": 0.01, "unit": "m" },
    { "key": "depth", "label": "Depth (protrusion)", "kind": "number", "default": 0.05, "min": 0.02, "max": 0.25, "step": 0.005, "unit": "m" },
    { "key": "frameWidth", "label": "Frame width", "kind": "number", "default": 0.05, "min": 0, "max": 0.25, "step": 0.005, "unit": "m" },
    { "key": "mountHeight", "label": "Wall mount height (bottom)", "kind": "number", "default": 0.9, "min": 0, "max": 2, "step": 0.05, "unit": "m" },
    { "key": "frameColor", "label": "Frame color", "kind": "color", "default": "#111827" },
    { "key": "color", "label": "Glass color", "kind": "color", "default": "#cbd5e1" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 2, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "w2": "width / 2",
      "d2": "depth / 2",
      "fw": "min(frameWidth, min(width, height) / 2 - 0.005)",
      "innerX": "w2 - fw",
      "lift": "mount == 'wall' ? mountHeight : 0",
      "hTop": "lift + height",
      "hInnerTop": "lift + height - fw",
      "hInnerBot": "lift + fw",
      "frontY0": "d2 - min(0.012, depth * 0.35)",
      "footW": "min(0.06, width * 0.12)"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Frame — bottom rail", "when": "fw > 0", "box": { "x0": "-w2", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": "lift", "h1": "hInnerBot", "color": "frameColor" } },
          { "comment": "Frame — top rail", "when": "fw > 0", "box": { "x0": "-w2", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": "hInnerTop", "h1": "hTop", "color": "frameColor" } },
          { "comment": "Frame — left rail", "when": "fw > 0", "box": { "x0": "-w2", "x1": "-innerX", "y0": "-d2", "y1": "d2", "h0": "hInnerBot", "h1": "hInnerTop", "color": "frameColor" } },
          { "comment": "Frame — right rail", "when": "fw > 0", "box": { "x0": "innerX", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": "hInnerBot", "h1": "hInnerTop", "color": "frameColor" } },
          { "comment": "Backing board", "box": { "x0": "-innerX", "x1": "innerX", "y0": "-d2", "y1": "frontY0", "h0": "hInnerBot", "h1": "hInnerTop", "color": "frameColor" } },
          { "comment": "Mirror glass on the front face", "box": { "x0": "-innerX", "x1": "innerX", "y0": "frontY0", "y1": "d2", "h0": "hInnerBot", "h1": "hInnerTop", "color": "color" } },
          { "comment": "Floor stand — left foot", "when": "mount == 'floor'", "box": { "x0": "-w2", "x1": "-w2 + footW", "y0": "-d2 - 0.12", "y1": "d2 + 0.02", "h0": 0, "h1": 0.03, "color": "frameColor" } },
          { "comment": "Floor stand — right foot", "when": "mount == 'floor'", "box": { "x0": "w2 - footW", "x1": "w2", "y0": "-d2 - 0.12", "y1": "d2 + 0.02", "h0": 0, "h1": 0.03, "color": "frameColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "area", "label": "Mirror area", "expr": "width * height", "unit": "m²" }
  ]
}
