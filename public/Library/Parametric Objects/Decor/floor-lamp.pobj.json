{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "floor-lamp.v1",
    "name": "Floor Lamp",
    "category": "Decor/Lighting",
    "units": "m",
    "icon": { "paths": ["M9 4h6l1 6h-8z", "M12 10v9", "M8 21h8"] }
  },
  "parameters": [
    { "key": "baseDia", "label": "Base diameter", "kind": "number", "default": 0.32, "min": 0.15, "max": 0.7, "step": 0.01, "unit": "m" },
    { "key": "baseHeight", "label": "Base height", "kind": "number", "default": 0.04, "min": 0.01, "max": 0.2, "step": 0.005, "unit": "m" },
    { "key": "poleDia", "label": "Pole diameter", "kind": "number", "default": 0.04, "min": 0.01, "max": 0.12, "step": 0.005, "unit": "m" },
    { "key": "poleHeight", "label": "Pole height", "kind": "number", "default": 1.35, "min": 0.4, "max": 2, "step": 0.05, "unit": "m" },
    { "key": "shadeStyle", "label": "Shade style", "kind": "select", "default": "drum", "options": [ { "value": "drum", "label": "Drum" }, { "value": "cone", "label": "Cone (empire)" }, { "value": "cylinder", "label": "Cylinder" } ] },
    { "key": "shadeBottomDia", "label": "Shade bottom Ø", "kind": "number", "default": 0.44, "min": 0.15, "max": 0.9, "step": 0.01, "unit": "m" },
    { "key": "shadeTopDia", "label": "Shade top Ø", "kind": "number", "default": 0.34, "min": 0.1, "max": 0.9, "step": 0.01, "unit": "m" },
    { "key": "shadeHeight", "label": "Shade height", "kind": "number", "default": 0.28, "min": 0.1, "max": 0.6, "step": 0.01, "unit": "m" },
    { "key": "shadeRings", "label": "Shade facets", "kind": "number", "default": 5, "min": 1, "max": 12, "step": 1 },
    { "key": "sides", "label": "Roundness", "kind": "number", "default": 24, "min": 3, "max": 48, "step": 1 },
    { "key": "baseColor", "label": "Base / pole color", "kind": "color", "default": "#334155" },
    { "key": "color", "label": "Shade color", "kind": "color", "default": "#fde68a" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 3, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "botR": "shadeBottomDia / 2",
      "topR": "shadeStyle == 'cylinder' ? shadeBottomDia / 2 : shadeTopDia / 2",
      "poleTop": "baseHeight + poleHeight",
      "shadeBase": "poleTop - shadeHeight * 0.35",
      "rings": "max(1, round(shadeRings))",
      "nsides": "max(3, round(sides))"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Weighted base disc", "circle": { "cx": 0, "cy": 0, "r": "baseDia / 2", "sides": "nsides", "h0": 0, "h1": "baseHeight", "color": "baseColor" } },
          { "comment": "Base collar", "circle": { "cx": 0, "cy": 0, "r": "poleDia * 1.6", "sides": "nsides", "h0": "baseHeight", "h1": "baseHeight + 0.03", "color": "baseColor" } },
          { "comment": "Pole", "circle": { "cx": 0, "cy": 0, "r": "poleDia / 2", "sides": 12, "h0": "baseHeight", "h1": "poleTop", "color": "baseColor" } },
          {
            "comment": "Shade — stacked facet rings tapering bottom Ø → top Ø over the shade height",
            "repeat": "rings",
            "as": "k",
            "vars": { "rr": "botR + (topR - botR) * (rings <= 1 ? 0.5 : k / (rings - 1))" },
            "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "shadeBase + k / rings * shadeHeight", "h1": "shadeBase + (k + 1) / rings * shadeHeight" }
          }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "totalHeight", "label": "Total height", "expr": "baseHeight + poleHeight + shadeHeight * 0.65", "unit": "m" }
  ]
}
