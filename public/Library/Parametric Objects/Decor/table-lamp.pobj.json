{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "table-lamp.v1",
    "name": "Table Lamp",
    "category": "Decor/Lighting",
    "units": "m",
    "icon": { "paths": ["M8 4h8l1 5h-10z", "M12 9v8", "M9 20h6"] }
  },
  "parameters": [
    { "key": "baseDia", "label": "Base diameter", "kind": "number", "default": 0.16, "min": 0.08, "max": 0.4, "step": 0.01, "unit": "m" },
    { "key": "baseHeight", "label": "Base height", "kind": "number", "default": 0.03, "min": 0.01, "max": 0.15, "step": 0.005, "unit": "m" },
    { "key": "bodyStyle", "label": "Body style", "kind": "select", "default": "urn", "options": [ { "value": "urn", "label": "Urn (curved)" }, { "value": "stick", "label": "Slim stick" } ] },
    { "key": "bodyDia", "label": "Body diameter", "kind": "number", "default": 0.12, "min": 0.03, "max": 0.35, "step": 0.01, "unit": "m" },
    { "key": "neckHeight", "label": "Body / neck height", "kind": "number", "default": 0.28, "min": 0.08, "max": 0.6, "step": 0.01, "unit": "m" },
    { "key": "shadeBottomDia", "label": "Shade bottom Ø", "kind": "number", "default": 0.26, "min": 0.1, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "shadeTopDia", "label": "Shade top Ø", "kind": "number", "default": 0.2, "min": 0.08, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "shadeHeight", "label": "Shade height", "kind": "number", "default": 0.18, "min": 0.06, "max": 0.4, "step": 0.01, "unit": "m" },
    { "key": "shadeRings", "label": "Shade facets", "kind": "number", "default": 4, "min": 1, "max": 10, "step": 1 },
    { "key": "sides", "label": "Roundness", "kind": "number", "default": 20, "min": 3, "max": 40, "step": 1 },
    { "key": "baseColor", "label": "Base / body color", "kind": "color", "default": "#1e293b" },
    { "key": "color", "label": "Shade color", "kind": "color", "default": "#fef3c7" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Sit height (on table)", "kind": "number", "default": 0, "min": 0, "max": 1.2, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "botR": "shadeBottomDia / 2",
      "topR": "shadeTopDia / 2",
      "bodyTop": "baseHeight + neckHeight",
      "rings": "max(1, round(shadeRings))",
      "bodyRings": "bodyStyle == 'urn' ? 5 : 1",
      "nsides": "max(3, round(sides))"
    },
    "cases": [
      {
        "rules": [
          { "comment": "Base", "circle": { "cx": 0, "cy": 0, "r": "baseDia / 2", "sides": "nsides", "h0": 0, "h1": "baseHeight", "color": "baseColor" } },
          {
            "comment": "Body — urn profile (bulge in the middle) or a slim stick",
            "repeat": "bodyRings",
            "as": "k",
            "vars": { "t": "(k + 0.5) / bodyRings", "prof": "bodyStyle == 'urn' ? (0.45 + 0.55 * sqrt(max(0.02, 1 - pow(2 * t - 1, 2)))) : 0.3" },
            "circle": { "cx": 0, "cy": 0, "r": "bodyDia / 2 * prof", "sides": "nsides", "h0": "baseHeight + k / bodyRings * neckHeight", "h1": "baseHeight + (k + 1) / bodyRings * neckHeight", "color": "baseColor" }
          },
          {
            "comment": "Shade — tapered stacked rings",
            "repeat": "rings",
            "as": "k",
            "vars": { "rr": "botR + (topR - botR) * (rings <= 1 ? 0.5 : k / (rings - 1))" },
            "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "bodyTop + k / rings * shadeHeight", "h1": "bodyTop + (k + 1) / rings * shadeHeight" }
          }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "totalHeight", "label": "Total height", "expr": "baseHeight + neckHeight + shadeHeight", "unit": "m" }
  ]
}
