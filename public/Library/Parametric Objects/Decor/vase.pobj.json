{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "vase.v1",
    "name": "Vase",
    "category": "Decor/Accessories",
    "units": "m",
    "icon": { "paths": ["M9 3h6l-1 3c2 2 2 6 0 9c-1 2 -3 2 -4 0c-2 -3 -2 -7 0 -9z"] }
  },
  "parameters": [
    { "key": "baseDia", "label": "Base Ø", "kind": "number", "default": 0.12, "min": 0.04, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "bellyDia", "label": "Belly Ø", "kind": "number", "default": 0.2, "min": 0.05, "max": 0.7, "step": 0.01, "unit": "m" },
    { "key": "neckDia", "label": "Neck Ø", "kind": "number", "default": 0.09, "min": 0.03, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "mouthDia", "label": "Mouth Ø", "kind": "number", "default": 0.14, "min": 0.03, "max": 0.6, "step": 0.01, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 0.34, "min": 0.1, "max": 1.2, "step": 0.01, "unit": "m" },
    { "key": "rings", "label": "Profile facets", "kind": "number", "default": 8, "min": 3, "max": 20, "step": 1 },
    { "key": "sides", "label": "Roundness", "kind": "number", "default": 24, "min": 3, "max": 48, "step": 1 },
    { "key": "flowers", "label": "Add flowers", "kind": "checkbox", "default": true },
    { "key": "flowerCount", "label": "Flower count", "kind": "number", "default": 5, "min": 1, "max": 14, "step": 1 },
    { "key": "flowerHeight", "label": "Flower height", "kind": "number", "default": 0.3, "min": 0.05, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "bloomDia", "label": "Bloom Ø", "kind": "number", "default": 0.06, "min": 0.02, "max": 0.2, "step": 0.005, "unit": "m" },
    { "key": "color", "label": "Vase color", "kind": "color", "default": "#0ea5e9" },
    { "key": "stemColor", "label": "Stem color", "kind": "color", "default": "#15803d" },
    { "key": "bloomColor", "label": "Bloom color", "kind": "color", "default": "#e11d48" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Sit height", "kind": "number", "default": 0, "min": 0, "max": 1.2, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "baseR": "baseDia / 2",
      "bellyR": "bellyDia / 2",
      "neckR": "neckDia / 2",
      "mouthR": "mouthDia / 2",
      "nrings": "max(3, round(rings))",
      "nsides": "max(3, round(sides))",
      "nfl": "max(1, round(flowerCount))",
      "mouthTop": "height",
      "flAng": "2 * PI / nfl"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Vase vessel — stacked rings interpolated base → belly → neck → mouth",
            "repeat": "nrings",
            "as": "k",
            "vars": {
              "t": "k / (nrings - 1)",
              "rr": "t < 0.35 ? baseR + (bellyR - baseR) * (t / 0.35) : t < 0.75 ? bellyR + (neckR - bellyR) * ((t - 0.35) / 0.4) : neckR + (mouthR - neckR) * ((t - 0.75) / 0.25)"
            },
            "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "k / nrings * height", "h1": "(k + 1) / nrings * height" }
          },
          {
            "comment": "Flower stems rising out of the mouth",
            "when": "flowers",
            "repeat": "nfl",
            "as": "k",
            "vars": { "a": "k * flAng", "rad": "mouthR * 0.55", "sx": "cos(a) * rad", "sy": "sin(a) * rad" },
            "circle": { "cx": "sx", "cy": "sy", "r": 0.006, "sides": 6, "h0": "mouthTop", "h1": "mouthTop + flowerHeight", "color": "stemColor" }
          },
          {
            "comment": "Blooms at the stem tips",
            "when": "flowers",
            "repeat": "nfl",
            "as": "k",
            "vars": { "a": "k * flAng", "rad": "mouthR * 0.55", "sx": "cos(a) * rad", "sy": "sin(a) * rad" },
            "circle": { "cx": "sx", "cy": "sy", "r": "bloomDia / 2", "sides": 10, "h0": "mouthTop + flowerHeight", "h1": "mouthTop + flowerHeight + bloomDia * 0.5", "color": "bloomColor" }
          }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "totalHeight", "label": "Total height", "expr": "flowers ? height + flowerHeight + bloomDia : height", "unit": "m" }
  ]
}
