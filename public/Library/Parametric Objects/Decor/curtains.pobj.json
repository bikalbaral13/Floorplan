{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "curtains.v1",
    "name": "Curtains",
    "category": "Decor/Window",
    "units": "m",
    "icon": { "paths": ["M3 3h18", "M6 3v18l1 -2l1 2l1 -2l1 2V3", "M14 3v18l1 -2l1 2l1 -2l1 2V3"] }
  },
  "parameters": [
    { "key": "width", "label": "Track width", "kind": "number", "default": 1.6, "min": 0.4, "max": 5, "step": 0.05, "unit": "m" },
    { "key": "drop", "label": "Drop (height)", "kind": "number", "default": 2.1, "min": 0.3, "max": 3.5, "step": 0.05, "unit": "m" },
    { "key": "foldDepth", "label": "Fold depth", "kind": "number", "default": 0.09, "min": 0.02, "max": 0.3, "step": 0.01, "unit": "m" },
    { "key": "folds", "label": "Total pleats", "kind": "number", "default": 12, "min": 4, "max": 30, "step": 1 },
    { "key": "fabric", "label": "Fabric thickness", "kind": "number", "default": 0.03, "min": 0.01, "max": 0.1, "step": 0.005, "unit": "m" },
    { "key": "centerGap", "label": "Centre gap", "kind": "number", "default": 0.04, "min": 0, "max": 0.6, "step": 0.02, "unit": "m" },
    { "key": "openFrac", "label": "Open (0 closed → 1 open)", "kind": "number", "default": 0, "min": 0, "max": 1, "step": 0.05 },
    { "key": "rodDia", "label": "Rod diameter", "kind": "number", "default": 0.03, "min": 0.01, "max": 0.08, "step": 0.005, "unit": "m" },
    { "key": "rodExtend", "label": "Rod overhang", "kind": "number", "default": 0.1, "min": 0, "max": 0.4, "step": 0.02, "unit": "m" },
    { "key": "color", "label": "Fabric color", "kind": "color", "default": "#9f1239" },
    { "key": "rodColor", "label": "Rod color", "kind": "color", "default": "#1f2937" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Hem height", "kind": "number", "default": 0.08, "min": 0, "max": 1, "step": 0.02, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "w2": "width / 2",
      "gap2": "centerGap / 2",
      "panelFull": "max(0.05, w2 - gap2)",
      "panelW": "panelFull * (1 - openFrac * 0.65)",
      "nf": "max(2, round(folds / 2))",
      "stepL": "panelW / nf",
      "amp": "foldDepth / 2",
      "thick": "fabric",
      "top": "drop",
      "rodR": "rodDia / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Curtain rod (thin bar across the top with overhangs)",
            "box": { "x0": "-w2 - rodExtend", "x1": "w2 + rodExtend", "y0": "-rodR", "y1": "rodR", "h0": "top", "h1": "top + rodDia", "color": "rodColor" }
          },
          { "comment": "Rod finial — left", "box": { "x0": "-w2 - rodExtend - rodDia", "x1": "-w2 - rodExtend", "y0": "-rodDia", "y1": "rodDia", "h0": "top - rodR", "h1": "top + rodDia * 1.5", "color": "rodColor" } },
          { "comment": "Rod finial — right", "box": { "x0": "w2 + rodExtend", "x1": "w2 + rodExtend + rodDia", "y0": "-rodDia", "y1": "rodDia", "h0": "top - rodR", "h1": "top + rodDia * 1.5", "color": "rodColor" } },
          {
            "comment": "Left panel — pleated zigzag ribbon from the left edge inward",
            "repeat": "nf",
            "as": "k",
            "vars": {
              "x0": "-w2 + k * stepL",
              "x1": "-w2 + (k + 1) * stepL",
              "yA": "amp * (k % 2 == 0 ? 1 : -1)",
              "yB": "amp * ((k + 1) % 2 == 0 ? 1 : -1)"
            },
            "poly": { "pts": [ [ "x0", "yA" ], [ "x1", "yB" ], [ "x1", "yB - thick" ], [ "x0", "yA - thick" ] ], "h0": 0, "h1": "top" }
          },
          {
            "comment": "Right panel — pleated zigzag ribbon from the right edge inward",
            "repeat": "nf",
            "as": "k",
            "vars": {
              "x0": "w2 - k * stepL",
              "x1": "w2 - (k + 1) * stepL",
              "yA": "amp * (k % 2 == 0 ? 1 : -1)",
              "yB": "amp * ((k + 1) % 2 == 0 ? 1 : -1)"
            },
            "poly": { "pts": [ [ "x0", "yA" ], [ "x1", "yB" ], [ "x1", "yB - thick" ], [ "x0", "yA - thick" ] ], "h0": 0, "h1": "top" }
          }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "coverage", "label": "Covered width", "expr": "2 * panelW + centerGap", "unit": "m" }
  ]
}
