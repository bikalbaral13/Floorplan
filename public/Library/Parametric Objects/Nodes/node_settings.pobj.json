{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "node-settings",
    "name": "Node Settings",
    "category": "Defaults",
    "symbol": "settings"
  },
  "hostKind": "node",
  "parameters": [
    { "key": "showLabel", "label": "Show Label", "kind": "checkbox", "default": true, "role": "show-label" },
    { "key": "shape", "label": "Shape", "kind": "select", "default": "dot", "role": "shape",
      "options": [
        { "value": "dot", "label": "Dot" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" },
        { "value": "triangle", "label": "Triangle" }
      ] },
    { "key": "style", "label": "Style", "kind": "select", "default": "solid", "role": "style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ] },
    { "key": "color", "label": "Colour", "kind": "color", "default": "#334155", "role": "color" },
    { "key": "size", "label": "Size", "kind": "number", "default": 1.0, "min": 0.5, "max": 5, "step": 0.5, "role": "size" },
    { "key": "hatch", "label": "Use Hatch", "kind": "checkbox", "default": false, "role": "hatch" },
    { "key": "hatchStyle", "label": "Hatch Style", "kind": "select", "default": "diagonal", "role": "hatch-style",
      "options": [
        { "value": "diagonal", "label": "Diagonal" },
        { "value": "dots", "label": "Random Dots" }
      ] },
    { "key": "hatchSpacing", "label": "Spacing (px)", "kind": "number", "default": 8, "min": 2, "step": 1, "role": "hatch-spacing" },
    { "key": "hatchWeight", "label": "Weight", "kind": "number", "default": 1, "min": 0.5, "step": 0.5, "role": "hatch-weight" }
  ]
}
