{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "storage-shelves.v1",
    "name": "Storage Shelves",
    "category": "Utility/Storage",
    "units": "m",
    "icon": { "paths": ["M4 3h16v18H4z", "M4 8h16", "M4 13h16", "M4 18h16"] }
  },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 0.9, "min": 0.3, "max": 2.4, "step": 0.05, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 0.4, "min": 0.2, "max": 0.8, "step": 0.02, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 1.8, "min": 0.6, "max": 2.4, "step": 0.05, "unit": "m" },
    { "key": "shelves", "label": "Shelves", "kind": "number", "default": 4, "min": 2, "max": 8, "step": 1 },
    { "key": "postWidth", "label": "Post width", "kind": "number", "default": 0.05, "min": 0.02, "max": 0.12, "step": 0.005, "unit": "m" },
    { "key": "shelfThickness", "label": "Shelf thickness", "kind": "number", "default": 0.03, "min": 0.015, "max": 0.06, "step": 0.005, "unit": "m" },
    { "key": "backPanel", "label": "Back panel", "kind": "checkbox", "default": false },
    { "key": "color", "label": "Shelf color", "kind": "color", "default": "#94a3b8" },
    { "key": "postColor", "label": "Frame color", "kind": "color", "default": "#475569" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset from wall", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 1, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "w2": "width / 2", "d2": "depth / 2", "H": "height",
      "pw": "postWidth",
      "ns": "max(2, round(shelves))"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Four corner posts",
            "repeat": 4,
            "as": "k",
            "vars": { "px": "(k == 0 || k == 3 ? 1 : -1) * (w2 - pw / 2)", "py": "(k < 2 ? 1 : -1) * (d2 - pw / 2)" },
            "box": { "x0": "px - pw / 2", "x1": "px + pw / 2", "y0": "py - pw / 2", "y1": "py + pw / 2", "h0": 0, "h1": "H", "color": "postColor" }
          },
          {
            "comment": "Shelf boards, evenly spaced (bottom to top)",
            "repeat": "ns",
            "as": "k",
            "vars": { "z": "k * (H - shelfThickness) / (ns - 1)" },
            "box": { "x0": "-w2", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": "z", "h1": "z + shelfThickness", "color": "color" }
          },
          { "comment": "Back panel", "when": "backPanel", "box": { "x0": "-w2", "x1": "w2", "y0": "d2 - 0.012", "y1": "d2", "h0": 0, "h1": "H", "color": "postColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "totalShelf", "label": "Total shelf length", "expr": "round(shelves) * width", "unit": "m" }
  ]
}
