{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "ironing-board.v1",
    "name": "Ironing Board",
    "category": "Utility/Laundry",
    "units": "m",
    "icon": { "paths": ["M3 7h14l3 -2", "M3 7l0 2h12z", "M7 9l-2 10", "M11 9l2 10"] }
  },
  "parameters": [
    { "key": "length", "label": "Board length", "kind": "number", "default": 1.2, "min": 0.7, "max": 1.6, "step": 0.05, "unit": "m" },
    { "key": "wideEnd", "label": "Wide end width", "kind": "number", "default": 0.38, "min": 0.25, "max": 0.6, "step": 0.02, "unit": "m" },
    { "key": "narrowEnd", "label": "Narrow end width", "kind": "number", "default": 0.18, "min": 0.08, "max": 0.4, "step": 0.02, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 0.85, "min": 0.6, "max": 1, "step": 0.02, "unit": "m" },
    { "key": "boardThickness", "label": "Board thickness", "kind": "number", "default": 0.03, "min": 0.015, "max": 0.06, "step": 0.005, "unit": "m" },
    { "key": "legSpread", "label": "Leg spread", "kind": "number", "default": 0.32, "min": 0.15, "max": 0.6, "step": 0.02, "unit": "m" },
    { "key": "legWidth", "label": "Leg width", "kind": "number", "default": 0.03, "min": 0.015, "max": 0.06, "step": 0.005, "unit": "m" },
    { "key": "color", "label": "Board color", "kind": "color", "default": "#e5e7eb" },
    { "key": "legColor", "label": "Leg color", "kind": "color", "default": "#6b7280" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 1, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "L": "length",
      "we2": "wideEnd / 2",
      "ne2": "narrowEnd / 2",
      "topZ0": "max(0, height - boardThickness)",
      "lw2": "legWidth / 2",
      "ls2": "legSpread / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Tapered board with a pointed nose (wide at -x, narrow point at +x)",
            "poly": {
              "pts": [
                [ "-L / 2", "-we2" ], [ "L / 2 - 0.12", "-ne2" ], [ "L / 2", 0 ], [ "L / 2 - 0.12", "ne2" ], [ "-L / 2", "we2" ]
              ],
              "h0": "topZ0", "h1": "height", "color": "color"
            }
          },
          {
            "comment": "Splayed legs (4, forming the support)",
            "repeat": 4,
            "as": "k",
            "vars": { "lx": "(k == 0 || k == 3 ? -1 : 1) * (L * 0.22)", "ly": "(k < 2 ? 1 : -1) * ls2" },
            "box": { "x0": "lx - lw2", "x1": "lx + lw2", "y0": "ly - lw2", "y1": "ly + lw2", "h0": 0, "h1": "topZ0", "color": "legColor" }
          },
          { "comment": "Leg cross-brace", "box": { "x0": "-L * 0.24", "x1": "L * 0.24", "y0": "-lw2", "y1": "lw2", "h0": "topZ0 * 0.4", "h1": "topZ0 * 0.4 + legWidth", "color": "legColor" } }
        ]
      }
    ]
  },
  "outputs": [ { "key": "boardLen", "label": "Board length", "expr": "length", "unit": "m" } ]
}
