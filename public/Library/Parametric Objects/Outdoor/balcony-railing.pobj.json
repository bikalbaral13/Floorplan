{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "balcony-railing.v1",
    "name": "Balcony Railing",
    "category": "Outdoor/Railing",
    "units": "m",
    "icon": { "paths": ["M3 6h18", "M3 18h18", "M5 6v12", "M9 6v12", "M13 6v12", "M17 6v12"] }
  },
  "parameters": [
    { "key": "length", "label": "Length", "kind": "number", "default": 2.4, "min": 0.5, "max": 8, "step": 0.05, "unit": "m" },
    { "key": "height", "label": "Height", "kind": "number", "default": 1.0, "min": 0.6, "max": 1.5, "step": 0.05, "unit": "m" },
    { "key": "infill", "label": "Infill", "kind": "select", "default": "vertical", "options": [ { "value": "vertical", "label": "Vertical bars" }, { "value": "horizontal", "label": "Horizontal rails" }, { "value": "glass", "label": "Glass panel" } ] },
    { "key": "postSpacing", "label": "Post spacing", "kind": "number", "default": 1.1, "min": 0.4, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "postWidth", "label": "Post width", "kind": "number", "default": 0.05, "min": 0.02, "max": 0.15, "step": 0.005, "unit": "m" },
    { "key": "barSpacing", "label": "Bar spacing", "kind": "number", "default": 0.11, "min": 0.05, "max": 0.4, "step": 0.01, "unit": "m" },
    { "key": "barWidth", "label": "Bar width", "kind": "number", "default": 0.02, "min": 0.008, "max": 0.06, "step": 0.002, "unit": "m" },
    { "key": "railDepth", "label": "Rail depth", "kind": "number", "default": 0.05, "min": 0.02, "max": 0.15, "step": 0.005, "unit": "m" },
    { "key": "topRail", "label": "Top rail size", "kind": "number", "default": 0.06, "min": 0.03, "max": 0.15, "step": 0.005, "unit": "m" },
    { "key": "color", "label": "Frame color", "kind": "color", "default": "#1f2937" },
    { "key": "glassColor", "label": "Glass color", "kind": "color", "default": "#bae6fd" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 3, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "L": "length",
      "H": "height",
      "d2": "railDepth / 2",
      "pw2": "postWidth / 2",
      "nposts": "max(2, round(L / postSpacing) + 1)",
      "pstep": "L / max(1, round(L / postSpacing))",
      "nbars": "max(1, round(L / barSpacing))",
      "bstep": "L / max(1, round(L / barSpacing))",
      "bw2": "barWidth / 2",
      "nhor": "max(2, round((H - topRail) / 0.15))"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Posts",
            "repeat": "nposts",
            "as": "k",
            "vars": { "px": "-L / 2 + k * pstep" },
            "box": { "x0": "px - pw2", "x1": "px + pw2", "y0": "-d2", "y1": "d2", "h0": 0, "h1": "H", "color": "color" }
          },
          { "comment": "Top rail (handrail)", "box": { "x0": "-L / 2 - pw2", "x1": "L / 2 + pw2", "y0": "-topRail / 2", "y1": "topRail / 2", "h0": "H - topRail", "h1": "H", "color": "color" } },
          { "comment": "Bottom rail", "box": { "x0": "-L / 2", "x1": "L / 2", "y0": "-d2", "y1": "d2", "h0": "0.04", "h1": "0.04 + topRail * 0.7", "color": "color" } },
          {
            "comment": "Vertical balusters",
            "when": "infill == 'vertical'",
            "repeat": "nbars",
            "as": "k",
            "vars": { "bx": "-L / 2 + (k + 0.5) * bstep" },
            "box": { "x0": "bx - bw2", "x1": "bx + bw2", "y0": "-bw2", "y1": "bw2", "h0": "0.06", "h1": "H - topRail", "color": "color" }
          },
          {
            "comment": "Horizontal rails",
            "when": "infill == 'horizontal'",
            "repeat": "nhor",
            "as": "k",
            "vars": { "hz": "0.1 + k * (H - topRail - 0.1) / (nhor - 1)" },
            "box": { "x0": "-L / 2", "x1": "L / 2", "y0": "-bw2", "y1": "bw2", "h0": "hz - bw2", "h1": "hz + bw2", "color": "color" }
          },
          { "comment": "Glass panel", "when": "infill == 'glass'", "box": { "x0": "-L / 2 + pw2", "x1": "L / 2 - pw2", "y0": "-0.008", "y1": "0.008", "h0": "0.1", "h1": "H - topRail", "color": "glassColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "runLength", "label": "Run length", "expr": "length", "unit": "m" }
  ]
}
