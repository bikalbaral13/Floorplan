{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "pergola.v1",
    "name": "Pergola",
    "category": "Outdoor/Structure",
    "units": "m",
    "icon": { "paths": ["M4 8h16", "M4 8v12", "M20 8v12", "M4 8l2 -3h12l2 3", "M8 5v3", "M12 5v3", "M16 5v3"] }
  },
  "parameters": [
    { "key": "width", "label": "Width", "kind": "number", "default": 3.0, "min": 1.5, "max": 8, "step": 0.1, "unit": "m" },
    { "key": "depth", "label": "Depth", "kind": "number", "default": 3.0, "min": 1.5, "max": 8, "step": 0.1, "unit": "m" },
    { "key": "height", "label": "Clear height", "kind": "number", "default": 2.4, "min": 2, "max": 3.5, "step": 0.05, "unit": "m" },
    { "key": "postWidth", "label": "Post size", "kind": "number", "default": 0.14, "min": 0.08, "max": 0.3, "step": 0.01, "unit": "m" },
    { "key": "beamHeight", "label": "Beam height", "kind": "number", "default": 0.2, "min": 0.1, "max": 0.4, "step": 0.02, "unit": "m" },
    { "key": "beamWidth", "label": "Beam width", "kind": "number", "default": 0.08, "min": 0.04, "max": 0.2, "step": 0.01, "unit": "m" },
    { "key": "rafters", "label": "Rafters", "kind": "number", "default": 9, "min": 2, "max": 24, "step": 1 },
    { "key": "rafterWidth", "label": "Rafter width", "kind": "number", "default": 0.06, "min": 0.03, "max": 0.15, "step": 0.005, "unit": "m" },
    { "key": "rafterHeight", "label": "Rafter height", "kind": "number", "default": 0.14, "min": 0.06, "max": 0.3, "step": 0.01, "unit": "m" },
    { "key": "overhang", "label": "Rafter overhang", "kind": "number", "default": 0.25, "min": 0, "max": 0.6, "step": 0.05, "unit": "m" },
    { "key": "color", "label": "Post color", "kind": "color", "default": "#78350f" },
    { "key": "beamColor", "label": "Beam / rafter color", "kind": "color", "default": "#92400e" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 2, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "w2": "width / 2",
      "d2": "depth / 2",
      "H": "height",
      "pw2": "postWidth / 2",
      "bw2": "beamWidth / 2",
      "beamTop": "height + beamHeight",
      "nr": "max(2, round(rafters))",
      "rstep": "width / (max(2, round(rafters)) - 1)",
      "rw2": "rafterWidth / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Four posts",
            "repeat": 4,
            "as": "k",
            "vars": { "px": "(k == 0 || k == 3 ? 1 : -1) * (w2 - pw2)", "py": "(k < 2 ? 1 : -1) * (d2 - pw2)" },
            "box": { "x0": "px - pw2", "x1": "px + pw2", "y0": "py - pw2", "y1": "py + pw2", "h0": 0, "h1": "H", "color": "color" }
          },
          { "comment": "Left support beam (runs along depth)", "box": { "x0": "-w2 + pw2 - bw2", "x1": "-w2 + pw2 + bw2", "y0": "-d2", "y1": "d2", "h0": "H", "h1": "beamTop", "color": "beamColor" } },
          { "comment": "Right support beam", "box": { "x0": "w2 - pw2 - bw2", "x1": "w2 - pw2 + bw2", "y0": "-d2", "y1": "d2", "h0": "H", "h1": "beamTop", "color": "beamColor" } },
          {
            "comment": "Rafters — spaced along width, running across the depth with overhang",
            "repeat": "nr",
            "as": "k",
            "vars": { "rx": "-w2 + k * rstep" },
            "box": { "x0": "rx - rw2", "x1": "rx + rw2", "y0": "-d2 - overhang", "y1": "d2 + overhang", "h0": "beamTop", "h1": "beamTop + rafterHeight", "color": "beamColor" }
          }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "footprint", "label": "Shade footprint", "expr": "width * depth", "unit": "m²" },
    { "key": "topHeight", "label": "Overall height", "expr": "clearance + height + beamHeight + rafterHeight", "unit": "m" }
  ]
}
