{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "bbq.v1",
    "name": "BBQ Grill",
    "category": "Outdoor/Cooking",
    "units": "m",
    "icon": { "paths": ["M6 10a6 6 0 0 0 12 0z", "M7 4l1 2", "M12 3l1 2", "M17 4l-1 2", "M9 15l-2 5", "M15 15l2 5"] }
  },
  "parameters": [
    { "key": "style", "label": "Type", "kind": "select", "default": "kettle", "options": [ { "value": "kettle", "label": "Kettle" }, { "value": "builtin", "label": "Built-in" } ] },
    { "key": "bowlDia", "label": "Bowl diameter", "kind": "number", "default": 0.56, "min": 0.3, "max": 1, "step": 0.02, "unit": "m" },
    { "key": "bowlDepth", "label": "Bowl depth", "kind": "number", "default": 0.24, "min": 0.1, "max": 0.5, "step": 0.02, "unit": "m" },
    { "key": "legHeight", "label": "Leg / counter height", "kind": "number", "default": 0.7, "min": 0.3, "max": 1.1, "step": 0.02, "unit": "m" },
    { "key": "lidClosed", "label": "Lid closed", "kind": "checkbox", "default": true },
    { "key": "lidHeight", "label": "Lid height", "kind": "number", "default": 0.22, "min": 0.08, "max": 0.5, "step": 0.02, "unit": "m" },
    { "key": "width", "label": "Width (built-in)", "kind": "number", "default": 0.9, "min": 0.4, "max": 2, "step": 0.05, "unit": "m" },
    { "key": "depth", "label": "Depth (built-in)", "kind": "number", "default": 0.55, "min": 0.3, "max": 0.9, "step": 0.05, "unit": "m" },
    { "key": "sides", "label": "Roundness", "kind": "number", "default": 24, "min": 6, "max": 40, "step": 1 },
    { "key": "color", "label": "Body color", "kind": "color", "default": "#111827" },
    { "key": "grateColor", "label": "Grate color", "kind": "color", "default": "#9ca3af" },
    { "key": "legColor", "label": "Leg / trim color", "kind": "color", "default": "#374151" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 2, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "R": "bowlDia / 2",
      "legH": "legHeight",
      "grate": "legHeight + bowlDepth",
      "nsides": "max(6, round(sides))",
      "w2": "width / 2",
      "d2": "depth / 2"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Kettle legs (3, tripod)",
            "when": "style == 'kettle'",
            "repeat": 3,
            "as": "k",
            "vars": { "a": "k * 2 * PI / 3", "lx": "cos(a) * R * 0.8", "ly": "sin(a) * R * 0.8" },
            "box": { "x0": "lx - 0.02", "x1": "lx + 0.02", "y0": "ly - 0.02", "y1": "ly + 0.02", "h0": 0, "h1": "legH", "color": "legColor" }
          },
          {
            "comment": "Kettle bowl — hemisphere of stacked rings",
            "when": "style == 'kettle'",
            "repeat": 4,
            "as": "k",
            "vars": { "t": "(k + 0.5) / 4", "rr": "R * sqrt(max(0.03, 1 - pow(1 - t, 2)))" },
            "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "legH + k / 4 * bowlDepth", "h1": "legH + (k + 1) / 4 * bowlDepth", "color": "color" }
          },
          { "comment": "Kettle grate", "when": "style == 'kettle'", "circle": { "cx": 0, "cy": 0, "r": "R * 0.9", "sides": "nsides", "h0": "grate", "h1": "grate + 0.02", "color": "grateColor" } },
          {
            "comment": "Kettle domed lid",
            "when": "style == 'kettle' && lidClosed",
            "repeat": 4,
            "as": "k",
            "vars": { "t": "(k + 0.5) / 4", "rr": "R * sqrt(max(0.03, 1 - t * t))" },
            "circle": { "cx": 0, "cy": 0, "r": "rr", "sides": "nsides", "h0": "grate + 0.02 + k / 4 * lidHeight", "h1": "grate + 0.02 + (k + 1) / 4 * lidHeight", "color": "color" }
          },
          { "comment": "Lid handle", "when": "style == 'kettle' && lidClosed", "box": { "x0": "-0.05", "x1": "0.05", "y0": "-0.02", "y1": "0.02", "h0": "grate + 0.02 + lidHeight", "h1": "grate + 0.08 + lidHeight", "color": "legColor" } },
          { "comment": "Built-in body / cabinet", "when": "style == 'builtin'", "box": { "x0": "-w2", "x1": "w2", "y0": "-d2", "y1": "d2", "h0": 0, "h1": "legH", "color": "legColor" } },
          { "comment": "Built-in grill box", "when": "style == 'builtin'", "box": { "x0": "-w2 * 0.9", "x1": "w2 * 0.9", "y0": "-d2 * 0.85", "y1": "d2 * 0.85", "h0": "legH", "h1": "legH + 0.14", "color": "color" } },
          { "comment": "Built-in grate", "when": "style == 'builtin'", "box": { "x0": "-w2 * 0.85", "x1": "w2 * 0.85", "y0": "-d2 * 0.8", "y1": "d2 * 0.8", "h0": "legH + 0.14", "h1": "legH + 0.16", "color": "grateColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "grillArea", "label": "Grill area", "expr": "style == 'kettle' ? PI * R * R * 0.81 : width * depth * 0.72", "unit": "m²" }
  ]
}
