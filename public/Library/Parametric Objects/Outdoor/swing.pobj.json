{
  "kind": "parametric-object",
  "version": 1,
  "meta": {
    "id": "swing.v1",
    "name": "Garden Swing",
    "category": "Outdoor/Furniture",
    "units": "m",
    "icon": { "paths": ["M4 4l8 4l8 -4", "M12 8v3", "M8 11h8v3H8z", "M9 14v5", "M15 14v5"] }
  },
  "parameters": [
    { "key": "frameWidth", "label": "Frame width", "kind": "number", "default": 1.7, "min": 0.8, "max": 3, "step": 0.05, "unit": "m" },
    { "key": "frameDepth", "label": "Frame depth", "kind": "number", "default": 1.2, "min": 0.6, "max": 2, "step": 0.05, "unit": "m" },
    { "key": "postHeight", "label": "Frame height", "kind": "number", "default": 2.0, "min": 1.4, "max": 2.8, "step": 0.05, "unit": "m" },
    { "key": "postWidth", "label": "Post thickness", "kind": "number", "default": 0.08, "min": 0.04, "max": 0.2, "step": 0.01, "unit": "m" },
    { "key": "seatWidth", "label": "Seat width", "kind": "number", "default": 1.3, "min": 0.5, "max": 2.4, "step": 0.05, "unit": "m" },
    { "key": "seatDepth", "label": "Seat depth", "kind": "number", "default": 0.5, "min": 0.35, "max": 0.9, "step": 0.05, "unit": "m" },
    { "key": "seatHeight", "label": "Seat height", "kind": "number", "default": 0.45, "min": 0.25, "max": 0.7, "step": 0.02, "unit": "m" },
    { "key": "backHeight", "label": "Backrest height", "kind": "number", "default": 0.5, "min": 0, "max": 0.9, "step": 0.05, "unit": "m" },
    { "key": "canopy", "label": "Canopy", "kind": "checkbox", "default": true },
    { "key": "frameColor", "label": "Frame color", "kind": "color", "default": "#57534e" },
    { "key": "seatColor", "label": "Seat color", "kind": "color", "default": "#b45309" },
    { "key": "chainColor", "label": "Chain color", "kind": "color", "default": "#6b7280" },
    { "key": "canopyColor", "label": "Canopy color", "kind": "color", "default": "#15803d" },
    { "key": "color", "label": "Base color", "kind": "color", "default": "#57534e" },
    { "key": "rotation", "label": "Rotation", "kind": "number", "default": 0, "min": 0, "max": 360, "step": 5, "unit": "°" },
    { "key": "wallOffset", "label": "Offset", "kind": "number", "default": 0, "min": -1, "max": 1, "step": 0.01, "unit": "m" },
    { "key": "clearance", "label": "Clearance", "kind": "number", "default": 0, "min": 0, "max": 2, "step": 0.05, "unit": "m" }
  ],
  "hostKind": "node",
  "geometry": {
    "vars": {
      "fw2": "frameWidth / 2",
      "fd2": "frameDepth / 2",
      "ph": "postHeight",
      "pw2": "postWidth / 2",
      "sw2": "seatWidth / 2",
      "sd2": "seatDepth / 2",
      "sh": "seatHeight",
      "cx": "sw2 * 0.85",
      "cy": "sd2 * 0.8"
    },
    "cases": [
      {
        "rules": [
          {
            "comment": "Four A-frame posts at the corners",
            "repeat": 4,
            "as": "k",
            "vars": { "lx": "(k == 0 || k == 3 ? 1 : -1) * fw2", "ly": "(k < 2 ? 1 : -1) * fd2" },
            "box": { "x0": "lx - pw2", "x1": "lx + pw2", "y0": "ly - pw2", "y1": "ly + pw2", "h0": 0, "h1": "ph", "color": "frameColor" }
          },
          { "comment": "Top beam (swing hangs from it)", "box": { "x0": "-fw2 - pw2", "x1": "fw2 + pw2", "y0": "-pw2", "y1": "pw2", "h0": "ph - 2 * pw2", "h1": "ph", "color": "frameColor" } },
          { "comment": "Seat", "box": { "x0": "-sw2", "x1": "sw2", "y0": "-sd2", "y1": "sd2", "h0": "sh - 0.05", "h1": "sh", "color": "seatColor" } },
          { "comment": "Backrest", "when": "backHeight > 0", "box": { "x0": "-sw2", "x1": "sw2", "y0": "sd2 - 0.06", "y1": "sd2", "h0": "sh", "h1": "sh + backHeight", "color": "seatColor" } },
          {
            "comment": "Four hanging chains from beam to seat corners",
            "repeat": 4,
            "as": "k",
            "vars": { "hx": "(k == 0 || k == 3 ? 1 : -1) * cx", "hy": "(k < 2 ? 1 : -1) * cy" },
            "box": { "x0": "hx - 0.012", "x1": "hx + 0.012", "y0": "hy - 0.012", "y1": "hy + 0.012", "h0": "sh + 0.02", "h1": "ph - 2 * pw2", "color": "chainColor" }
          },
          { "comment": "Canopy roof", "when": "canopy", "box": { "x0": "-fw2 - 0.15", "x1": "fw2 + 0.15", "y0": "-fd2 - 0.15", "y1": "fd2 + 0.15", "h0": "ph", "h1": "ph + 0.06", "color": "canopyColor" } }
        ]
      }
    ]
  },
  "outputs": [
    { "key": "seats", "label": "Seat length", "expr": "seatWidth", "unit": "m" }
  ]
}
