  "conflicts": [
    {
      "id": "two_things_at_centre",
      "severity": "blocker",
      "when": { "all": [{ "q": "ceiling_fitting", "is": "both" }] },
      "says": "A fan and a chandelier both want the centre of the room, and this room has one centre.",
      "resolution": "Use a fan with an integrated ring light, which is one fitting doing both jobs.",
      "resolve": [
        { "object": "ceiling-fan-with-math", "param": "ringLight", "value": true },
        { "object": "ceiling-fan-with-math", "param": "lightKit", "value": false }
      ]
    },
    {
      "id": "sliding_needs_depth",
      "severity": "blocker",
      "when": { "all": [{ "q": "wardrobe_shutter", "is": "Sliding" }, { "q": "wardrobe_depth", "lt": 0.61 }] },
      "says": "Sliding shutters need 2'0\" of carcass depth to lap and still close; this wardrobe is shallower.",
      "resolution": "Take the wardrobe to 2'0\", or use hinged shutters.",
      "resolve": [{ "object": "wardrobe-with-math", "param": "depth", "value": 0.61 }]
    },
    {
      "id": "headboard_leaves_a_sliver",
      "severity": "warning",
      "when": { "all": [
        { "q": "headboard_source", "is": "wall_panel" },
        { "q": "headboard_width", "gt": { "q": "clear_span", "margin": -0.3 } }
      ] },
      "says": "The panel comes within 6\" of each end of the clear span, which reads as a mistake rather than a margin.",
      "resolution": "Either take the panel the full width of the wall, or pull it back so at least 1'0\" of painted wall shows each side."
    },
    {
      "id": "seat_not_level_with_sill",
      "severity": "warning",
      "when": { "all": [{ "q": "sill_height", "gt": { "q": "seat_frame_top", "margin": 0.16 } }] },
      "says": "The sill sits well above the cushion, so the seat will not read as built into the window.",
      "resolution": "Lower the sill, or raise the seat frame so frame plus cushion lands at sill height."
    },
    {
      "id": "nothing_to_recess_into",
      "severity": "warning",
      "when": { "all": [{ "q": "curtain_mount", "is": "recessed" }, { "q": "band_width", "lt": 0.15 }] },
      "says": "A recessed track has to hide inside the cove band, and this band is narrower than the track plus its curtain stack.",
      "resolution": "Widen the band to at least 6\", or use a surface ceiling track."
    },
    {
      "id": "panel_taller_than_ceiling",
      "severity": "blocker",
      "when": { "all": [
        { "q": "headboard_source", "is": "wall_panel" },
        { "q": "headboard_height", "gt": { "q": "cove_soffit", "margin": 0.01 } }
      ] },
      "says": "The upholstered panel is taller than the cove band soffit it has to die into.",
      "resolution": "Take the panel to the band soffit height."
    },
    {
      "id": "filler_below_ceiling",
      "severity": "warning",
      "when": { "all": [
        { "q": "wardrobe_filler", "is": true },
        { "q": "wardrobe_filler_to", "lt": { "q": "cove_soffit", "margin": -0.01 } }
      ] },
      "says": "The wardrobe filler stops below the ceiling line, which leaves the dust shelf it was meant to remove.",
      "resolution": "Fill up to the cove band soffit."
    },
    {
      "id": "cove_inverted",
      "severity": "blocker",
