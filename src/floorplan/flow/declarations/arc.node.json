        "key": "centerX",
        "label": "Center X"
      },
      {
        "key": "centerY",
        "label": "Center Y"
      },
      {
        "key": "radius",
        "label": "Radius"
      },
      {
        "key": "startAngle",
        "label": "Start angle"
      },
      {
        "key": "endAngle",
        "label": "End angle"
      },
      {
        "key": "show",
        "label": "Show"
      }
    ]
  },
  "parameters": [
    {
      "key": "centerX",
      "label": "Center X",
      "kind": "number",
      "default": 0,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "centerY",
      "label": "Center Y",
      "kind": "number",
      "default": 0,
