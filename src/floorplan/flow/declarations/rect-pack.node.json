{
  "kind": "flow-node",
  "version": 2,
  "tool": "rect-pack",
  "meta": {
    "label": "Rectangle Packing",
    "category": "Partition",
    "color": "#ea580c"
  },
  "description": "Pack rectangles inside a polygon — a pure CALCULATION node: coordinates in, coordinates out. Draws nothing on canvas.",
  "instructions": "A value-only node: it takes a polygon as a coordinate LIST and returns the packed rectangles as a coordinate list. It has no geometry input or output and draws nothing on the canvas — wire val-polygons into a Polygon node when you want them drawn.\n\nINPUT: polygon takes the outline as JSON [[x,y],...] metre pairs, local to the anchor. Wire Space Geometry val-points into valin-polygon.\n\nOUTPUT: val-polygons publishes every rectangle as a nested [[[x,y],...],...] list, which a Polygon node accepts directly. val-placed (count) and val-utilization (%) are still published.\n\nPACKING: width / height / count / gap / placement / seed / allowRotate / optimiseOrientation / alignToAxis / tilt. Every parameter is wireable (valin-*).",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      {
        "key": "polygon",
        "label": "Polygon"
      },
      {
        "key": "count",
        "label": "Count"
      }
    ],
    "valueOutputs": [
      {
        "key": "placed",
        "label": "Placed"
      },
      {
        "key": "utilization",
        "label": "Utilization",
        "unit": "%"
      },
      {
        "key": "polygons",
        "label": "Polygons (JSON)"
      }
    ]
  },
  "parameters": [
    {
      "key": "polygon",
      "label": "Polygon (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "width",
      "label": "Width",
      "kind": "range",
      "default": 6,
      "min": 0.5,
      "max": 50,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "height",
      "label": "Height",
      "kind": "range",
      "default": 9,
      "min": 0.5,
      "max": 50,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "count",
      "label": "Count (0 = fill)",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "key": "gap",
      "label": "Gap",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 0.05,
      "unit": "m"
    },
    {
      "key": "placement",
      "label": "Placement",
      "kind": "select",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "random",
          "label": "Random"
        }
      ]
    },
    {
      "key": "seed",
      "label": "Seed",
      "kind": "number",
      "default": 1,
      "min": 1,
      "step": 1,
      "showWhen": "placement == 'random'"
    },
    {
      "key": "allowRotate",
      "label": "Allow rotation",
      "kind": "checkbox",
      "default": true
    },
    {
      "key": "optimiseOrientation",
      "label": "Optimise orientation",
      "kind": "checkbox",
      "default": false,
      "showWhen": "placement != 'random'"
    },
    {
      "key": "alignToAxis",
      "label": "Align to axis",
      "kind": "checkbox",
      "default": true,
      "showWhen": "placement == 'random' || !optimiseOrientation"
    },
    {
      "key": "tilt",
      "label": "Tilt",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 180,
      "step": 1,
      "unit": "°",
      "showWhen": "(placement == 'random' || !optimiseOrientation) && !alignToAxis"
    }
  ]
}
