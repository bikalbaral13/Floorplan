{
  "kind": "flow-node",
  "version": 2,
  "tool": "optimise-rect",
  "meta": {
    "label": "Optimise Rectangle",
    "category": "Reshape",
    "color": "#7c3aed"
  },
  "description": "Pack optimal rectangles inside a polygon — a pure CALCULATION node: coordinates in, coordinates out. Draws nothing on canvas.",
  "instructions": "A value-only node: it takes a polygon as a coordinate LIST and returns the packed rectangles as a coordinate list. It has no geometry input or output and draws nothing on the canvas — wire val-polygons into a Polygon node when you want them drawn.\n\nINPUT: polygon takes the outline as JSON [[x,y],...] metre pairs, local to the anchor. Wire Space Geometry val-points into valin-polygon.\n\nOUTPUT: val-polygons publishes every rectangle as a nested [[[x,y],...],...] list, which a Polygon node accepts directly. val-area still reports the total packed area (m2).\n\nPACKING: shape / count / gap / union / reference / axisAngle shape the result; optimiseAxisTilt auto-picks the tilt that maximises packed area. Every parameter is wireable (valin-*).",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      {
        "key": "polygon",
        "label": "Polygon"
      },
      {
        "key": "axisAngle",
        "label": "Axis tilt"
      },
      {
        "key": "count",
        "label": "Rectangles (n)"
      },
      {
        "key": "optimiseAxisTilt",
        "label": "Optimise axis tilt"
      }
    ],
    "valueOutputs": [
      {
        "key": "area",
        "label": "Area",
        "unit": "m²"
      },
      {
        "key": "polygons",
        "label": "Polygons (JSON)"
      }
    ]
  },
  "vars": {
    "isRect": "shape != 'lshape' && shape != 'tshape' && shape != 'zshape' && shape != 'ishape' && shape != 'cshape' && shape != 'stepped' && shape != 'cross'",
    "isInscribed": "!isRect"
  },
  "parameters": [
    {
      "key": "polygon",
      "label": "Polygon (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "shape",
      "label": "Shape",
      "kind": "select",
      "default": "rectangle",
      "options": [
        {
          "value": "rectangle",
          "label": "Rectangle"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "hexagon",
          "label": "Hexagon"
        },
        {
          "value": "lshape",
          "label": "L-shape (inscribed)"
        },
        {
          "value": "tshape",
          "label": "T-shape (inscribed)"
        },
        {
          "value": "zshape",
          "label": "Z-shape (inscribed)"
        },
        {
          "value": "ishape",
          "label": "I-shape (inscribed)"
        },
        {
          "value": "cshape",
          "label": "C-shape (inscribed)"
        },
        {
          "value": "stepped",
          "label": "Stepped (inscribed)"
        },
        {
          "value": "cross",
          "label": "Cross (inscribed)"
        }
      ]
    },
    {
      "key": "random",
      "label": "Random",
      "kind": "checkbox",
      "default": false
    },
    {
      "key": "seed",
      "label": "Seed",
      "kind": "number",
      "default": 1,
      "min": 1,
      "step": 1,
      "showWhen": "random"
    },
    {
      "key": "reference",
      "label": "Reference",
      "kind": "select",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None (any-angle)"
        },
        {
          "value": "custom",
          "label": "Custom angle"
        },
        {
          "value": "by-edge",
          "label": "By edge"
        }
      ],
      "showWhen": "!random && isRect"
    },
    {
      "key": "referenceEdge",
      "label": "Edge index",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 19,
      "step": 1,
      "showWhen": "!random && reference == 'by-edge' && isRect"
    },
    {
      "key": "optimiseAxisTilt",
      "label": "Optimise axis tilt",
      "kind": "checkbox",
      "default": false,
      "showWhen": "!random && reference == 'custom' && isRect"
    },
    {
      "key": "axisAngle",
      "label": "Axis tilt",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 180,
      "step": 0.5,
      "unit": "°",
      "showWhen": "!random && (isInscribed || (reference == 'custom' && !optimiseAxisTilt) || reference == 'by-edge')"
    },
    {
      "key": "steps",
      "label": "Steps",
      "kind": "range",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "showWhen": "shape == 'stepped'"
    },
    {
      "key": "minNotch",
      "label": "Min notch length",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m",
      "showWhen": "isInscribed"
    },
    {
      "key": "minThickness",
      "label": "Min part thickness",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m",
      "showWhen": "isInscribed"
    },
    {
      "key": "count",
      "label": "Rectangles (n)",
      "kind": "range",
      "default": 1,
      "min": 1,
      "max": 20,
      "step": 1,
      "showWhen": "!random && isRect"
    },
    {
      "key": "gap",
      "label": "Gap",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m",
      "showWhen": "!random && count > 1 && isRect"
    },
    {
      "key": "union",
      "label": "Union",
      "kind": "checkbox",
      "default": false,
      "showWhen": "!random && count > 1 && isRect"
    },
    {
      "key": "shrinkEnabled",
      "label": "Shrink to target",
      "kind": "checkbox",
      "default": false,
      "showWhen": "isRect"
    },
    {
      "key": "targetArea",
      "label": "Target area",
      "kind": "range",
      "default": 50,
      "min": 0,
      "max": 500,
      "step": 0.5,
      "unit": "m²",
      "showWhen": "shrinkEnabled && isRect"
    },
    {
      "key": "shrinkAngle",
      "label": "Shrink angle",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°",
      "showWhen": "shrinkEnabled && isRect"
    },
    {
      "key": "optimiseShrinkEnabled",
      "label": "Optimise shrink",
      "kind": "checkbox",
      "default": false,
      "showWhen": "shrinkEnabled && isRect"
    },
    {
      "key": "shrinkSlide",
      "label": "Shrink slide",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 0.1,
      "unit": "%",
      "showWhen": "shrinkEnabled && !optimiseShrinkEnabled && isRect"
    },
    {
      "key": "exactArea",
      "label": "Exact area",
      "kind": "checkbox",
      "default": false,
      "showWhen": "shrinkEnabled && isRect"
    }
  ]
}
