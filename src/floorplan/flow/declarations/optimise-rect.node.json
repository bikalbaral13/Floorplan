{
  "kind": "flow-node",
  "version": 2,
  "tool": "optimise-rect",
  "meta": {
    "label": "Optimise Rectangle",
    "category": "Reshape",
    "color": "#7c3aed"
  },
  "description": "Fit the largest rectangle(s) inside the input space.",
  "materialisesSpace": true,
  "instructions": "Packs the largest inscribed shape(s) into each connected input Space and emits one geometry output per placed rectangle, plus a `val-area` value output carrying the total packed area (m²).\n\nWORKFLOW: wire a Space — or an upstream Inset / Split result — into the input handle, tune the params, then read the packed rectangle(s) from the outputs (or wire them onward to Split, Place Object, etc.).\n\nKEY PARAMS\n• shape — rectangle | square | hexagon | l/t/z/i/c-shape | stepped | cross. The inscribed (non-rectangular) shapes hide reference/count and instead use axisAngle + minNotch + minThickness.\n• reference — none = any-angle best fit · custom = fixed angle (axisAngle) · by-edge = align to edge `referenceEdge`. Only applies to rectangle/square/hexagon.\n• optimiseAxisTilt — with reference=custom, auto-sweeps the tilt for maximum area (overrides axisAngle).\n• count (1–20) — how many rectangles to pack. When >1, `gap` sets the minimum spacing (m) between them and `union` merges the pack into one Space.\n• shrinkEnabled — shrink the packed rect toward `targetArea` (m²); shrinkAngle/shrinkSlide place the shrink, optimiseShrink auto-places it, exactArea forces the exact area.\n• random — per-space auto-roll of tilt/count/union from `seed` (re-roll bumps the seed); hides the controls it drives.\n• minNotch / minThickness (m) — inscribed shapes only: reject a result whose cut-out or limbs fall below these.\n\nRECIPES\n• Clean orthogonal room → shape=rectangle, reference=none.\n• Align to a street/edge → reference=by-edge + referenceEdge.\n• Hit a required area → shrinkEnabled + targetArea.\n• Several input Spaces are each packed independently; outputMode=single bundles every rect onto one handle.",
  "handles": {
    "input": true,
    "output": true,
    "outputCount": "outputMode == 'single' ? 1 : max(1, min(40, round(inputCount)))",
    "valueInputs": [
      { "key": "axisAngle", "label": "Axis tilt" },
      { "key": "count", "label": "Rectangles (n)" },
      { "key": "optimiseAxisTilt", "label": "Optimise axis tilt" }
    ],
    "valueOutputs": [
      { "key": "area", "label": "Area", "unit": "m²" }
    ]
  },
  "vars": {
    "isRect": "shape != 'lshape' && shape != 'tshape' && shape != 'zshape' && shape != 'ishape' && shape != 'cshape' && shape != 'stepped' && shape != 'cross'",
    "isInscribed": "!isRect"
  },
  "parameters": [
    {
      "key": "outputMode",
      "label": "Outputs",
      "kind": "select",
      "default": "perCell",
      "options": [
        { "value": "perCell", "label": "Per rect (one each)" },
        { "value": "single", "label": "Single (all)" }
      ],
      "showWhen": "inputCount > 1"
    },
    {
      "key": "shape",
      "label": "Shape",
      "kind": "select",
      "default": "rectangle",
      "options": [
        { "value": "rectangle", "label": "Rectangle" },
        { "value": "square", "label": "Square" },
        { "value": "hexagon", "label": "Hexagon" },
        { "value": "lshape", "label": "L-shape (inscribed)" },
        { "value": "tshape", "label": "T-shape (inscribed)" },
        { "value": "zshape", "label": "Z-shape (inscribed)" },
        { "value": "ishape", "label": "I-shape (inscribed)" },
        { "value": "cshape", "label": "C-shape (inscribed)" },
        { "value": "stepped", "label": "Stepped (inscribed)" },
        { "value": "cross", "label": "Cross (inscribed)" }
      ]
    },
    {
      "key": "random",
      "label": "Random",
      "kind": "checkbox",
      "default": false
    },
    {
      "key": "seed",
      "label": "Seed",
      "kind": "number",
      "default": 1,
      "min": 1,
      "step": 1,
      "showWhen": "random"
    },
    {
      "key": "reference",
      "label": "Reference",
      "kind": "select",
      "default": "none",
      "options": [
        { "value": "none", "label": "None (any-angle)" },
        { "value": "custom", "label": "Custom angle" },
        { "value": "by-edge", "label": "By edge" }
      ],
      "showWhen": "!random && isRect"
    },
    {
      "key": "referenceEdge",
      "label": "Edge index",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 19,
      "step": 1,
      "showWhen": "!random && reference == 'by-edge' && isRect"
    },
    {
      "key": "optimiseAxisTilt",
      "label": "Optimise axis tilt",
      "kind": "checkbox",
      "default": false,
      "showWhen": "!random && reference == 'custom' && isRect"
    },
    {
      "key": "axisAngle",
      "label": "Axis tilt",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 180,
      "step": 0.5,
      "unit": "°",
      "showWhen": "!random && (isInscribed || (reference == 'custom' && !optimiseAxisTilt) || reference == 'by-edge')"
    },
    {
      "key": "steps",
      "label": "Steps",
      "kind": "range",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "showWhen": "shape == 'stepped'"
    },
    {
      "key": "minNotch",
      "label": "Min notch length",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m",
      "showWhen": "isInscribed"
    },
    {
      "key": "minThickness",
      "label": "Min part thickness",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m",
      "showWhen": "isInscribed"
    },
    {
      "key": "count",
      "label": "Rectangles (n)",
      "kind": "range",
      "default": 1,
      "min": 1,
      "max": 20,
      "step": 1,
      "showWhen": "!random && isRect"
    },
    {
      "key": "gap",
      "label": "Gap",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "m",
      "showWhen": "!random && count > 1 && isRect"
    },
    {
      "key": "union",
      "label": "Union",
      "kind": "checkbox",
      "default": false,
      "showWhen": "!random && count > 1 && isRect"
    },
    {
      "key": "shrinkEnabled",
      "label": "Shrink to target",
      "kind": "checkbox",
      "default": false,
      "showWhen": "isRect"
    },
    {
      "key": "targetArea",
      "label": "Target area",
      "kind": "range",
      "default": 50,
      "min": 0,
      "max": 500,
      "step": 0.5,
      "unit": "m²",
      "showWhen": "shrinkEnabled && isRect"
    },
    {
      "key": "shrinkAngle",
      "label": "Shrink angle",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "°",
      "showWhen": "shrinkEnabled && isRect"
    },
    {
      "key": "optimiseShrinkEnabled",
      "label": "Optimise shrink",
      "kind": "checkbox",
      "default": false,
      "showWhen": "shrinkEnabled && isRect"
    },
    {
      "key": "shrinkSlide",
      "label": "Shrink slide",
      "kind": "range",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 0.1,
      "unit": "%",
      "showWhen": "shrinkEnabled && !optimiseShrinkEnabled && isRect"
    },
    {
      "key": "exactArea",
      "label": "Exact area",
      "kind": "checkbox",
      "default": false,
      "showWhen": "shrinkEnabled && isRect"
    }
  ]
}
