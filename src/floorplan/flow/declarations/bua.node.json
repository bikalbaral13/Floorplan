{
  "kind": "flow-node",
  "version": 2,
  "tool": "bua",
  "meta": {
    "label": "BUA Calculator",
    "category": "Calculate",
    "color": "#0d9488"
  },
  "description": "Connect a space for plot area → FSI BUA (max permissible) + Non-FSI BUA.",
  "instructions": "Takes a Space as input to read its plot area (falls back to fields when unconnected) and computes FSI BUA (max permissible built-up area) + Non-FSI BUA — emitted on `val-fsiBua` / `val-nonFsiBua`. The input Space passes straight through the geometry output (no-op) so the pipeline continues.\n\nThe bottom block (front, remaining, edge index, ratio, split angle, axis tilt, rectangles, optimise-tilt) are PASS-THROUGH layout knobs — each has its own `val-*` output to wire into Inset / Split / Optimise Rectangle downstream, so one calculator can drive a whole layout.\n\nTIP: wire a plot Space in; read FSI BUA to size massing (e.g. BUA ÷ footprint → floors via a Math node).",
  "handles": {
    "input": true,
    "output": true,
    "valueOutputs": [
      { "key": "fsiBua", "label": "FSI BUA", "unit": "m²" },
      { "key": "nonFsiBua", "label": "Non-FSI BUA", "unit": "m²" }
    ]
  },
  "parameters": [
    { "key": "amenityOsRate", "label": "Amenity OS Rate", "kind": "number", "default": 0.1, "min": 0, "max": 1, "step": 0.01 },
    { "key": "losRate", "label": "LOS Rate", "kind": "number", "default": 0.15, "min": 0, "max": 1, "step": 0.01 },
    { "key": "basicFsiMultiplier", "label": "Basic FSI", "kind": "number", "default": 1.0, "min": 0, "step": 0.1 },
    { "key": "premiumFsiMultiplier", "label": "Premium FSI", "kind": "number", "default": 0.5, "min": 0, "step": 0.1 },
    { "key": "tdrMultiplier", "label": "TDR FSI", "kind": "number", "default": 0.9, "min": 0, "step": 0.1 },
    { "key": "fungibleRate", "label": "Fungible Rate", "kind": "number", "default": 0.35, "min": 0, "max": 1, "step": 0.05 },
    { "key": "schemeFsiSqm", "label": "Scheme FSI (m²)", "kind": "number", "default": 11721.6, "min": 0, "step": 10 },
    { "key": "inSituFsiFactor", "label": "In-Situ FSI (×)", "kind": "number", "default": 2, "min": 0, "step": 0.5 },
    { "key": "carParksRequired", "label": "Car Parks (nos)", "kind": "number", "default": 417, "min": 0, "step": 1 },
    { "key": "areaPerCarParkSqm", "label": "Area/Car Park (m²)", "kind": "number", "default": 30, "min": 0, "step": 1 },
    { "key": "otherNonFsiSqm", "label": "Other Non-FSI (m²)", "kind": "number", "default": 6000, "min": 0, "step": 100 },
    { "key": "wingsPerFloor", "label": "Wings / Cores", "kind": "number", "default": 5, "min": 1, "step": 1 },
    { "key": "podiumOffsetM", "label": "Podium Offset (m)", "kind": "number", "default": 3.5, "min": 0, "step": 0.5, "output": true },
    { "key": "front", "label": "Front offset", "kind": "range", "default": 0, "min": 0, "max": 6, "step": 0.1, "unit": "m", "output": true },
    { "key": "remaining", "label": "Remaining offset", "kind": "range", "default": 0, "min": 0, "max": 6, "step": 0.1, "unit": "m", "output": true },
    { "key": "edgeIndex", "label": "Edge index", "kind": "range", "default": 0, "min": 0, "max": 15, "step": 1, "output": true },
    { "key": "ratio", "label": "Ratio", "kind": "text", "default": "50, 50", "placeholder": "10, 90", "output": true },
    { "key": "splitAngle", "label": "Split Angle", "kind": "range", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°", "output": true },
    { "key": "axisTilt", "label": "Axis tilt", "kind": "range", "default": 0, "min": 0, "max": 360, "step": 1, "unit": "°", "output": true },
    { "key": "rectangles", "label": "Rectangles", "kind": "range", "default": 1, "min": 1, "max": 5, "step": 1, "output": true },
    { "key": "optimiseAxisTilt", "label": "Optimise axis tilt", "kind": "checkbox", "default": false, "output": true }
  ]
}
