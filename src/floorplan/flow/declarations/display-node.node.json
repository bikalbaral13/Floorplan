{
  "kind": "flow-node",
  "version": 2,
  "tool": "display-node",
  "meta": { "label": "Display Node", "category": "Node", "color": "#475569" },
  "description": "Draw the input node as a marker — shape / style / colour / size / hatch (passes the node through).",
  "instructions": "Draws each incoming node (point) as a marker — Shape (dot / circle / square / triangle) · stroke Style · Colour · Size · optional diagonal / dots hatch fill — and threads it downstream unchanged.\n\nSCHEMA-DRIVEN: wire a Schema into the Schema input (or attach one) and each node styles per its own schema values by role (node-shape / node-style / node-color / node-size / node-hatch…); node params are the fallback. `applyTo` restricts marking to plain nodes vs object nodes so it can coexist with Node → Object. Exposes its params on the `pout` endpoint so an Input Schema node can derive a Node schema from them.",
  "handles": {
    "input": true,
    "output": true,
    "exposesParams": true,
    "geomInputs": [
      { "key": "schema", "label": "Schema" }
    ]
  },
  "parameters": [
    {
      "key": "applyTo",
      "label": "Apply to",
      "kind": "select",
      "default": "any",
      "options": [
        { "value": "any", "label": "Any node" },
        { "value": "node", "label": "Nodes only" },
        { "value": "object", "label": "Objects only" }
      ]
    },
    {
      "key": "shape",
      "label": "Shape",
      "kind": "select",
      "default": "dot",
      "role": "node-shape",
      "options": [
        { "value": "dot", "label": "Dot" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" },
        { "value": "triangle", "label": "Triangle" }
      ]
    },
    {
      "key": "style",
      "label": "Style",
      "kind": "select",
      "default": "solid",
      "role": "node-style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ]
    },
    { "key": "color", "label": "Color", "kind": "color", "default": "#475569", "role": "node-color" },
    { "key": "size", "label": "Size", "kind": "range", "default": 1, "min": 0.5, "max": 5, "step": 0.5, "unit": "×", "role": "node-size" },
    { "key": "hatch", "label": "Hatch", "kind": "checkbox", "default": false, "role": "node-hatch" },
    {
      "key": "hatchStyle",
      "label": "Hatch Style",
      "kind": "select",
      "default": "diagonal",
      "role": "node-hatch-style",
      "options": [
        { "value": "diagonal", "label": "Diagonal lines" },
        { "value": "dots", "label": "Random dots" }
      ],
      "showWhen": "hatch"
    },
    { "key": "spacing", "label": "Spacing", "kind": "range", "default": 8, "min": 3, "max": 40, "step": 1, "unit": "px", "role": "node-hatch-spacing", "showWhen": "hatch" },
    { "key": "angle", "label": "Angle", "kind": "range", "default": 45, "min": 0, "max": 180, "step": 1, "unit": "°", "role": "node-hatch-angle", "showWhen": "hatch && hatchStyle == 'diagonal'" },
    { "key": "weight", "label": "Weight", "kind": "range", "default": 1, "min": 0.5, "max": 5, "step": 0.5, "unit": "px", "showWhen": "hatch" }
  ]
}
