{
  "kind": "flow-node",
  "version": 2,
  "tool": "pull",
  "meta": {
    "label": "Pull",
    "category": "Space",
    "color": "#ca8a04"
  },
  "description": "A pure CALCULATION node — pull two polygons together (or apart): coordinates in, coordinates out. Draws nothing on canvas.",
  "instructions": "A value-only node: it takes TWO polygons as coordinate LISTS and returns both moved outlines as a coordinate list. It has no geometry input or output and draws nothing on the canvas — wire val-polygons into a Polygon node when you want them drawn.\n\nINPUT: polygon = outline A, polygonB = outline B, each JSON [[x,y],...] metre pairs local to the anchor. Wire Space Geometry val-points into each.\n\nOUTPUT: val-polygons publishes BOTH results as a nested [[[x,y],...],...] list — A first, then B.\n\nmode / anchor / contact / distance / edgeSlide control the pull. Every parameter is wireable (valin-*).",
  "handles": {
    "input": false,
    "output": false,
    "valueInputs": [
      {
        "key": "polygon",
        "label": "Polygon"
      },
      {
        "key": "polygonB",
        "label": "Polygon B"
      },
      {
        "key": "distance",
        "label": "Distance"
      }
    ],
    "valueOutputs": [
      {
        "key": "polygons",
        "label": "Polygons (JSON)"
      }
    ]
  },
  "parameters": [
    {
      "key": "polygon",
      "label": "Polygon (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "polygonB",
      "label": "Polygon B (JSON)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "mode",
      "label": "Mode",
      "kind": "select",
      "default": "touch",
      "options": [
        {
          "value": "touch",
          "label": "Touch"
        },
        {
          "value": "distance",
          "label": "Distance (gap)"
        },
        {
          "value": "centroid",
          "label": "Centroid"
        }
      ]
    },
    {
      "key": "contact",
      "label": "Contact",
      "kind": "select",
      "default": "point",
      "options": [
        {
          "value": "point",
          "label": "Point (closest)"
        },
        {
          "value": "edge-flush",
          "label": "Edge flush"
        }
      ],
      "showWhen": "mode != 'centroid'"
    },
    {
      "key": "distance",
      "label": "Gap",
      "kind": "range",
      "default": 0.5,
      "min": 0,
      "max": 10,
      "step": 0.05,
      "unit": "m",
      "showWhen": "mode == 'distance'"
    },
    {
      "key": "anchor",
      "label": "Move",
      "kind": "select",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "A",
          "label": "A only"
        },
        {
          "value": "B",
          "label": "B only"
        }
      ]
    },
    {
      "key": "edgeSlide",
      "label": "Edge slide",
      "kind": "checkbox",
      "default": true,
      "showWhen": "mode != 'centroid' && contact == 'edge-flush'"
    }
  ]
}
