{
  "schema": "commandengine-seed/0",
  "note": "Phase 1 seed: 30 command types mapped to the real tool surface (design.edit ops in server/designMcp.mjs + toolGroups.mjs). Examples are hand-written; replace/extend with logged editor-chat sentences.",
  "intents": [
    { "id": "wall.add", "call": "design.edit", "op": "wall", "slots": ["from", "to", "thickness?", "height?"], "examples": ["draw a wall from 0,0 to 5,0", "add a 230 mm wall along the north side of the kitchen", "wall 4 m long, 150 thick"] },
    { "id": "line.add", "call": "design.edit", "op": "line", "slots": ["from", "to", "layer?"], "examples": ["draw a line from 1,1 to 3,1", "add a segment 2 m long"] },
    { "id": "door.add", "call": "design.edit", "op": "opening", "slots": ["kind=door", "room|wall", "side?", "width?"], "examples": ["add a door on the north wall of bedroom 2, 900 wide", "put a 1 m door between kitchen and dining", "door in the toilet, 750"] },
    { "id": "window.add", "call": "design.edit", "op": "opening", "slots": ["kind=window", "room|wall", "side?", "width?", "sill?"], "examples": ["add a 1.5 m window on the east wall of the living room", "window in master bedroom, sill 900"] },
    { "id": "opening.resize", "call": "design.edit", "op": "set", "slots": ["target", "width|height"], "examples": ["make this door 1 m wide", "widen the living room window to 2 m"] },
    { "id": "room.add", "call": "design.edit", "op": "space", "slots": ["name", "w", "h", "at?"], "examples": ["add a 3x4 bedroom", "create a study 3 by 3.5 m next to the living room"] },
    { "id": "room.resize", "call": "design.edit", "op": "set", "slots": ["room", "w?", "h?"], "examples": ["make the kitchen 4 by 3.5 m", "extend bedroom 2 by 500 mm to the east"] },
    { "id": "room.rename", "call": "design.edit", "op": "set", "slots": ["room", "name"], "examples": ["rename room 3 to Study", "call this room Pooja"] },
    { "id": "room.merge", "call": "draw.merge_spaces", "slots": ["rooms[]"], "examples": ["merge living and dining", "combine these two rooms"] },
    { "id": "rooms.detect", "call": "draw.spaces", "slots": [], "examples": ["detect rooms", "find the spaces", "recompute rooms"] },
    { "id": "object.place", "call": "design.edit", "op": "object", "slots": ["object", "room?", "at?", "rotation?"], "examples": ["place a queen bed in the master bedroom", "add a 3 seater sofa in the living room", "put a wardrobe against the west wall of bedroom 2"] },
    { "id": "object.replace", "call": "design.edit", "op": "object", "slots": ["target", "object"], "examples": ["replace this sofa with an L-shaped sofa", "swap the bed for a king bed"] },
    { "id": "object.param", "call": "design.edit", "op": "set", "slots": ["target", "param", "value"], "examples": ["set the bed width to 1800", "make the table 1.2 m long", "change the sofa colour to grey"] },
    { "id": "object.attach", "call": "design.edit", "op": "attach", "slots": ["object", "room|segment"], "examples": ["attach skirting to this wall", "attach flooring to the kitchen"] },
    { "id": "move", "call": "design.edit", "op": "move", "slots": ["target", "dx|dir+dist|to"], "examples": ["move the bed 300 mm left", "shift this door 0.5 m north", "move the sofa to the centre of the room"] },
    { "id": "rotate", "call": "design.edit", "op": "set", "slots": ["target", "angle"], "examples": ["rotate the bed 90 degrees", "turn the table clockwise"] },
    { "id": "delete", "call": "design.edit", "op": "delete", "slots": ["target"], "examples": ["delete selected", "remove the coffee table", "get rid of this wall"] },
    { "id": "select", "call": "session.selection", "slots": ["target"], "examples": ["select all doors", "select the kitchen", "select every bed"] },
    { "id": "layer.visibility", "call": "layers", "slots": ["layer|discipline", "visible"], "examples": ["hide the MEP layers", "show structure", "turn off furniture"] },
    { "id": "layer.create", "call": "layers.create", "slots": ["name"], "examples": ["create a layer called Electrical"] },
    { "id": "layer.move", "call": "layers.move", "slots": ["target", "layer"], "examples": ["move these to the Furniture layer"] },
    { "id": "level.set", "call": "set_level", "slots": ["level"], "examples": ["go to first floor", "switch to level 1", "show ground floor"] },
    { "id": "view.set", "call": "set_view", "slots": ["2d|3d|split"], "examples": ["show 3D", "switch to plan view", "split view"] },
    { "id": "rendermode.set", "call": "design.edit", "op": "set", "slots": ["targets", "Nothing|Basic|Full"], "examples": ["set render mode to basic for all furniture", "render everything in full"] },
    { "id": "material.set", "call": "design.edit", "op": "set", "slots": ["target", "material"], "examples": ["make the kitchen floor marble", "tile the bathroom walls white"] },
    { "id": "underlay.set", "call": "underlay.set", "slots": ["image", "opacity?", "visible?"], "examples": ["put the underlay up", "hide the image overlay", "set underlay opacity to 50%"] },
    { "id": "design.load", "call": "design.load", "slots": ["path"], "examples": ["open Designs/villa_1.json", "load the 2bhk trace"] },
    { "id": "canvas.clear", "call": "design.clear", "slots": [], "examples": ["clear the canvas", "start fresh"] },
    { "id": "snapshot", "call": "viewer.snapshot", "slots": [], "examples": ["take a snapshot", "show me what it looks like"] },
    { "id": "history", "call": "editor.undo|redo", "slots": ["undo|redo", "count?"], "examples": ["undo", "undo last 3", "redo"] }
  ]
}
