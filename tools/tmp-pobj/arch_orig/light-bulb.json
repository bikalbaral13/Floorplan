      "data": {
        "tool": "expr",
        "params": {
          "name": "Light Bulb maths",
          "expr": "_natL = 2 * bulbRadius\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_isPend = mount == 'Pendant'\n_isCeil = mount == 'Ceiling'\n_isWall = mount == 'Wall'\n_up = (mount == 'Table') ? 1 : -1\n_mz = mountHeight * _s\n_cord = _isPend ? cordLength * _s : 0\n_cordR = cordRadius * _s\n_rg = bulbRadius * _s\n_hg = glassHeight * _s\n_rn = neckRadius * _s\n_hn = neckHeight * _s\n_rb = capRadius * _s\n_hb = capHeight * _s\n_sd = max(8, round(sides))\n_ns = max(4, round(profileSteps))\n# Envelope shape — the bulb silhouette is one sine sweep; the three named shapes are just\n# different (radius, height) pairs fed to it, not three bodies.\n_isGlobe = shape == 'Globe'\n_isCand = shape == 'Candle'\n_rgE = _isGlobe ? _rg * 1.25 : (_isCand ? _rg * 0.62 : _rg)\n_hgE = _isGlobe ? _rg * 2.5 : (_isCand ? _hg * 1.7 : _hg)\n_span = 2 * _rgE\n_bodyL = _span\n_bodyW = _span\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n# The lamp axis. Pendant / Ceiling / Wall hang DOWN from the mount; Table stands up from it.\n_capZ = _mz - _cord\n_axZ = _capZ\n# The revolve profile [t, r], t measured along the axis from its start (the cap end).\n# The bulb is r = R·sin(theta) swept from the neck angle to pi, so it MEETS the neck at the\n# right radius and closes to a point at the tip — which is what makes it a solid at all.\n_ratio = min(0.98, _rn / _rgE)\n_th0 = atan2(_ratio, sqrt(max(0.0001, 1 - _ratio * _ratio)))\n_kk = arange(_ns) + 1\n_thk = _th0 + (PI - _th0) * _kk / _ns\n_rk = _rgE * sin(_thk)\n_tk = _hn + _hgE * (cos(_th0) - cos(_thk)) / (cos(_th0) + 1)\n_prof = vcat(hcat(0, 0), hcat(0, _rn), hcat(_hn, _rn), hcat(_tk, _rk))\n_gseg = hcat(_wcx, _wcy, _axZ, _wcx, _wcy, _axZ + _up)\nGlass3D = mlathe(_gseg, _prof, _sd)\n# Cap, cord and filament — capped cylinders along the same axis\n_CAP = hcat(_wcx, _wcy, _axZ, _wcx, _wcy, _axZ - _up * _hb, _rb)\n_CORD = hcat(_wcx, _wcy, _axZ - _up * _hb, _wcx, _wcy, _mz, _cordR)\nCap3D = _CAP\nCord3D = (_cord > 0.001 || _isCeil || _isWall) ? _CORD : zeros(0, 7)\n_fz0 = _axZ + _up * (_hn + _hgE * 0.18)\n_fz1 = _axZ + _up * (_hn + _hgE * 0.62)\n_fr = _rgE * 0.28\n_FIL = vcat(hcat(_wcx - _fr, _wcy, _fz0, _wcx - _fr * 0.3, _wcy, _fz1, _rgE * 0.035), hcat(_wcx - _fr * 0.3, _wcy, _fz1, _wcx + _fr * 0.3, _wcy, _fz1, _rgE * 0.035), hcat(_wcx + _fr * 0.3, _wcy, _fz1, _wcx + _fr, _wcy, _fz0, _rgE * 0.035), hcat(_wcx - _fr, _wcy, _axZ + _up * _hn, _wcx - _fr, _wcy, _fz0, _rgE * 0.03), hcat(_wcx + _fr, _wcy, _axZ + _up * _hn, _wcx + _fr, _wcy, _fz0, _rgE * 0.03))\nFilament3D = filament > 0 ? _FIL : zeros(0, 7)\n# Plan symbol\nBulbPlan = hcat(_wcx, _wcy, _rgE)\nCapPlan = hcat(_wcx, _wcy, _rb)\n# Metrics\nenvelopeDiameter = 2 * _rgE\nenvelopeHeight = _hn + _hgE\noverallHeight = _hb + _hn + _hgE\ncapDiameter = 2 * _rb\nlampElevation = _axZ + _up * (_hn + _hgE / 2)\ntipElevation = _axZ + _up * (_hn + _hgE)\nmountElevation = _mz\ndropFromMount = _isPend ? (_cord + _hb) : _hb\nfacets = _sd"
        }
      }
