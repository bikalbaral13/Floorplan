      "data": {
        "tool": "expr",
        "params": {
          "name": "TV Unit maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_Wd = width * _s\n_Ht = height * _s\n_bodyL = _Ln\n_bodyW = _Wd\n_u0 = 0 - _Ln / 2\n_u1 = _Ln / 2\n_v0 = 0 - _Wd / 2\n_v1 = _Wd / 2\n_tT = min(topThk * _s, _Ht * 0.25)\n_isLegs = base == 'Legs' ? 1 : 0\n_isPlinth = base == 'Plinth' ? 1 : 0\n_baseH = _isLegs > 0 ? min(legHeight * _s, _Ht * 0.5) : (_isPlinth > 0 ? min(0.08 * _s, _Ht * 0.2) : 0)\n_carZ0 = _baseH\n_carZ1 = _Ht - _tT\n_lg = max(0.03 * _s, min(_Ln, _Wd) * 0.07)\n_plinthIn = _Wd * 0.06\n_nB = max(1, min(6, round(bays)))\n_gap = doorGap * _s\n_bW = _Ln / _nB\n_scD = screenSize * _s\n_scW = _scD * 0.87\n_scH = _scD * 0.49\n_scZ = screenHeight * _s\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_TOP = hcat(_u0, _v0, _u1, _v0, _u1, _v1, _u0, _v1, _carZ1, _Ht, 1)\n_CAR = hcat(_u0, _v0, _u1, _v0, _u1, _v1, _u0, _v1, _carZ0, _carZ1, 2)\n_L1 = hcat(_u0, _v0, _u0 + _lg, _v0, _u0 + _lg, _v0 + _lg, _u0, _v0 + _lg, 0, _baseH, 3)\n_L2 = hcat(_u1 - _lg, _v0, _u1, _v0, _u1, _v0 + _lg, _u1 - _lg, _v0 + _lg, 0, _baseH, 3)\n_L3 = hcat(_u1 - _lg, _v1 - _lg, _u1, _v1 - _lg, _u1, _v1, _u1 - _lg, _v1, 0, _baseH, 3)\n_L4 = hcat(_u0, _v1 - _lg, _u0 + _lg, _v1 - _lg, _u0 + _lg, _v1, _u0, _v1, 0, _baseH, 3)\n_PLQ = hcat(_u0 + _plinthIn, _v0 + _plinthIn, _u1 - _plinthIn, _v0 + _plinthIn, _u1 - _plinthIn, _v1 - _plinthIn, _u0 + _plinthIn, _v1 - _plinthIn, 0, _baseH, 3)\n_BASE = _isLegs > 0 ? vcat(vcat(_L1, _L2), vcat(_L3, _L4)) : (_isPlinth > 0 ? _PLQ : zeros(0, 11))\n_DRW = zeros(0, 11)\nloop i in _nB:\n  _fu0 = _u0 + i * _bW + _gap\n  _fu1 = _u0 + (i + 1) * _bW - _gap\n  _DRW = vcat(_DRW, hcat(_fu0, _v0 - 0.012 * _s, _fu1, _v0 - 0.012 * _s, _fu1, _v0, _fu0, _v0, _carZ0 + _gap, _carZ1 - _gap, 4))\nend\n_SCQ = hcat(0 - _scW / 2, _v1 - 0.04 * _s, _scW / 2, _v1 - 0.04 * _s, _scW / 2, _v1, 0 - _scW / 2, _v1, _scZ - _scH / 2, _scZ + _scH / 2, 5)\n_SC = showScreen > 0 ? _SCQ : zeros(0, 11)\nQ = vcat(vcat(_TOP, _CAR), vcat(_BASE, vcat(_DRW, _SC)))\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nTop3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nTopPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nCarcass3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nCarcassPlan = sub(compress(_WP, eq(col(_WP,3), 2)), 0, 0, _nwp, 3)\nBase3D = sub(compress(_W, eq(col(_W,4), 3)), 0, 0, _nw, 4)\nBasePlan = sub(compress(_WP, eq(col(_WP,3), 3)), 0, 0, _nwp, 3)\nFronts3D = sub(compress(_W, eq(col(_W,4), 4)), 0, 0, _nw, 4)\nFrontsPlan = sub(compress(_WP, eq(col(_WP,3), 4)), 0, 0, _nwp, 3)\nScreen3D = sub(compress(_W, eq(col(_W,4), 5)), 0, 0, _nw, 4)\nScreenPlan = sub(compress(_WP, eq(col(_WP,3), 5)), 0, 0, _nwp, 3)\n# Metrics\noverallLength = _Ln\noverallWidth = _Wd\noverallHeight = _Ht\nfootprint = _Ln * _Wd\nbayCount = _nB\nbayWidth = _bW\nscreenWidth = _scW\nscreenLevel = _scZ\nviewingDistance = _scD * 1.6"
        }
      }
    },
