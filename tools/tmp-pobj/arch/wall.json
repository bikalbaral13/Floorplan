      "data": {
        "tool": "expr",
        "params": {
          "name": "Wall maths",
          "expr": "_e1 = hcat(1, 0)\n_n = rows(P)\n_isSeg = _n == 2\n_isSpace = _n > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_eLen = len(_edges)\n_longest = max(_eLen)\n_mask = eq(_eLen, _longest)\n_sDir = _isSpace ? row(compress(_edges, _mask), 0) : _e1\n_sA = _isSpace ? row(compress(P, _mask), 0) : row(P, 0)\n_segV = _isSeg ? (row(P, 1) - row(P, 0)) : _sDir\n_dir = _isSeg ? _segV : (_isSpace ? _sDir : _e1)\n_dLen = min(len(_dir))\n_u = _dLen > 1e-9 ? normalize(_dir) : _e1\n_ux = sub(_u, 0, 0, 1, 1)\n_uy = sub(_u, 0, 1, 1, 1)\n_px = 0 - _uy\n_py = _ux\n_hosted = (_isSeg || _isSpace) && _dLen > 1e-9\n_fill = fitMode == 'Fill segment'\n_L = _hosted ? (_fill ? _dLen : min(max(0.1, length), _dLen)) : max(0.1, length)\n_t = max(0.02, thickness)\n_h = max(0.05, height)\n_b = base\n_pA = _isSpace ? _sA : row(P, 0)\n_pax = sub(_pA, 0, 0, 1, 1)\n_pay = sub(_pA, 0, 1, 1, 1)\n_cx0 = _hosted ? _pax + _ux * _dLen / 2 : _pax\n_cy0 = _hosted ? _pay + _uy * _dLen / 2 : _pay\n_room = _hosted ? max(0, (_dLen - _L) / 2) : 0\n_off = max(0 - _room, min(_room, offset))\n_alLeft = align == 'Left of run'\n_alRight = align == 'Right of run'\n_dv = _alLeft ? (0 - _t / 2) : (_alRight ? _t / 2 : 0)\n_mx = _cx0 + _ux * _off + _px * _dv\n_my = _cy0 + _uy * _off + _py * _dv\n_hw = _L / 2\n_ht = _t / 2\n_S1 = vcat(hcat(-1, -1), hcat(1, -1), hcat(1, 1), hcat(-1, 1))\n_sa = col(_S1, 0)\n_sb = col(_S1, 1)\n_show = mode != 'Line'\n_ring = hcat(_mx + _sa * _hw * _ux + _sb * _ht * _px, _my + _sa * _hw * _uy + _sb * _ht * _py)\nBandPlan = _show ? _ring : zeros(0, 2)\nWallMesh = _show ? mprism(_ring, _b, _b + _h) : zeros(0, 4)\n_hs = max(0.08, _t * 0.75)\n_hn = hatch > 0 ? max(0, floor((_L - 3 * _t) / _hs) + 1) : 0\n_hx0 = 0 - _hw + _t\n_k = arange(_hn)\n_u1 = _hx0 + _k * _hs\n_u2 = _u1 + _t\nHatchPlan = hcat(_mx + _u1 * _ux - _ht * _px, _my + _u1 * _uy - _ht * _py, _mx + _u2 * _ux + _ht * _px, _my + _u2 * _uy + _ht * _py)\nCentrePlan = hcat(_mx - _hw * _ux, _my - _hw * _uy, _mx + _hw * _ux, _my + _hw * _uy)\nEnds = vcat(hcat(_mx - _hw * _ux, _my - _hw * _uy), hcat(_mx + _hw * _ux, _my + _hw * _uy))\nwallLength = _L\nwallThickness = _t\nwallHeight = _h\nbaseElevation = _b\ntopElevation = _b + _h\nplanArea = _L * _t\nvolume = _L * _t * _h\nfaceArea = 2 * _L * _h\nendArea = 2 * _t * _h\nexposedArea = 2 * _L * _h + 2 * _t * _h + _L * _t\nbearing = min(angle(_dir))\nhostLength = _hosted ? _dLen : 0\nhatchLines = _hn\noffsetApplied = _off\ncentrelineShift = _dv"
        }
      }
