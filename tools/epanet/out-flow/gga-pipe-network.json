      "data": {
        "tool": "expr",
        "params": {
          "name": "Global Gradient Algorithm",
          "expr": "_ne = max(1.05, min(3, nExp))\n_more = max(0, min(50, round(iterations)) - 1)\nabsQ = max(abs(Q), 1e-9)\nA11 = r * pow(absQ, _ne - 1)\nheadLoss = A11 * Q\nA12H = A12 @ H\nA10H0 = A10 @ H0\nE = headLoss + A12H + A10H0\nD11 = _ne * A11\ndinv = 1 / D11\nA21 = T(A12)\nA12s = A12 * dinv\nAmat = A21 @ A12s\nAinv = inv(Amat)\nA21Q = A21 @ Q\nC = A21Q - q\ndE = E * dinv\nA21dE = A21 @ dE\nrhs = C - A21dE\ndH = Ainv @ rhs\nHnew = H + dH\nA12dH = A12 @ dH\nEpA = E + A12dH\ndQ = 0 - EpA * dinv\nQnew = Q + dQ\n_Qk = Qnew\n_Hk = Hnew\nloop it in _more:\n  _aq = max(abs(_Qk), 1e-9)\n  _a11 = r * pow(_aq, _ne - 1)\n  _e = _a11 * _Qk + A12 @ _Hk + A10 @ H0\n  _di = 1 / (_ne * _a11)\n  _am = A21 @ (A12 * _di)\n  _c = A21 @ _Qk - q\n  _dh = inv(_am) @ (_c - A21 @ (_e * _di))\n  _dq = 0 - (_e + A12 @ _dh) * _di\n  _Qk = _Qk + _dq\n  _Hk = _Hk + _dh\nend\nQsolved = _Qk\nHsolved = _Hk\n_aqf = max(abs(_Qk), 1e-9)\n_a11f = r * pow(_aqf, _ne - 1)\n_Ef = _a11f * _Qk + A12 @ _Hk + A10 @ H0\n_Cf = A21 @ _Qk - q\nheadLossSolved = _a11f * _Qk\npipes = rows(r)\njunctions = rows(q)\niterationsRun = _more + 1\nexponent = _ne\nmaxEnergyResidual = max(abs(E))\nmaxContinuityResidual = max(abs(C))\nmaxDQ = max(abs(dQ))\nmaxDH = max(abs(dH))\nfinalEnergyResidual = max(abs(_Ef))\nfinalContinuityResidual = max(abs(_Cf))\n"
        }
      }
    },
