      "data": {
        "tool": "expr",
        "params": {
          "name": "Downlight maths",
          "expr": "_natL = housingDia\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_ap = aperture * _s\n_tw = trimWidth * _s\n_hd = max(housingDia * _s, _ap + 0.004)\n_hh = housingHeight * _s\n_cz = mountHeight\n_bodyL = _hd\n_bodyW = _hd\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n# Trim style only moves two planes: where the lens sits relative to the soffit, and whether the\n# housing hangs below it. Everything else is the same body.\n_isRec = trim == 'Recessed'\n_isSurf = trim == 'Surface'\n_isGim = trim == 'Gimbal'\n_drop = _isRec ? (_ap * 0.5) : 0\n_lensZ = _cz - _drop\n_hz0 = _isSurf ? (_cz - _hh) : _cz\n_hz1 = _hz0 + _hh\n# Housing and lens are cylinders — a tube row is x,y,z,x,y,z,r.\nHousing3D = hcat(_wcx, _wcy, _hz0, _wcx, _wcy, _hz1, _hd / 2)\nLens3D = hcat(_wcx, _wcy, _lensZ - 0.004, _wcx, _wcy, _lensZ, _ap / 2)\n# Trim is a torus at the soffit — a ring row is x,y,z,x,y,z,r,tubeR.\n_tr = _ap / 2 + _tw / 2\nTrim3D = hcat(_wcx, _wcy, _cz, _wcx, _wcy, _cz + 0.001, _tr, _tw / 2)\n# Beam footprint at the floor. A gimbal throws its cone off-centre by the aimTilt.\n_half = beamAngle * PI / 360\n_br = max(0.02, _cz * tan(_half))\n_off = _isGim ? (_cz * tan(aimTilt * PI / 180)) : 0\n_beamX = _wcx + _off * _ux\n_beamY = _wcy + _off * _uy\n_BEAMr = hcat(_beamX, _beamY, _br)\nBeamPlan = showBeam > 0 ? _BEAMr : zeros(0, 3)\nTrimPlan = hcat(_wcx, _wcy, _tr + _tw / 2)\nAperturePlan = hcat(_wcx, _wcy, _ap / 2)\n# Metrics\napertureDia = _ap\ncutoutDia = _hd\nbeamDiameter = 2 * _br\nbeamOffset = _off\ncolourTemp = kelvin\noutputLumens = lumens\nilluminance = lumens / max(0.01, PI * _br * _br)\nspacingRule = 1.5 * _cz\nmountElevation = _cz\nprojection = _isSurf ? _hh : 0"
        }
      }
