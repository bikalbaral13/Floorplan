      "data": {
        "tool": "expr",
        "params": {
          "name": "Chandelier maths",
          "expr": "_natL = 2 * armRadius\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_na = max(2, round(arms))\n# Style changes WHERE the lamps go, not what they are. Every expression after this reads\n# _ax / _ay / _zArm and needs no branch of its own.\n_stBar = style == 'Linear bar'\n_stRing = style == 'Tiered rings'\n_stGlobe = style == 'Globe cluster'\n_stFlush = style == 'Flush'\n_nt = max(1, round(tiers))\n_aR = armRadius * _s\n_aD = armDrop * _s\n_tS = tierStep * _s\n_tR = tierRise * _s\n_colH = columnHeight * _s\n_colR = columnRadius * _s\n_chn = chainLength * _s\n_ceil = mountHeight * _s\n_cdH = candleHeight * _s\n_cdR = candleRadius * _s\n_cupR = cupRadius * _s\n_rgT = ringTube * _s\n_colTop = _ceil - (_stFlush ? 0 : _chn)\n_colBot = _colTop - _colH\n_span = 2 * _aR\n_bodyL = _span\n_bodyW = _span\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n# Arms — every tier and every arm in ONE broadcast; each tier is a smaller, higher ring of arms,\n# and every OTHER tier is offset by half a pitch so the candles do not stack on one another.\n_ti = kron(arange(_nt), ones(_na, 1))\n_ai = kron(ones(_nt, 1), arange(_na))\n_off = (_ti % 2) * PI / _na\n_ang = _ai * 2 * PI / _na + _off\n_rad = _aR - _ti * _tS\n_zArm = _colBot + 0.06 * _s + _ti * _tR - (_stGlobe ? ((_ai % 3) * _tR * 0.7) : 0)\n# A linear bar is the same lamps on one axis instead of on a circle — one expression, not a\n# second body, which is why the tier and offset machinery above still applies to it.\n_barU = (_ai / max(1, _na - 1) - 0.5) * 2 * _rad\n_ax = _stBar ? _barU : _rad * cos(_ang)\n_ay = _stBar ? (_ai * 0) : _rad * sin(_ang)\n_nrow = rows(_ti)\n_hubX = _colR * 0.8 * cos(_ang)\n_hubY = _colR * 0.8 * sin(_ang)\n_ARMq = hcat(_hubX, _hubY, _zArm + _aD, _ax, _ay, _zArm, fill(_nrow,1,_colR * 0.35))\n_ARM = (_stRing || _stFlush) ? zeros(0, 7) : _ARMq\n_CUPq = hcat(_ax, _ay, _zArm, _ax, _ay, _zArm + 0.03 * _s, fill(_nrow,1,_cupR))\n_CUP = (_stRing || _stFlush) ? zeros(0, 7) : _CUPq\n# A globe is a candle that is short and fat — the same tube row with two numbers changed.\n_cdHu = _stGlobe ? (_cdR * 2.2) : _cdH\n_cdRu = _stGlobe ? (_cdR * 2.2) : _cdR\n_CANDq = hcat(_ax, _ay, _zArm + 0.03 * _s, _ax, _ay, _zArm + 0.03 * _s + _cdHu, fill(_nrow,1,_cdRu))\n_CAND = (_stRing || _stFlush) ? zeros(0, 7) : _CANDq\n# Chain, canopy and column — vertical axis segments\n_CHN = hcat(0, 0, _colTop, 0, 0, _ceil, _colR * 0.22)\n_CAN = hcat(0, 0, _ceil - 0.04 * _s, 0, 0, _ceil, _colR * 1.6)\n_COL = hcat(0, 0, _colBot, 0, 0, _colTop, _colR)\n_FIN = hcat(0, 0, _colBot - _colR * 1.6, 0, 0, _colBot, _colR * 1.5)\n_t1u = _cu + col(_ARM,0)\n_t1v = _cv + col(_ARM,1)\n_t2u = _cu + col(_ARM,3)\n_t2v = _cv + col(_ARM,4)\nArms3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_ARM,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_ARM,5), col(_ARM,6))\n_t1u = _cu + col(_CUP,0)\n_t1v = _cv + col(_CUP,1)\n_t2u = _cu + col(_CUP,3)\n_t2v = _cv + col(_CUP,4)\nCups3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_CUP,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_CUP,5), col(_CUP,6))\n_t1u = _cu + col(_CAND,0)\n_t1v = _cv + col(_CAND,1)\n_t2u = _cu + col(_CAND,3)\n_t2v = _cv + col(_CAND,4)\nCandles3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_CAND,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_CAND,5), col(_CAND,6))\n_t1u = _cu + col(vcat(_CHN, _CAN, _COL, _FIN),0)\n_t1v = _cv + col(vcat(_CHN, _CAN, _COL, _FIN),1)\n_t2u = _cu + col(vcat(_CHN, _CAN, _COL, _FIN),3)\n_t2v = _cv + col(vcat(_CHN, _CAN, _COL, _FIN),4)\nStem3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(vcat(_CHN, _CAN, _COL, _FIN),2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(vcat(_CHN, _CAN, _COL, _FIN),5), col(vcat(_CHN, _CAN, _COL, _FIN),6))\n# Ring — a torus whose AXIS is vertical, so only the segment's direction and midpoint are read\n_RGr = hcat(0, 0, _colBot + 0.06 * _s, 0, 0, _colBot + 0.16 * _s, _aR, _rgT)\n# Tiered rings gives every tier its own torus at that tier's radius and height — the same two\n# numbers the arms would have used, so the rings land exactly where the arms were.\n_tiR = arange(_nt)\n_RGm = hcat(fill(_nt,1,0), fill(_nt,1,0), _colBot + 0.06 * _s + _tiR * _tR, fill(_nt,1,0), fill(_nt,1,0), _colBot + 0.16 * _s + _tiR * _tR, _aR - _tiR * _tS, fill(_nt,1,_rgT))\n_RGl = _stRing ? _RGm : (ring > 0 ? _RGr : zeros(0, 8))\n_t1u = _cu + col(_RGl,0)\n_t1v = _cv + col(_RGl,1)\n_t2u = _cu + col(_RGl,3)\n_t2v = _cv + col(_RGl,4)\nRing3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_RGl,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_RGl,5), col(_RGl,6), col(_RGl,7))\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n# Plan symbol — a candle dot per arm, the column, and the spread circle\nCandlePlan = hcat(col(Cups3D,0), col(Cups3D,1), fill(_nrow,1,_cupR))\nColumnPlan = hcat(_wcx, _wcy, _colR * 1.6)\nSpreadPlan = hcat(_wcx, _wcy, _aR)\nArmPlan = hcat(col(Arms3D,0), col(Arms3D,1), col(Arms3D,3), col(Arms3D,4), fill(_nrow,1,2 * _colR * 0.35))\n# Metrics\nspreadDiameter = _span\narmCount = _na * _nt\ntierCount = _nt\nlampCount = _na * _nt\ntopElevation = _ceil\nbottomElevation = _colBot - _colR * 1.6\noverallDrop = _ceil - bottomElevation\ncandleElevation = _colBot + 0.09 * _s\narmLength = mean(len(hcat(_ax - _hubX, _ay - _hubY, _zArm - _zArm - _aD)))\nfootprintArea = PI * _aR * _aR\nisFlush = _stFlush ? 1 : 0\nisLinear = _stBar ? 1 : 0\nlampSpread = _stBar ? (2 * _aR) : (2 * _aR)\nringsDrawn = _stRing ? _nt : (ring > 0 ? 1 : 0)\nvisibleLamps = (_stRing || _stFlush) ? 0 : (_na * _nt)"
        }
      }
    },
