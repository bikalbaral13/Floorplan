{
  "schema": "finishes/1",
  "id": "interior.warm-neutral",
  "title": "Interior — warm neutral",
  "note": "Maps every 3D Render row of the interior half of library/Objects/Architectural to a library material. Rules are matched in order and the FIRST hit wins, so put the specific rows (Mirror, Pulls, Glazing) above the catch-all for the same object. `mesh` matches a case-insensitive substring of the row name; a leading ! negates it; omit it to take every row of that object. `tint` overrides the material's own base colour — one lacquer file serves a cream shutter and a charcoal shadow gap. `tint: \"auto\"` keeps the row's own baked colour, which is what a frame whose colour is part of the design wants.",
  "emissive": {
    "note": "A row whose name matches this is a lit surface, and the fixture's own kelvin overrides the material's. Checked BEFORE the surface rules, so no rule needs to say `!LED` — the LED rows are already gone by then.",
    "match": "\\b(led|lens|emitter|globe|glow|halo|bias|diffuser|ring light|light kit)\\b",
    "material": "Materials/Emissive/led-warm.json"
  },
  "helpers": {
    "note": "Drawing aids the canvas needs and a render must not show: camera bodies and their blue view cones, the light objects' amber aim tubes. They stay in the .blend (and keep their custom props) with hide_render set, so the scene still documents where the shot was framed from.",
    "match": [
      {
        "object": "camera"
      },
      {
        "object": "light"
      },
      {
        "mesh": "view cone"
      },
      {
        "mesh": "beam / aim"
      },
      {
        "mesh": "footprint"
      }
    ]
  },
  "surfaces": [
    {
      "id": "floor",
      "label": "Floor",
