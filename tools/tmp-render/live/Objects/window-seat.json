      "data": {
        "tool": "expr",
        "params": {
          "name": "Window Seat maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_Dp = depth * _s\n_fh = frameHeight * _s\n_cush = cushionThk * _s\n_t = panelThk * _s\n_pl = plinthHeight * _s\n_rv = reveal * _s\n_bodyL = _Ln\n_bodyW = _Dp\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_u0 = 0 - _Ln / 2\n_u1 = _Ln / 2\n_v0 = 0 - _Dp / 2\n_v1 = _Dp / 2\n_isLift = lidStyle == 'Lift-up'\n_isDrw = lidStyle == 'Drawers'\n# Carcass — two cheeks, a back, a base and a front rail. The front rail is dropped when the\n# front is a bank of drawers, because the drawers ARE the front.\n_C1 = hcat(_u0, _v0, _u0 + _t, _v0, _u0 + _t, _v1, _u0, _v1, _pl, _fh, 1)\n_C2 = hcat(_u1 - _t, _v0, _u1, _v0, _u1, _v1, _u1 - _t, _v1, _pl, _fh, 1)\n_C3 = hcat(_u0 + _t, _v1 - _t, _u1 - _t, _v1 - _t, _u1 - _t, _v1, _u0 + _t, _v1, _pl, _fh, 1)\n_C4 = hcat(_u0 + _t, _v0, _u1 - _t, _v0, _u1 - _t, _v1 - _t, _u0 + _t, _v1 - _t, _pl, _pl + _t, 1)\n_C5 = hcat(_u0 + _t, _v0, _u1 - _t, _v0, _u1 - _t, _v0 + _t, _u0 + _t, _v0 + _t, _pl, _fh, 1)\n_FRONT = _isDrw ? zeros(0, 11) : _C5\n_CARC = vcat(_C1, _C2, _C3, _C4, _FRONT)\n_PLr = hcat(_u0 + 0.02, _v0 + 0.02, _u1 - 0.02, _v0 + 0.02, _u1 - 0.02, _v1, _u0 + 0.02, _v1, 0, _pl, 2)\n_PLINTH = _pl > 0.001 ? _PLr : zeros(0, 11)\n# Lid — one board when fixed or drawered, `lidSections` boards when it lifts. One broadcast.\n_nl = _isLift ? max(1, round(lidSections)) : 1\n_lp = _Ln / _nl\n_la0 = _u0 + arange(_nl) * _lp + _rv / 2\n_la1 = _la0 + _lp - _rv\n_LID = hcat(_la0, fill(_nl,1,_v0), _la1, fill(_nl,1,_v0), _la1, fill(_nl,1,_v1), _la0, fill(_nl,1,_v1), fill(_nl,1,_fh - _t), fill(_nl,1,_fh), fill(_nl,1,3))\n# Drawer fronts — applied plates across the open front, same division idea as the lid.\n_nd = max(1, round(drawers))\n_dp = _Ln / _nd\n_dt = 0.018 * _s\n_da0 = _u0 + arange(_nd) * _dp + _rv / 2\n_da1 = _da0 + _dp - _rv\n_DFr = hcat(_da0, fill(_nd,1,_v0 - _dt), _da1, fill(_nd,1,_v0 - _dt), _da1, fill(_nd,1,_v0), _da0, fill(_nd,1,_v0), fill(_nd,1,_pl + _t + _rv), fill(_nd,1,_fh - _t - _rv), fill(_nd,1,4))\n_DF = _isDrw ? _DFr : zeros(0, 11)\n# Cushion\n_CUSH = hcat(_u0, _v0, _u1, _v0, _u1, _v1, _u0, _v1, _fh, _fh + _cush, 5)\n_bkT = 0.12 * _s\n_BCr = hcat(_u0 + _t, _v1 - _t - _bkT, _u1 - _t, _v1 - _t - _bkT, _u1 - _t, _v1 - _t, _u0 + _t, _v1 - _t, _fh + _cush, _fh + _cush + backHeight * _s, 6)\n_BC = backCushion > 0 ? _BCr : zeros(0, 11)\n# End cheeks — full-height panels that carry into the seat, as the plan's wardrobe end does.\n_epL = endPanel == 'Left' || endPanel == 'Both'\n_epR = endPanel == 'Right' || endPanel == 'Both'\n_epT = _t * 1.6\n_EP1 = hcat(_u0 - _epT, _v0, _u0, _v0, _u0, _v1, _u0 - _epT, _v1, 0, _fh + _cush, 7)\n_EP2 = hcat(_u1, _v0, _u1 + _epT, _v0, _u1 + _epT, _v1, _u1, _v1, 0, _fh + _cush, 7)\n_EPa = _epL ? _EP1 : zeros(0, 11)\n_EPb = _epR ? _EP2 : zeros(0, 11)\n_EPN = vcat(_EPa, _EPb)\nQ = vcat(_CARC, _PLINTH, _LID, _DF, _CUSH, _BC, _EPN)\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nCarcass3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nPlinth3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nLid3D = sub(compress(_W, eq(col(_W,4), 3)), 0, 0, _nw, 4)\nDrawers3D = sub(compress(_W, eq(col(_W,4), 4)), 0, 0, _nw, 4)\nCushion3D = sub(compress(_W, eq(col(_W,4), 5)), 0, 0, _nw, 4)\nBackCushion3D = sub(compress(_W, eq(col(_W,4), 6)), 0, 0, _nw, 4)\nEndPanels3D = sub(compress(_W, eq(col(_W,4), 7)), 0, 0, _nw, 4)\nCarcassPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nLidPlan = sub(compress(_WP, eq(col(_WP,3), 3)), 0, 0, _nwp, 3)\nDrawersPlan = sub(compress(_WP, eq(col(_WP,3), 4)), 0, 0, _nwp, 3)\nCushionPlan = sub(compress(_WP, eq(col(_WP,3), 5)), 0, 0, _nwp, 3)\nEndPanelsPlan = sub(compress(_WP, eq(col(_WP,3), 7)), 0, 0, _nwp, 3)\n# Bolsters — round cushions lying across the depth, one at each end, resting on the cushion.\n_br = bolsterDia * _s / 2\n_bz = _fh + _cush + _br\n_bu0 = _u0 + _t + _br\n_bu1 = _u1 - _t - _br\n_bv0 = _v0 + _br * 0.6\n_bv1 = _v1 - _t - _br * 0.6\n_nb = max(0, round(bolsters))\n_B1 = hcat(_bu0, _bv0, _bz, _bu0, _bv1, _bz, _br)\n_B2 = hcat(_bu1, _bv0, _bz, _bu1, _bv1, _bz, _br)\n_BOLl = _nb >= 1 ? _B1 : zeros(0, 7)\n_BOLr = _nb >= 2 ? _B2 : zeros(0, 7)\n_BOL = vcat(_BOLl, _BOLr)\n_t1u = _cu + col(_BOL,0)\n_t1v = _cv + col(_BOL,1)\n_t2u = _cu + col(_BOL,3)\n_t2v = _cv + col(_BOL,4)\nBolsters3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_BOL,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_BOL,5), col(_BOL,6))\n# Metrics\nseatHeight = _fh + _cush\nseatLength = _Ln\nseatDepth = _Dp\nframeTop = _fh\nlidSectionWidth = _lp - _rv\ndrawerWidth = _isDrw ? (_dp - _rv) : 0\nstorageVolume = (_Ln - 2 * _t) * (_Dp - _t) * max(0, _fh - _pl - 2 * _t)\ncushionArea = _Ln * _Dp\nbackTop = backCushion > 0 ? (_fh + _cush + backHeight * _s) : (_fh + _cush)\nbolsterCount = _nb\nfootprint = (_Ln + (_epL + _epR) * _epT) * _Dp"
        }
      }
