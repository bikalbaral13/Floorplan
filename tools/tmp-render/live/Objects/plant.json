    {
      "id": "math",
      "position": {
        "x": -240,
        "y": 40
      },
      "data": {
        "tool": "expr",
        "params": {
          "name": "Plant maths",
          "expr": "_n = rows(P)\n_cx = _n >= 1 ? mean(col(P, 0)) : 0\n_cy = _n >= 1 ? mean(col(P, 1)) : 0\n_R = max(0.05, radius)\n_H = max(0.3, height)\n_tr = max(0.01, trunkRadius)\n_th = min(max(0.05, trunkHeight), _H - 0.1)\n_ch = _H - _th\n_b = base\n_z0 = _b + _th\n_z1 = _b + _H\n_nb = max(0, round(branches))\n_sp = max(5, min(85, branchSpread)) * PI / 180\n_bt = max(0.1, min(1, branchTaper))\n_br = max(0.1, min(1.2, branchReach))\n_ns = max(6, round(canopySides))\nTrunkPlan = hcat(_cx, _cy, _tr)\nCanopyPlan = hcat(_cx, _cy, _R)\nTrunkAxis = hcat(_cx, _cy, _b, _cx, _cy, _z0, _tr)\n_k = arange(_nb)\n_a = _k * 2 * PI / max(1, _nb)\n_bl = min(_ch * _br, _R / max(0.09, sin(_sp)))\n_ex = _cx + sin(_sp) * _bl * cos(_a)\n_ey = _cy + sin(_sp) * _bl * sin(_a)\n_ez = fill(_nb, 1, _z0 + cos(_sp) * _bl)\n_ox = fill(_nb, 1, _cx)\n_oy = fill(_nb, 1, _cy)\n_oz = fill(_nb, 1, _z0)\nBranchAxes = _nb > 0 ? hcat(_ox, _oy, _oz, _ex, _ey, _ez, fill(_nb, 1, _tr * _bt)) : zeros(0, 7)\nBranchPlan = _nb > 0 ? hcat(_ox, _oy, _ex, _ey) : zeros(0, 4)\n_m = 16\n_j = arange(_m + 1)\n_s = _j / _m\n_sine = sin(PI * _s)\n_round = _sine\n_cone = 1 - _s\n_colr = pow(max(0.0001, _sine), 0.3)\n_shape = canopyShape == 'Conical' ? _cone : (canopyShape == 'Columnar' ? _colr : _round)\n_prof = hcat(_s * _ch, _R * _shape)\n_axis = hcat(_cx, _cy, _z0, _cx, _cy, _z1)\nCanopyMesh = _ch > 0.01 ? mlathe(_axis, _prof, _ns) : zeros(0, 4)\ncrownRadius = _R\ncrownDiameter = 2 * _R\ncrownHeight = _ch\noverallHeight = _H\nclearStem = _th\ntrunkRadiusOut = _tr\ntrunkVolume = PI * _tr * _tr * _th\nbranchCount = _nb\nbranchLength = _nb > 0 ? _bl : 0\nspreadDeg = max(0, min(85, branchSpread))\ncanopyPlanArea = PI * _R * _R\nbaseElevation = _b\ntopElevation = _z1"
        }
      }
    },
