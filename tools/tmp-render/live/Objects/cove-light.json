      "data": {
        "tool": "expr",
        "params": {
          "name": "Cove Light maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_cd = coveDepth * _s\n_bt = min(boardThk * _s, _cd / 2)\n_lh = lipHeight * _s\n_lt = min(lipThk * _s, _cd / 2)\n_sh = slabHeight * _s\n_bodyL = _Ln\n_bodyW = _cd\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n# v runs from the wall outward, and ANCHOR has already centred the body on it — so the wall\n# face is at -depth/2 and the front of the lip is at +depth/2.\n_vWall = 0 - _cd / 2\n_vOut = _cd / 2\n_topZ = _sh - coveDrop * _s\n_botZ = _topZ - _bt\n# The tape is set back FROM THE LIP, not from the wall: the lip is what hides it, so the\n# concealment is a distance between those two and nothing to do with where the wall is.\n_sw = min(stripWidth * _s, max(0.002, _cd - _lt))\n_ts = min(tapeSetback * _s, max(0, _cd - _lt - _sw))\n_tv1 = _vOut - _lt - _ts\n_tv0 = _tv1 - _sw\n_tT = 0.004 * _s\n_BOARD = hcat(0 - _Ln / 2, _vWall, _Ln / 2, _vWall, _Ln / 2, _vOut, 0 - _Ln / 2, _vOut, _botZ, _topZ, 1)\n_LIPr = hcat(0 - _Ln / 2, _vOut - _lt, _Ln / 2, _vOut - _lt, _Ln / 2, _vOut, 0 - _Ln / 2, _vOut, _topZ, _topZ + _lh, 2)\n_LIP = _lh > 0.001 ? _LIPr : zeros(0, 11)\n_TAPE = hcat(0 - _Ln / 2, _tv0, _Ln / 2, _tv0, _Ln / 2, _tv1, 0 - _Ln / 2, _tv1, _topZ, _topZ + _tT, 3)\nQ = vcat(_BOARD, _LIP, _TAPE)\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nBoard3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nLip3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nTape3D = sub(compress(_W, eq(col(_W,4), 3)), 0, 0, _nw, 4)\nBoardPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nTapePlan = sub(compress(_WP, eq(col(_WP,3), 3)), 0, 0, _nwp, 3)\n# ── Lamp block ─────────────────────────────────────────────────────────────────────────────\n# The photometry a renderer needs and a drawing cannot show. Arithmetic on the inputs only:\n# nothing here lights anything, and `lamp` names the Photometry file that carries the rest.\n_lbDim = max(0, min(100, dimLevel)) / 100\n_lbLm = lumensPerMetre * _Ln\nlampDimmed = _lbLm * _lbDim\n# 683 lm/W is the same constant material/1 uses for emission.luminance. Writing it in both\n# places is the point: a lit diffuser and the lamp behind it have to be reconcilable, and they\n# can only be reconciled through one number.\nlampWatts = lampDimmed / 683\nlampSoftSize = lampRadius\nlampEmits = emitsLight > 0 ? 1 : 0\nlampCri = cri\nlampKelvin = kelvin\n# THE number for a cove. Sight the lip top against the near edge of the tape: below that angle\n# the source is hidden, above it you are looking straight at a line of diodes. A cove with a\n# 30 mm lip and the tape hard against it conceals nothing, and no amount of lumens fixes that.\ncutoffAngle = atan2(_lh, max(0.001, _vOut - _tv1)) * 180 / PI\n# How much ceiling the wash has to open out across. Too little and the cove reads as a bright\n# stripe rather than a lit ceiling — under about 150 mm it always does.\nwashHeight = _sh - _topZ - _tT\nslotClear = _sh - _topZ - _lh\nrunLength = _Ln\ncoveTop = _topZ\ncoveDepthUsed = _cd\ntapeConcealed = (_lh > 0.001 && _ts > 0.001) ? 1 : 0\nwashLuminance = washHeight > 0.01 ? (lampDimmed / (PI * max(0.01, _Ln * washHeight))) : 0"
        }
      }
    },
