      "data": {
        "tool": "expr",
        "params": {
          "name": "Track Head maths",
          "expr": "_natL = bodyLength\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_bl = bodyLength * _s\n_brd = bodyDiameter * _s / 2\n_sn = snoot * _s\n_ah = adaptorHeight * _s\n_bodyL = max(_bl, 2 * _brd)\n_bodyW = 2 * _brd\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n_mz = mountHeight * _s\n_pivZ = _mz - _ah\n# Yaw turns it in plan, pitch drops it from straight down — the two knobs a track head actually\n# has. Everything after this reads the unit vector and none of it knows which knob moved.\n_yawR = aimYaw * PI / 180\n_ptcR = aimPitch * PI / 180\n_du = sin(_ptcR) * cos(_yawR)\n_dv = sin(_ptcR) * sin(_yawR)\n_dz = 0 - cos(_ptcR)\n_ADAPT = hcat(0 - _brd, 0 - _brd, _brd, 0 - _brd, _brd, _brd, 0 - _brd, _brd, _pivZ, _mz, 1)\nQ = _ADAPT\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nAdaptor3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nAdaptorPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\n_bEndU = _du * _bl\n_bEndV = _dv * _bl\n_bEndZ = _pivZ + _dz * _bl\n_BODY = hcat(0, 0, _pivZ, _bEndU, _bEndV, _bEndZ, _brd)\n_t1u = _cu + col(_BODY,0)\n_t1v = _cv + col(_BODY,1)\n_t2u = _cu + col(_BODY,3)\n_t2v = _cv + col(_BODY,4)\nBody3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_BODY,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_BODY,5), col(_BODY,6))\n_sEndU = _du * (_bl + _sn)\n_sEndV = _dv * (_bl + _sn)\n_sEndZ = _pivZ + _dz * (_bl + _sn)\n_SNOOTr = hcat(_bEndU, _bEndV, _bEndZ, _sEndU, _sEndV, _sEndZ, _brd * 0.92)\n_SNOOT = _sn > 0.001 ? _SNOOTr : zeros(0, 7)\n_t1u = _cu + col(_SNOOT,0)\n_t1v = _cv + col(_SNOOT,1)\n_t2u = _cu + col(_SNOOT,3)\n_t2v = _cv + col(_SNOOT,4)\nSnoot3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_SNOOT,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_SNOOT,5), col(_SNOOT,6))\n# The cone is drawn to the circle where the AXIS meets the floor, not perpendicular to the\n# axis — a tilted beam lands as an ellipse and this is the circle that inscribes it, which is\n# what a lighting plan wants and is honestly an approximation.\n_slant = _pivZ / max(0.09, cos(_ptcR))\n_halfCone = beamAngle * PI / 360\n_footR = _slant * tan(_halfCone)\n_reach = _pivZ * tan(_ptcR)\n_footU = _reach * cos(_yawR)\n_footV = _reach * sin(_yawR)\n_aR = aimRadius * _s\n_ck = arange(4)\n_ca = _ck * PI / 2\n_CONEr = hcat(fill(4,1,0), fill(4,1,0), fill(4,1,_pivZ), _footU + _footR * cos(_ca), _footV + _footR * sin(_ca), fill(4,1,0), fill(4,1,_aR))\n_CONE = showBeam > 0 ? _CONEr : zeros(0, 7)\n_t1u = _cu + col(_CONE,0)\n_t1v = _cv + col(_CONE,1)\n_t2u = _cu + col(_CONE,3)\n_t2v = _cv + col(_CONE,4)\nBeam3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_CONE,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_CONE,5), col(_CONE,6))\n_fpx = (_cu + _footU) * _ux + (_cv + _footV) * _vx\n_fpy = (_cu + _footU) * _uy + (_cv + _footV) * _vy\nFootprintPlan = showBeam > 0 ? hcat(_fpx, _fpy, _footR) : zeros(0, 3)\nSourcePlan = hcat(_wcx, _wcy, max(_brd, 0.03 * _s))\n# ── Lamp block ─────────────────────────────────────────────────────────────────────────────\n# The photometry a renderer needs and a drawing cannot show. Arithmetic on the inputs only:\n# nothing here lights anything, and `lamp` names the Photometry file that carries the rest.\n_lbDim = max(0, min(100, dimLevel)) / 100\n_lbLm = lumens\nlampDimmed = _lbLm * _lbDim\n# 683 lm/W is the same constant material/1 uses for emission.luminance. Writing it in both\n# places is the point: a lit diffuser and the lamp behind it have to be reconcilable, and they\n# can only be reconciled through one number.\nlampWatts = lampDimmed / 683\nlampSoftSize = lampRadius\nlampEmits = emitsLight > 0 ? 1 : 0\nlampCri = cri\nlampKelvin = kelvin\nlampFeather = max(0, min(1, beamBlend))\nfootprintDiameter = 2 * _footR\nfootprintArea = PI * _footR * _footR\naverageLux = footprintArea > 0.01 ? (lampDimmed / footprintArea) : 0\naimPitchUsed = aimPitch\naimYawUsed = aimYaw\naxisReach = _reach\nslantDistance = _slant\nmountElevation = _mz\npivotElevation = _pivZ\nbarnDoorsOn = barnDoors > 0 ? 1 : 0"
        }
      }
    },
