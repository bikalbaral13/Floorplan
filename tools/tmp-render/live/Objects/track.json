      "id": "math",
      "position": {
        "x": -180,
        "y": 40
      },
      "data": {
        "tool": "expr",
        "params": {
          "name": "Track maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_tw = trackWidth * _s\n_td = trackDepth * _s\n_mz = mountHeight * _s\n_bodyL = _Ln\n_bodyW = _tw\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n_isRec = trackType == 'Recessed'\n_isSus = trackType == 'Suspended'\n_drop = _isSus ? (suspension * _s) : 0\n_topZ = _isRec ? (_mz + _td) : (_mz - _drop)\n_botZ = _topZ - _td\n_RAIL = hcat(0 - _Ln / 2, 0 - _tw / 2, _Ln / 2, 0 - _tw / 2, _Ln / 2, _tw / 2, 0 - _Ln / 2, _tw / 2, _botZ, _topZ, 1)\n# The heads are laid out from ONE END, the way a rail is actually loaded, and then squeezed if\n# they would run off it. Reporting the spacing that was used rather than the one that was asked\n# for is the difference between a layout and a wish.\n_nH = max(1, round(headCount))\n_off = min(firstHeadOffset * _s, _Ln / 2)\n_spMax = (_Ln - 2 * _off) / max(1, _nH - 1)\n_spUsed = _nH > 1 ? min(headSpacing * _s, max(0.05, _spMax)) : 0\n_hk = arange(_nH)\n_hu = 0 - _Ln / 2 + _off + _hk * _spUsed\n_hr = 0.028 * _s\n_hh = 0.09 * _s\n_oneH = ones(_nH, 1)\n_HEADr = hcat(_hu - _hr, 0 - _hr * _oneH, _hu + _hr, 0 - _hr * _oneH, _hu + _hr, _hr * _oneH, _hu - _hr, _hr * _oneH, (_botZ - _hh) * _oneH, _botZ * _oneH, 2 * _oneH)\n_HEADS = showHeads > 0 ? _HEADr : zeros(0, 11)\nQ = vcat(_RAIL, _HEADS)\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nRail3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nHeads3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nRailPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nHeadsPlan = sub(compress(_WP, eq(col(_WP,3), 2)), 0, 0, _nwp, 3)\n_wU = max(0.05, _Ln / 2 - 0.15)\n_wk = arange(2)\n_wsgn = 1 - 2 * _wk\n_WIREr = hcat(_wsgn * _wU, fill(2,1,0), fill(2,1,_topZ), _wsgn * _wU, fill(2,1,0), fill(2,1,_mz), fill(2,1,0.0025 * _s))\n_WIRE = _isSus ? _WIREr : zeros(0, 7)\n_t1u = _cu + col(_WIRE,0)\n_t1v = _cv + col(_WIRE,1)\n_t2u = _cu + col(_WIRE,3)\n_t2v = _cv + col(_WIRE,4)\nWire3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_WIRE,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_WIRE,5), col(_WIRE,6))\n# The rail carries no lamp — its heads do. What it does own is the CIRCUIT, and a track that\n# cannot carry the heads hung on it is the one failure mode this object exists to catch.\n_volts = supplyVolts == '12 V' ? 12 : (supplyVolts == '24 V' ? 24 : (supplyVolts == '48 V' ? 48 : 230))\nheadsUsed = _nH\nspacingUsed = _spUsed\nspacingAsked = headSpacing * _s\nspacingSqueezed = (_nH > 1 && _spUsed < headSpacing * _s - 0.0005) ? 1 : 0\nfirstHead = _off\nlastHead = _off + (_nH - 1) * _spUsed\nconnectedLoad = _nH * headLoadW\ncircuitCapacity = circuitAmps * _volts\ncircuitLoadPct = circuitCapacity > 0 ? (100 * connectedLoad / circuitCapacity) : 0\nsupplyUsed = _volts\nrunLength = _Ln\nmountElevation = _mz\ndropUsed = _drop\nrailElevation = _botZ"
        }
      }
    },
