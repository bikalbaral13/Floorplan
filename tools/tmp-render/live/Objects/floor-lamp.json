    {
      "id": "math",
      "position": {
        "x": -180,
        "y": 40
      },
      "data": {
        "tool": "expr",
        "params": {
          "name": "Floor Lamp maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_Wd = width * _s\n_Ht = height * _s\n_bodyL = _Ln\n_bodyW = _Wd\n_u0 = 0 - _Ln / 2\n_u1 = _Ln / 2\n_v0 = 0 - _Wd / 2\n_v1 = _Wd / 2\n_shH = min(shadeHeight * _s, _Ht * 0.4)\n_stW = stemWidth * _s\n_bT = min(baseThk * _s, _Ht * 0.1)\n_isArc = style == 'Arc' ? 1 : 0\n_isTri = style == 'Tripod' ? 1 : 0\n_reach = _isArc > 0 ? armReach * _s : 0\n_shadeCu = _reach\n_shR = _Ln / 2\n_bR = _Wd / 2\n_shZ0 = _Ht - _shH\n_stemZ1 = _shZ0 + _shH * 0.3\n_leg = _bR * 0.9\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_STEM = hcat(0 - _stW / 2, 0 - _stW / 2, _stW / 2, 0 - _stW / 2, _stW / 2, _stW / 2, 0 - _stW / 2, _stW / 2, _bT, _stemZ1, 1)\n_ARM = hcat(0, 0 - _stW / 2, _reach, 0 - _stW / 2, _reach, _stW / 2, 0, _stW / 2, _stemZ1 - _stW, _stemZ1, 1)\n_ARMP = _isArc > 0 ? _ARM : zeros(0, 11)\n_T1 = hcat(0 - _stW / 2, 0 - _stW / 2, _stW / 2, 0 - _stW / 2, _stW / 2, _leg, 0 - _stW / 2, _leg, 0, _bT * 2, 2)\n_T2 = hcat(0 - _leg, 0 - _stW / 2, 0 - _stW / 2, 0 - _stW / 2, 0 - _stW / 2, _stW / 2, 0 - _leg, _stW / 2, 0, _bT * 2, 2)\n_T3 = hcat(_stW / 2, 0 - _stW / 2, _leg, 0 - _stW / 2, _leg, _stW / 2, _stW / 2, _stW / 2, 0, _bT * 2, 2)\n_TRI = _isTri > 0 ? vcat(vcat(_T1, _T2), _T3) : zeros(0, 11)\nQ = vcat(vcat(_STEM, _ARMP), _TRI)\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nStem3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nStemPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nTripod3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nTripodPlan = sub(compress(_WP, eq(col(_WP,3), 2)), 0, 0, _nwp, 3)\n_Basek = arange(24)\n_Baset = _Basek * 2 * PI / 24\n_BaseL = hcat((0) + (_bR) * cos(_Baset), (0) + (_bR) * sin(_Baset))\n_BaseW = hcat((_cu + col(_BaseL,0)) * _ux + (_cv + col(_BaseL,1)) * _vx, (_cu + col(_BaseL,0)) * _uy + (_cv + col(_BaseL,1)) * _vy)\nBasePlan = 1 - _isTri > 0 ? _BaseW : zeros(0, 2)\nBase3D = 1 - _isTri > 0 ? mprism(_BaseW, 0, _bT) : zeros(0, 4)\n_Shadek = arange(24)\n_Shadet = _Shadek * 2 * PI / 24\n_ShadeL = hcat((_shadeCu) + (_shR) * cos(_Shadet), (0) + (_shR) * sin(_Shadet))\n_ShadeW = hcat((_cu + col(_ShadeL,0)) * _ux + (_cv + col(_ShadeL,1)) * _vx, (_cu + col(_ShadeL,0)) * _uy + (_cv + col(_ShadeL,1)) * _vy)\nShadePlan = 1 > 0 ? _ShadeW : zeros(0, 2)\nShade3D = 1 > 0 ? mprism(_ShadeW, _shZ0, _Ht) : zeros(0, 4)\n# Metrics\noverallLength = _Ln\noverallWidth = _Wd\noverallHeight = _Ht\nfootprint = _Ln * _Wd\nshadeLevel = _shZ0\nshadeDiameter = _Ln\nreachOut = _reach\nbaseArea = PI * _bR * _bR\n# ── Lamp block ─────────────────────────────────────────────────────────────────────────────\n# The photometry a renderer needs and a drawing cannot show. Arithmetic on the inputs only:\n# nothing here lights anything, and `lamp` names the Photometry file that carries the rest.\n_lbDim = max(0, min(100, dimLevel)) / 100\n_lbLm = lumens\nlampDimmed = _lbLm * _lbDim\n# 683 lm/W is the same constant material/1 uses for emission.luminance. Writing it in both\n# places is the point: a lit diffuser and the lamp behind it have to be reconcilable, and they\n# can only be reconciled through one number.\nlampWatts = lampDimmed / 683\nlampSoftSize = lampRadius\nlampEmits = emitsLight > 0 ? 1 : 0\nlampCri = cri\nlampKelvin = kelvin"
        }
      }
    },
