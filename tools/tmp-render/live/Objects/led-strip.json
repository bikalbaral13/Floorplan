      "data": {
        "tool": "expr",
        "params": {
          "name": "LED Strip maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_sw = stripWidth * _s\n_st = stripThk * _s\n_cw = max(channelWidth * _s, _sw + 0.002)\n_cd = channelDepth * _s\n_mz = mountHeight\n_bodyL = _Ln\n_bodyW = _cw\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_u0 = 0 - _Ln / 2\n_u1 = _Ln / 2\n# Throw direction is the ONLY thing that decides which way the section is built. Up sits the tape\n# on the channel base and opens to the sky; Down hangs it under; Wash turns the section on its side.\n_up = direction == 'Up'\n_dn = direction == 'Down'\n_wash = direction == 'Wash'\n# Recessed buries the channel above the mount plane, Surface hangs it below it.\n_rec = channel == 'Recessed'\n_none = channel == 'None'\n_sgn = _dn ? -1 : 1\n_cz0 = _rec ? (_dn ? _mz : _mz) : (_dn ? _mz - _cd : _mz)\n_cz1 = _cz0 + _cd\n_czA = _rec ? (_dn ? _mz : _mz) : (_dn ? _mz - _cd : _mz)\n# Tape plane — on the channel base, facing the opening.\n_tz0 = _up ? _czA : (_dn ? (_czA + _cd - _st) : _czA)\n_tz1 = _tz0 + _st\n_twz0 = _mz\n_twz1 = _mz + _sw\n_tv0 = 0 - _sw / 2\n_tv1 = _sw / 2\n_TAPEud = hcat(_u0, _tv0, _u1, _tv0, _u1, _tv1, _u0, _tv1, _tz0, _tz1, 2)\n_TAPEw = hcat(_u0, 0, _u1, 0, _u1, _st, _u0, _st, _twz0, _twz1, 2)\n_TAPE = _wash ? _TAPEw : _TAPEud\n# Channel — a base plate and two walls, so it reads as an extrusion and not as a filled bar.\n_wt = max(0.0015, _cw * 0.12)\n_cv0 = 0 - _cw / 2\n_cv1 = _cw / 2\n_CBASE = hcat(_u0, _cv0, _u1, _cv0, _u1, _cv1, _u0, _cv1, _up ? _czA : (_czA + _cd - _wt), _up ? (_czA + _wt) : (_czA + _cd), 1)\n_CW1 = hcat(_u0, _cv0, _u1, _cv0, _u1, _cv0 + _wt, _u0, _cv0 + _wt, _czA, _czA + _cd, 1)\n_CW2 = hcat(_u0, _cv1 - _wt, _u1, _cv1 - _wt, _u1, _cv1, _u0, _cv1, _czA, _czA + _cd, 1)\n_CBASEw = hcat(_u0, 0, _u1, 0, _u1, _wt, _u0, _wt, _mz, _mz + _cw, 1)\n_CW1w = hcat(_u0, 0, _u1, 0, _u1, _cd, _u0, _cd, _mz, _mz + _wt, 1)\n_CW2w = hcat(_u0, 0, _u1, 0, _u1, _cd, _u0, _cd, _mz + _cw - _wt, _mz + _cw, 1)\n_CHud = vcat(_CBASE, _CW1, _CW2)\n_CHw = vcat(_CBASEw, _CW1w, _CW2w)\n_CHr = _wash ? _CHw : _CHud\n_CH = _none ? zeros(0, 11) : _CHr\nQ = vcat(_CH, _TAPE)\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nChannel3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nTape3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nChannelPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nTapePlan = sub(compress(_WP, eq(col(_WP,3), 2)), 0, 0, _nwp, 3)\n# Metrics\nrunLength = _Ln\ncolourTemp = kelvin\nlumens = lumensPerMetre * _Ln\nloadWatts = lumensPerMetre * _Ln / efficacyLmW\nmountElevation = _mz\nsectionWidth = _none ? _sw : _cw\nsectionDepth = _none ? _st : _cd\nthrowSign = _sgn\nrecessedFlag = _rec ? 1 : 0\nlampFeather = max(0, min(1, beamBlend))\nlampVolts = voltage == '12 V DC' ? 12 : (voltage == '24 V DC' ? 24 : (voltage == '48 V DC' ? 48 : 230))\n# ── Lamp block ─────────────────────────────────────────────────────────────────────────────\n# The photometry a renderer needs and a drawing cannot show. Arithmetic on the inputs only:\n# nothing here lights anything, and `lamp` names the Photometry file that carries the rest.\n_lbDim = max(0, min(100, dimLevel)) / 100\n_lbLm = lumens\nlampDimmed = _lbLm * _lbDim\n# 683 lm/W is the same constant material/1 uses for emission.luminance. Writing it in both\n# places is the point: a lit diffuser and the lamp behind it have to be reconcilable, and they\n# can only be reconciled through one number.\nlampWatts = lampDimmed / 683\nlampSoftSize = lampRadius\nlampEmits = emitsLight > 0 ? 1 : 0\nlampCri = cri\n# What actually leaves the channel. The tape is behind a diffuser and the diffuser eats some\n# of it — which is why a 900 lm/m tape behind opal does not read as 900 lm/m in the room.\nlampThroughDiffuser = lampDimmed * max(0.05, min(1, diffuserTransmission))"
        }
      }
    },
