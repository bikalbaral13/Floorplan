    {
      "id": "math",
      "position": {
        "x": -180,
        "y": 40
      },
      "data": {
        "tool": "expr",
        "params": {
          "name": "Stool maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_Wd = width * _s\n_Ht = height * _s\n_bodyL = _Ln\n_bodyW = _Wd\n_u0 = 0 - _Ln / 2\n_u1 = _Ln / 2\n_v0 = 0 - _Wd / 2\n_v1 = _Wd / 2\n_sT = min(seatThk * _s, _Ht * 0.3)\n_lg = legSize * _s\n_fH = min(footrestHeight * _s, _Ht - _sT - 0.05 * _s)\n_round = seatShape == 'Round' ? 1 : 0\n_seatZ0 = _Ht - _sT\n_sR = min(_Ln, _Wd) / 2\n_in = _lg * 0.5\n_hasFR = (showFootrest > 0 && _fH > 0) ? 1 : 0\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_SQ = hcat(_u0, _v0, _u1, _v0, _u1, _v1, _u0, _v1, _seatZ0, _Ht, 1)\n_SEAT = _round > 0 ? zeros(0, 11) : _SQ\n_G1 = hcat(_u0 + _in, _v0 + _in, _u0 + _in + _lg, _v0 + _in, _u0 + _in + _lg, _v0 + _in + _lg, _u0 + _in, _v0 + _in + _lg, 0, _seatZ0, 2)\n_G2 = hcat(_u1 - _in - _lg, _v0 + _in, _u1 - _in, _v0 + _in, _u1 - _in, _v0 + _in + _lg, _u1 - _in - _lg, _v0 + _in + _lg, 0, _seatZ0, 2)\n_G3 = hcat(_u1 - _in - _lg, _v1 - _in - _lg, _u1 - _in, _v1 - _in - _lg, _u1 - _in, _v1 - _in, _u1 - _in - _lg, _v1 - _in, 0, _seatZ0, 2)\n_G4 = hcat(_u0 + _in, _v1 - _in - _lg, _u0 + _in + _lg, _v1 - _in - _lg, _u0 + _in + _lg, _v1 - _in, _u0 + _in, _v1 - _in, 0, _seatZ0, 2)\n_LEGS = vcat(vcat(_G1, _G2), vcat(_G3, _G4))\n_F1 = hcat(_u0 + _in, _v0 + _in, _u1 - _in, _v0 + _in, _u1 - _in, _v0 + _in + _lg * 0.6, _u0 + _in, _v0 + _in + _lg * 0.6, _fH, _fH + _lg * 0.6, 3)\n_F2 = hcat(_u0 + _in, _v1 - _in - _lg * 0.6, _u1 - _in, _v1 - _in - _lg * 0.6, _u1 - _in, _v1 - _in, _u0 + _in, _v1 - _in, _fH, _fH + _lg * 0.6, 3)\n_FR = _hasFR > 0 ? vcat(_F1, _F2) : zeros(0, 11)\nQ = vcat(vcat(_SEAT, _LEGS), _FR)\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nSeat3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nSeatPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nLegs3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nLegsPlan = sub(compress(_WP, eq(col(_WP,3), 2)), 0, 0, _nwp, 3)\nFootrest3D = sub(compress(_W, eq(col(_W,4), 3)), 0, 0, _nw, 4)\nFootrestPlan = sub(compress(_WP, eq(col(_WP,3), 3)), 0, 0, _nwp, 3)\n_Roundk = arange(24)\n_Roundt = _Roundk * 2 * PI / 24\n_RoundL = hcat((0) + (_sR) * cos(_Roundt), (0) + (_sR) * sin(_Roundt))\n_RoundW = hcat((_cu + col(_RoundL,0)) * _ux + (_cv + col(_RoundL,1)) * _vx, (_cu + col(_RoundL,0)) * _uy + (_cv + col(_RoundL,1)) * _vy)\nRoundPlan = _round > 0 ? _RoundW : zeros(0, 2)\nRound3D = _round > 0 ? mprism(_RoundW, _seatZ0, _Ht) : zeros(0, 4)\n# Metrics\noverallLength = _Ln\noverallWidth = _Wd\noverallHeight = _Ht\nfootprint = _Ln * _Wd\nseatLevel = _Ht\nseatArea = _round > 0 ? PI * _sR * _sR : _Ln * _Wd\nfootrestLevel = _hasFR > 0 ? _fH : 0\ncounterGap = 0.3 * _s"
        }
      }
    },
