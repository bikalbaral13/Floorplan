      "data": {
        "tool": "expr",
        "params": {
          "name": "Kitchen Sink maths",
          "expr": "_natL = length\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_Ln = length * _s\n_Wd = width * _s\n_Ht = height * _s\n_bodyL = _Ln\n_bodyW = _Wd\n_u0 = 0 - _Ln / 2\n_u1 = _Ln / 2\n_v0 = 0 - _Wd / 2\n_v1 = _Wd / 2\n_dT = min(deckThk * _s, _Ht * 0.2)\n_bD = min(bowlDepth * _s, _Ht * 0.5)\n_deckZ0 = _Ht - _dT\n_bz0 = _deckZ0 - _bD\n_isSingle = bowls == 'Single' ? 1 : 0\n_isDouble = bowls == 'Double' ? 1 : 0\n_drain = drainer > 0 ? 1 : 0\n_workL = _drain > 0 ? _Ln * 0.6 : _Ln\n_bu0 = _u0 + 0.04 * _s\n_bu1 = _bu0 + max(0.15 * _s, _workL - 0.08 * _s)\n_bv0 = _v0 + 0.05 * _s\n_bv1 = _v1 - 0.05 * _s\n_split = _isSingle > 0 ? 1 : (_isDouble > 0 ? 2 : 1.6)\n_bMid = _bu0 + (_bu1 - _bu0) / _split\n_gap = 0.03 * _s\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_DECK = hcat(_u0, _v0, _u1, _v0, _u1, _v1, _u0, _v1, _deckZ0, _Ht, 1)\n_B1 = hcat(_bu0, _bv0, _bMid, _bv0, _bMid, _bv1, _bu0, _bv1, _bz0, _deckZ0, 2)\n_B2 = hcat(_bMid + _gap, _bv0, _bu1, _bv0, _bu1, _bv1, _bMid + _gap, _bv1, _bz0, _deckZ0, 2)\n_BOWLS = _isSingle > 0 ? _B1 : vcat(_B1, _B2)\n_DR = hcat(_bu1 + _gap, _bv0, _u1 - 0.04 * _s, _bv0, _u1 - 0.04 * _s, _bv1, _bu1 + _gap, _bv1, _deckZ0 - 0.01 * _s, _deckZ0, 3)\n_DRN = _drain > 0 ? _DR : zeros(0, 11)\n_TAPQ = hcat(_bu0 + 0.02 * _s, _v0 + 0.03 * _s, _bu0 + 0.07 * _s, _v0 + 0.03 * _s, _bu0 + 0.07 * _s, _v0 + 0.08 * _s, _bu0 + 0.02 * _s, _v0 + 0.08 * _s, _Ht, _Ht + 0.3 * _s, 4)\n_TAP = showTap > 0 ? _TAPQ : zeros(0, 11)\nQ = vcat(vcat(_DECK, _BOWLS), vcat(_DRN, _TAP))\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nDeck3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nDeckPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\nBowls3D = sub(compress(_W, eq(col(_W,4), 2)), 0, 0, _nw, 4)\nBowlsPlan = sub(compress(_WP, eq(col(_WP,3), 2)), 0, 0, _nwp, 3)\nDrainer3D = sub(compress(_W, eq(col(_W,4), 3)), 0, 0, _nw, 4)\nDrainerPlan = sub(compress(_WP, eq(col(_WP,3), 3)), 0, 0, _nwp, 3)\nTap3D = sub(compress(_W, eq(col(_W,4), 4)), 0, 0, _nw, 4)\nTapPlan = sub(compress(_WP, eq(col(_WP,3), 4)), 0, 0, _nwp, 3)\n# Metrics\noverallLength = _Ln\noverallWidth = _Wd\noverallHeight = _Ht\nfootprint = _Ln * _Wd\nbowlArea = max(0, _bMid - _bu0) * max(0, _bv1 - _bv0)\ndeckLevel = _Ht\nbowlCount = _isSingle > 0 ? 1 : 2"
        }
      }
    },
