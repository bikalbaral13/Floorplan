      "data": {
        "tool": "expr",
        "params": {
          "name": "Daylight Portal maths",
          "expr": "_natL = openingWidth\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n_ow = openingWidth * _s\n_sill = sillHeight * _s\n_head = max(_sill + 0.05, headHeight * _s)\n_oh = _head - _sill\n_rv = reveal * _s\n_bodyL = _ow\n_bodyW = max(0.02, 2 * _rv + 0.02)\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n# The light plane sits IN the opening, set in from the wall face by the reveal — not on the\n# wall line. A deep reveal is a real thing: it cuts the sky the room can see, and putting the\n# source at the glass rather than at the wall is what makes that cut happen on its own.\n_gT = 0.006 * _s\n_gv0 = _rv\n_gv1 = _rv + _gT\n_GLASS = hcat(0 - _ow / 2, _gv0, _ow / 2, _gv0, _ow / 2, _gv1, 0 - _ow / 2, _gv1, _sill, _head, 1)\nQ = _GLASS\n# Quad prism — every part is a quad swept from z0 to z1 (6 faces)\n_nq = rows(Q)\n_r4 = ones(4,1)\n_a1 = col(Q,0)\n_b1 = col(Q,1)\n_a2 = col(Q,2)\n_b2 = col(Q,3)\n_a3 = col(Q,4)\n_b3 = col(Q,5)\n_a4 = col(Q,6)\n_b4 = col(Q,7)\n_qz0 = col(Q,8)\n_qz1 = col(Q,9)\n_gq = kron(col(Q,10), _r4)\n_fq = kron(arange(_nq), _r4) * 6\n_q0 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a3,_b3,_qz0,_a4,_b4,_qz0), 4*_nq, 3), _fq + 0, _gq)\n_q1 = hcat(reshape(hcat(_a1,_b1,_qz1,_a2,_b2,_qz1,_a3,_b3,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 1, _gq)\n_q2 = hcat(reshape(hcat(_a1,_b1,_qz0,_a2,_b2,_qz0,_a2,_b2,_qz1,_a1,_b1,_qz1), 4*_nq, 3), _fq + 2, _gq)\n_q3 = hcat(reshape(hcat(_a2,_b2,_qz0,_a3,_b3,_qz0,_a3,_b3,_qz1,_a2,_b2,_qz1), 4*_nq, 3), _fq + 3, _gq)\n_q4 = hcat(reshape(hcat(_a3,_b3,_qz0,_a4,_b4,_qz0,_a4,_b4,_qz1,_a3,_b3,_qz1), 4*_nq, 3), _fq + 4, _gq)\n_q5 = hcat(reshape(hcat(_a4,_b4,_qz0,_a1,_b1,_qz0,_a1,_b1,_qz1,_a4,_b4,_qz1), 4*_nq, 3), _fq + 5, _gq)\n_FL = vcat(_q0,_q1,_q2,_q3,_q4,_q5)\n_PL = hcat(reshape(hcat(_a1,_b1,_a2,_b2,_a3,_b3,_a4,_b4), 4*_nq, 2), kron(arange(_nq), _r4), _gq)\n# Local (u,v,z) -> world, once, for every part at the same time\n_U = _cu + col(_FL,0)\n_V = _cv + col(_FL,1)\n_W = hcat(_U * _ux + _V * _vx, _U * _uy + _V * _vy, col(_FL,2), col(_FL,3), col(_FL,4))\n_nw = rows(_W)\n_PU = _cu + col(_PL,0)\n_PV = _cv + col(_PL,1)\n_WP = hcat(_PU * _ux + _PV * _vx, _PU * _uy + _PV * _vy, col(_PL,2), col(_PL,3))\n_nwp = rows(_WP)\nGlass3D = sub(compress(_W, eq(col(_W,4), 1)), 0, 0, _nw, 4)\nGlassPlan = sub(compress(_WP, eq(col(_WP,3), 1)), 0, 0, _nwp, 3)\n# The opening is drawn as a WIREFRAME, four edges. A solid would fill the hole it is describing.\n_eR = edgeRadius * _s\n_E1 = hcat(0 - _ow / 2, _gv0, _sill, _ow / 2, _gv0, _sill, _eR)\n_E2 = hcat(_ow / 2, _gv0, _sill, _ow / 2, _gv0, _head, _eR)\n_E3 = hcat(_ow / 2, _gv0, _head, 0 - _ow / 2, _gv0, _head, _eR)\n_E4 = hcat(0 - _ow / 2, _gv0, _head, 0 - _ow / 2, _gv0, _sill, _eR)\n_FRAMEr = vcat(_E1, _E2, _E3, _E4)\n_FRM = showFrame > 0 ? _FRAMEr : zeros(0, 7)\n_t1u = _cu + col(_FRM,0)\n_t1v = _cv + col(_FRM,1)\n_t2u = _cu + col(_FRM,3)\n_t2v = _cv + col(_FRM,4)\nOpening3D = hcat(_t1u * _ux + _t1v * _vx, _t1u * _uy + _t1v * _vy, col(_FRM,2), _t2u * _ux + _t2v * _vx, _t2u * _uy + _t2v * _vy, col(_FRM,5), col(_FRM,6))\n# A sky has no output — it has an ILLUMINANCE, and what arrives through the hole depends on how\n# big the hole is. That is the whole difference between this and every other object here, and\n# it is why `exteriorIlluminance` is in lux and the result is in lumens.\nglazedArea = _ow * _oh\n_blind = max(0, min(100, dimLevel)) / 100\n_tr = max(0.05, min(0.95, glazingTransmittance))\nportalLumens = exteriorIlluminance * glazedArea * _tr * _blind\nlampDimmed = portalOnly > 0 ? 0 : portalLumens\nlampWatts = lampDimmed / 683\nlampSoftSize = lampRadius\nlampEmits = emitsLight > 0 ? 1 : 0\nlampKelvin = kelvin\n# A Cycles PORTAL emits nothing. It is a hint that says `the light comes from here, sample it`,\n# and a portal that also emits is the same window counted twice.\nisPortal = portalOnly > 0 ? 1 : 0\nskyCode = skyType == 'CIE Overcast' ? 0 : (skyType == 'CIE Clear' ? 1 : (skyType == 'Uniform' ? 2 : 3))\ntransmittanceUsed = _tr\nfrosting = max(0, min(1, frostedDiffusion))\nopeningHeight = _oh\nopeningWidthUsed = _ow\nsillLevel = _sill\nheadLevel = _head\nrevealUsed = _rv\n# Which way the opening faces, off the host segment itself. A north light and a west light are\n# the same geometry and completely different rooms, and the wall already knows which it is.\n_bRaw = sum(atan2(_vy, _vx)) * 180 / PI\nbearing = _bRaw < 0 ? (_bRaw + 360) : _bRaw"
        }
      }
    },
