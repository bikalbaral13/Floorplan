      "data": {
        "tool": "expr",
        "params": {
          "name": "Pendant maths",
          "expr": "_natL = diameter\n# Host frame — node, segment or space\n_e1 = hcat(1, 0)\n_np = rows(P)\n_isSeg = _np == 2\n_isSpace = _np > 2\n_edges = _isSpace ? (shift(P, -1) - P) : _e1\n_edgeLen = len(_edges)\n_longest = max(_edgeLen)\n_spaceDir = _isSpace ? row(compress(_edges, eq(_edgeLen, _longest)), 0) : _e1\n_segDir = _isSeg ? (row(P, 1) - row(P, 0)) : _e1\n_dir = _isSpace ? _spaceDir : (_isSeg ? _segDir : _e1)\n_dirLen = len(_dir)\n_axisB = _dirLen > 0 ? normalize(_dir) : _e1\n_rot = rotation * PI / 180\n_crot = cos(_rot)\n_srot = sin(_rot)\n_bx = sub(_axisB, 0, 0, 1, 1)\n_by = sub(_axisB, 0, 1, 1, 1)\n_axisU = hcat(_bx * _crot - _by * _srot, _bx * _srot + _by * _crot)\n_axisV = (flipSide > 0 ? -1 : 1) * perp(_axisU)\n_ux = sub(_axisU, 0, 0, 1, 1)\n_uy = sub(_axisU, 0, 1, 1, 1)\n_vx = sub(_axisV, 0, 0, 1, 1)\n_vy = sub(_axisV, 0, 1, 1, 1)\n_Qu = col(P, 0) * _ux + col(P, 1) * _uy\n_Qv = col(P, 0) * _vx + col(P, 1) * _vy\n_hu0 = _np > 0 ? min(_Qu) : 0\n_hu1 = _np > 0 ? max(_Qu) : 0\n_hv0 = _np > 0 ? min(_Qv) : 0\n_hv1 = _np > 0 ? max(_Qv) : 0\n_hcu = (_hu0 + _hu1) / 2\n_hcv = (_hv0 + _hv1) / 2\n_hostL = _hu1 - _hu0\n_hostW = _hv1 - _hv0\n# Fit to host — one uniform scale, Max never enlarges\n_availL = max(0, _hostL - 2 * margin)\n_notOff = fitMode != 'Off'\n_exact = fitMode == 'Exact'\n_sRaw = _natL > 0 ? _availL / _natL : 1\n_sFit = (_notOff && _availL > 0) ? (_exact ? _sRaw : min(1, _sRaw)) : 1\nscale = max(0.15, min(5, _sFit))\n_s = scale\n# Every length scales with the one fit scale, so the pendant stays a pendant when it is fitted to a host.\n_R = diameter / 2 * _s\n_L = bodyLength * _s\n_bz = bottomHeight * _s\n_cz = mountHeight * _s\n_topZ = _bz + _L\n_bodyL = 2 * _R\n_bodyW = 2 * _R\n# Anchor — place the footprint by any of the nine box points\n_anchorL = anchorDir == 'Top-Left' || anchorDir == 'Left-Center' || anchorDir == 'Bottom-Left'\n_anchorR = anchorDir == 'Top-Right' || anchorDir == 'Right-Center' || anchorDir == 'Bottom-Right'\n_anchorT = anchorDir == 'Top-Left' || anchorDir == 'Top-Center' || anchorDir == 'Top-Right'\n_anchorB = anchorDir == 'Bottom-Left' || anchorDir == 'Bottom-Center' || anchorDir == 'Bottom-Right'\n_ax = _anchorR - _anchorL\n_ay = _anchorB - _anchorT\n_hau = _hcu + _ax * max(0, _hostL / 2 - margin)\n_hav = _hcv + _ay * max(0, _hostW / 2 - margin)\n_cu = _hau - _ax * _bodyL / 2\n_cv = _hav - _ay * _bodyW / 2\n_wcx = _cu * _ux + _cv * _vx\n_wcy = _cu * _uy + _cv * _vy\n# The shade is ONE revolve. Cylinder, Cone and Dome are not three bodies — they are three\n# (top, mid) radius pairs fed to the same profile, which always closes on the axis at both\n# ends so the lathe is a solid rather than a surface.\n_isCyl = shade == 'Cylinder'\n_isCone = shade == 'Cone'\n_rTop = _isCyl ? _R : (_isCone ? _R * 0.35 : _R * 0.2)\n_rMid = _isCyl ? _R : (_isCone ? _R * 0.675 : _R * 0.85)\n_rBot = _R\n_prof = vcat(hcat(0, 0), hcat(0, _rTop), hcat(_L / 2, _rMid), hcat(_L, _rBot), hcat(_L, 0))\n# The axis runs DOWN from the top of the shade, so profile t is depth below the top.\n_seg = hcat(_wcx, _wcy, _topZ, _wcx, _wcy, _topZ - 1)\nShade3D = mlathe(_seg, _prof, 24)\n# Canopy and cord are capped cylinders — a Tube row is exactly that, so neither needs a mesh.\n_canR = canopyRadius * _s\n_canH = canopyHeight * _s\n_canZ = _cz - _canH\nCanopy3D = hcat(_wcx, _wcy, _canZ, _wcx, _wcy, _cz, _canR)\n_cordR = cordRadius * _s\n_hasCord = (showCord > 0) && (_canZ > _topZ)\nCord3D = _hasCord ? hcat(_wcx, _wcy, _topZ, _wcx, _wcy, _canZ, _cordR) : zeros(0, 7)\n# The diffuser is a thin disc inset by the shade wall, so it reads as glowing glass in the aperture.\n_wt = wallThk * _s\n_difR = max(0.001, _rBot - _wt)\n_difH = max(0.002, _wt * 2)\nDiffuser3D = openBottom > 0 ? hcat(_wcx, _wcy, _bz, _wcx, _wcy, _bz + _difH, _difR) : zeros(0, 7)\n# Plan symbol — the shade circle with the canopy inside it.\nShadePlan = hcat(_wcx, _wcy, _R)\nCanopyPlan = hcat(_wcx, _wcy, _canR)\n# Metrics\nshadeDiameter = 2 * _R\nshadeHeight = _L\nbottomElevation = _bz\ntopElevation = _topZ\ndropFromCeiling = _cz - _topZ\ncordLength = max(0, _canZ - _topZ)\napertureArea = PI * _difR * _difR\ncolourTemperature = kelvin\nlampOutput = lumens\napertureLuminance = lumens / max(0.0001, PI * _R * _R)\n# ── Lamp block ─────────────────────────────────────────────────────────────────────────────\n# The photometry a renderer needs and a drawing cannot show. Arithmetic on the inputs only:\n# nothing here lights anything, and `lamp` names the Photometry file that carries the rest.\n_lbDim = max(0, min(100, dimLevel)) / 100\n_lbLm = lumens\nlampDimmed = _lbLm * _lbDim\n# 683 lm/W is the same constant material/1 uses for emission.luminance. Writing it in both\n# places is the point: a lit diffuser and the lamp behind it have to be reconcilable, and they\n# can only be reconciled through one number.\nlampWatts = lampDimmed / 683\nlampSoftSize = lampRadius\nlampEmits = emitsLight > 0 ? 1 : 0\nlampCri = cri\n# A shade is not opaque. What passes through it is the difference between a pendant that\n# reads as a lamp and one that reads as a hole in the ceiling, and it decides whether the\n# renderer wants a point inside the shade or an area light at its open bottom.\nlampThroughShade = lampDimmed * max(0, min(1, shadeTransmission))"
        }
      }
    },
